      pushLog("server", `[llm:restart] systemd ${target.unit} source=${target.source || "?"} port=${port} · reason=${reason}`);
      if (target.file && String(process.env.LLM_DIRECT_FALLBACK_FROM_SERVICE ?? "1") !== "0") {
