            "text": "import.meta.env = {\"BASE_URL\": \"/\", \"DEV\": true, \"MODE\": \"development\", \"PROD\": false, \"SSR\": false, \"TSS_DEV_SERVER\": \"true\", \"TSS_DEV_SSR_STYLES_BASEPATH\": \"/\", \"TSS_DEV_SSR_STYLES_ENABLED\": \"true\", \"TSS_ROUTER_BASEPATH\": \"\", \"TSS_SERVER_FN_BASE\": \"/_serverFn/\", \"TSS_SHELL\": \"false\"};const BRIDGE_HTTP_PORT = \"3005\";\nconst BRIDGE_HTTPS_PORT = \"10443\";\nfunction isHttpsPage() {\n  return typeof window !== \"undefined\" && window.location.protocol === \"https:\";\n}\nfunction bridgeScheme() {\n  return isHttpsPage() ? \"https\" : \"http\";\n}\nfunction bridgePort() {\n  return isHttpsPage() ? BRIDGE_HTTPS_PORT : BRIDGE_HTTP_PORT;\n}\nconst BRIDGE_PORT = BRIDGE_HTTP_PORT;\nconst BRIDGE_OVERRIDE_KEY = \"bridge.override\";\nconst BRIDGE_MDNS_KEY = \"bridge.mdns_hosts\";\nfunction defaultMdnsHosts() {\n  if (typeof window === \"undefined\") return [];\n  const host = window.location.hostname?.toLowerCase() ?? \"\";\n  if (!host) return [];\n  if (host.endsWith(\".local\")) return [host];\n  return [];\n}\nexport function getMdnsHosts() {\n  const raw = safeGet(BRIDGE_MDNS_KEY);\n  if (!raw) return defaultMdnsHosts();\n  const list = raw.split(\",\").map((s) => s.trim()).filter(Boolean);\n  return list.length ? list : defaultMdnsHosts();\n}\nexport function setMdnsHosts(hosts) {\n  if (!hosts || hosts.length === 0) safeSet(BRIDGE_MDNS_KEY, null);\n  else safeSet(BRIDGE_MDNS_KEY, hosts.map((h) => h.trim()).filter(Boolean).join(\",\"));\n}\nfunction mdnsBridgeUrls() {\n  return getMdnsHosts().map((h) => `${bridgeScheme()}://${h}:${bridgePort()}`);\n}\nconst LEGACY_API_RESOLUTION_STORAGE_KEYS = [\n  \"api.baseUrl\",\n  \"apiBaseUrl\",\n  \"API_BASE_URL\",\n  \"bridge.baseUrl\",\n  \"bridgeUrl\",\n  \"BRIDGE_URL\",\n  \"sec.middleware\"\n];\nlet didLogDetectedApiUrl = false;\nfunction purgeLegacyApiResolutionStorage() {\n  if (typeof window === \"undefined\") return;\n  for (const key of LEGACY_API_RESOLUTION_STO