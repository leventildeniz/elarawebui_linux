{
  "name": "sovereign-local-middleware",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.1.30",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run server.mjs",
    "dev": "bun --watch run server.mjs",
    "tls-proxy": "bun run dev-tls-proxy.mjs",
    "setup": "bun install --frozen-lockfile --ignore-scripts",
    "playwright:install": "bunx playwright install chromium",
    "preinstall": "node -e \"if(!(process.env.npm_execpath||'').includes('bun'))throw new Error('Bun zorunlu — npm/yarn/pnpm yasak. Kullan: bun install')\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "4.18.2",
    "helmet": "^8.3.0",
    "isomorphic-dompurify": "^2.16.0",
    "jsdom": "^25.0.0",
    "ldapts": "^8.1.7",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "ntp-client": "^0.5.3",
    "officeparser": "^6.1.1",
    "openid-client": "^6.8.7",
    "pdf-parse": "^2.4.5",
    "pg": "8.11.3",
    "playwright": "^1.48.0",
    "radius": "^1.1.4",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5",
    "yauzl": "^3.3.0",
    "youtube-transcript": "^1.3.1"
  }
}
