<?xml version="1.0" encoding="UTF-8"?>
<!--
  ELARA TLS Proxy launchd unit · port 10443 (HTTPS → 8080 Vite).
  Vite (com.elara.vite) ayağa kalkmadan TLS proxy 502 döner; KeepAlive
  + ThrottleInterval ile birkaç saniye içinde retry yapar.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.elara.tls-proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>dev-tls-proxy.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__/local-server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/elara-tls-proxy.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/elara-tls-proxy.err.log</string>
</dict>
</plist>
