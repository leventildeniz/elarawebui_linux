{
  "slug": "whois_geo",
  "input": {
    "type": "object",
    "required": ["target"],
    "properties": {
      "target": { "type": "string", "minLength": 1, "maxLength": 253 },
      "timeout_ms": { "type": "integer", "minimum": 2000, "maximum": 30000 }
    }
  },
  "output": {
    "type": "object",
    "required": ["ok"],
    "properties": {
      "ok": { "type": "boolean" },
      "target": { "type": "string" },
      "kind": { "type": "string", "enum": ["ip", "domain"] },
      "whois": { "type": ["object", "null"] },
      "whois_error": { "type": ["string", "null"] },
      "asn": { "type": ["object", "null"] },
      "geo": { "type": ["object", "null"] },
      "geo_error": { "type": ["string", "null"] },
      "reason": { "type": "string" }
    }
  },
  "dependencies": ["python-whois"]
}
