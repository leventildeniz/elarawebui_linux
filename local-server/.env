PORT=3005
DATABASE_URL=postgres://sovereign:sovereign@localhost:5432/elara_db
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:72b
MLX_EMBED_MODEL="BAAI/bge-m3"
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080
UPLOAD_DIR=./uploads

# Brand layer (env defaults; runtime override via /api/brand → app_settings.brand)
BRAND_NAME="ELARA"
BRAND_SHORT_NAME="ELARA"
BRAND_PERSONA_NAME="ELARA"
BRAND_OWNER_TITLE="Komutan"
BRAND_TAGLINE="Sovereign AI Operating System"
BRAND_DEFAULT_LOCALE=tr
BRAND_SUPPORT_EMAIL=
BRAND_LIBRARY_ROOT=/Users/levent/ELARA_PROJECT/library

# v9 — OFFLINE Mührü: HF Hub'a sızıntı yasak.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# v17 — RAM safety default: KV heartbeat kapalı. Açmak istersen 1 yap.
MLX_WARMUP_HEARTBEAT_MS=120000
MLX_WARMUP_HEARTBEAT_ENABLED=0

# ============================================================
# TLS — self-signed (mkcert). Sertifikalar yoksa HTTPS sessiz devre dışı.
# Kurulum: bash local-server/scripts/issue-cert.sh
# ============================================================
HTTPS_ENABLED=1
HTTPS_PORT=3006
TLS_CERT_FILE=./certs/elara.pem
TLS_KEY_FILE=./certs/elara-key.pem


# v11 — MLX Vision ayrı portta. Chat MLX 8001'i tutuyor; vision 8011'de.
# Vision motorunu başlat: mlx_vlm.server --port 8011 --model mlx-community/Qwen2-VL-7B-Instruct-4bit
MLX_VISION_BASE_URL=http://127.0.0.1:8011
MLX_VISION_MODEL=mlx-community/Qwen2-VL-7B-Instruct-4bit

# FAZ 24/v17 — MLX keep-warm pinger default kapalı; aksi halde middleware testinde 72B modeli uyandırır.
MLX_KEEPWARM_ENABLED=0
MLX_KEEPWARM_MS=45000
MLX_KEEPWARM_PROMPT=.
MLX_KEEPWARM_TOKENS=1
LLM_BOOT_WARMUP_ENABLED=0
MLX_VISION_WARMUP_ENABLED=0

# ============================================================
# Tur-2 — Agent Bridge
# Allowlist + ajan kayıtları artık tek kaynak: DB (agents tablosu).
# ELARA_AGENTS_DIR boş bırakılırsa runtime DB'deki agent_path'lerden
# fallback klasör çıkarır. Geriye uyum için override istersen tek
# repo kökü ver. ELARA_AGENTS_ALLOWED tamamen kalktı.
# ============================================================
ELARA_AGENTS_DIR=
ELARA_AGENTS_PYTHON=python3
ELARA_AGENTS_TIMEOUT_MS=60000

# FAZ 25 — RAG arama deadline (ms). Cevap akışını uzun bloklamasın.
# v11.3 (2026-05-22): 2500 → 4500. Rerank tek başına 2500ms ister; 2500
# bütçesi her ağır sorguyu deadline_2500ms ile skip ettiriyordu. UI knob:
# RAG paneli → "RAG probe deadline" (4500 default, 1500-8000ms).
RAG_DEADLINE_MS=4500

# v18 — Embed worker RAM safety caps (graceful suicide → middleware respawn)
EMBED_WORKER_MAX_RSS_GB=4.0
EMBED_WORKER_MAX_REQUESTS=3000
EMBED_WORKER_GC_EVERY=1
EMBED_WORKER_RSS_CHECK_SEC=30
RERANKER_MAX_RSS_GB=2.5
