PORT=3005
DATABASE_URL=postgres://app:app@localhost:5432/app_db
# Point this at your local model runtime. Stub used if unset.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:72b
# CORS — comma separated origins allowed to call the middleware
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080
# Where binary uploads (pcap, pdf, ...) get persisted on disk
UPLOAD_DIR=./uploads

# ============================================================
# Brand layer — env defaults; the operator UI may override at
# runtime by writing to the app_settings.brand row.
# ============================================================
BRAND_NAME="AI OS"
BRAND_SHORT_NAME="OS"
BRAND_PERSONA_NAME="Assistant"
BRAND_OWNER_TITLE="Operator"
BRAND_TAGLINE="Local-first AI operating system"
BRAND_DEFAULT_LOCALE=en
BRAND_SUPPORT_EMAIL=
# Optional: filesystem root for the document library. Falls back to
# ~/Documents/<short_name>/library when unset.
BRAND_LIBRARY_ROOT=

# ============================================================
# TLS — self-signed (mkcert)
# Kurulum: bash local-server/scripts/issue-cert.sh
# ============================================================
HTTPS_ENABLED=1
HTTPS_PORT=3006
TLS_CERT_FILE=./certs/elara.pem
TLS_KEY_FILE=./certs/elara-key.pem


# v11 — MLX Vision ayrı portta. Chat MLX 8001'i tutuyor; vision 8011'de.
# Vision motorunu başlat: mlx_vlm.server --port 8011 --model mlx-community/Qwen2-VL-7B-Instruct-4bit
MLX_VISION_BASE_URL=http://127.0.0.1:8011
MLX_VISION_MODEL=mlx-community/Qwen2-VL-7B-Instruct-4bit

# ============================================================
# Agent Bridge — yerel Python ajanlarını chat'ten köprü ile koştur.
# Model çıktısında "tetikliyorum: x.py" / "@[x.py]" / "running x.py"
# beyanları yakalanır ve allowlist içindeki script güvenli execFile
# ile koşturulur, stdout chat stream'ine enjekte edilir.
# ============================================================
ELARA_AGENTS_DIR=/Users/levent/ELARA_PROJECT/Agents
ELARA_AGENTS_ALLOWED=researcher.py,harvester.py
ELARA_AGENTS_TIMEOUT_MS=60000
ELARA_AGENTS_PYTHON=python3

# ============================================================
# FAZ 23 — MLX keep-warm (cold-start trim)
# Heartbeat aralığını düşürmek = ilk delta daha hızlı. 45s default.
# Floor 15s, üst sınır yok. 0 değil; kapatmak için heartbeatEnabled=0.
# ============================================================
MLX_WARMUP_HEARTBEAT_MS=45000
MLX_WARMUP_HEARTBEAT_ENABLED=0

# ============================================================
# FAZ 24 — MLX keep-warm pinger
# Idle pencerede 1-token sahte chat atılır; model + KV cache sıcak kalır.
# MLX_KEEPWARM_ENABLED=0 ile kapatılır. Floor 15s.
# ============================================================
MLX_KEEPWARM_ENABLED=0
MLX_KEEPWARM_MS=45000
MLX_KEEPWARM_PROMPT=.
MLX_KEEPWARM_TOKENS=1
LLM_BOOT_WARMUP_ENABLED=0
MLX_VISION_WARMUP_ENABLED=0

# FAZ 25 — Agent Bridge (ELARA Python ajan köprüsü)
# ELARA_AGENTS_DIR set değilse köprü pasif (her cevabın sonuna ajan hatası iliştirmez).
# Allowlist .py dosya adlarıdır (yol değil); sadece bu listedekiler çalıştırılabilir.
ELARA_AGENTS_DIR=
ELARA_AGENTS_ALLOWED=researcher.py
ELARA_AGENTS_PYTHON=python3

# FAZ 25 — RAG arama deadline (ms). Default 2500. Aşılırsa cevap RAG'siz devam eder.
RAG_DEADLINE_MS=2500

# ============================================================
# Reranker (CrossEncoder) — opsiyonel kalite katmanı
# WebUI Dashboard'dan slider/input ile değiştirilebilir; UI değerleri env'i ezer.
# ============================================================
RAG_RERANK_ENABLED=1
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_TOP_N=12
RAG_RERANK_TIMEOUT_MS=2500
RAG_RERANK_WEIGHT=0.7
RERANKER_MAX_RSS_GB=2.0
# Worker boot'unda CrossEncoder'ı önceden yükle + 1 dummy predict at.
# 1 = ilk gerçek /v1/rerank çağrısı ~50-150ms (önerilen).
# 0 = lazy load (ilk istek 2-4sn sürebilir, RAG_RERANK_TIMEOUT_MS'e takılır).
RAG_RERANK_WARMUP=1
