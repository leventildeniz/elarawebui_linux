    '      return next;\n' +
    '    });\n' +
    '    return run;\n' +
    '  }, []);\n' +
    '\n' +
    "  /* The roster is the caller's desk: own agents, shared ones, system seeds. */\n" +
    '  const visible = scopeOwned(agents, ctx);\n' +
    '\n' +
    '  return { agents: visible, allAgents: agents, ctx, runs, create, update, remove, dispatch };\n' +
