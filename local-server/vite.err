      '}) {\n' +
      '  return (\n' +
      '    <button\n' +
      '      type="button"\n' +
      '      title={title}\n' +
      '      onClick={onClick}\n' +
      '      className="flex items-center gap-1.5 rounded-lg border bg-raised/30 px-3 py-[6px] font-mono text-[12px] text-foreground/90 transition-all duration-150 ease-in-out hover:bg-raised/60"\n' +
      '      style={{ borderColor: `color-mix(in oklab, var(--${tone}) 40%, transparent)` }}\n' +
      '    >\n' +
      '      {children}\n' +
      '    </button>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      'function Toggle({\n' +
      '  on,\n' +
      '  onClick,\n' +
      '  tone = "emerald",\n' +
      '}: {\n' +
      '  on: boolean;\n' +
