      '          {tab === "tuning" && <AdvancedTuningTab />}\n' +
      '        </motion.div>\n' +
      '      </AnimatePresence>\n' +
      '\n' +
      '      <AnimatePresence>\n' +
      '        {addOpen && <AddSourceDialog onClose={() => setAddOpen(false)} />}\n' +
      '      </AnimatePresence>\n' +
      '    </Surface>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      '/* ----------------------------------------------------------- control tab */\n' +
