    '  ragKeywords: string;\n' +
    '  icon: string;\n' +
    '  avatar: { seed: string; style: AvatarStyle; jewel: JewelName };\n' +
    '  stats: { calls: number; success: number; latencyMs: number };\n' +
    '  createdAt: number;\n' +
    '};\n' +
    '\n' +
    'export { knowledgeBrands };\n' +
    '\n' +
    'export const capabilityPacks = [\n' +
    '  "DevOps & SRE",\n' +
    '  "Research & Analysis",\n' +
    '  "Social Producer",\n' +
    '  "Healthcare",\n' +
    '  "Cyber Security",\n' +
    '  "NetSec Operator",\n' +
    '  "Network Forensics",\n' +
    '  "Network Recon",\n' +
    '  "SOC Phishing Kit",\n' +
    '  "YouTube Intelligence",\n' +
    '];\n' +
    '\n' +
    'export const skillCatalog = [\n' +
    '  "crisis-response",\n' +
    '  "markdown-report",\n' +
    '  "pii-redactor",\n' +
    '  "config-diff",\n' +
    '  "packet-triage",\n' +
    '  "cve-correlate",\n' +
    '  "cta-microcopy",\n' +
    '  "sql-analyst",\n' +
    '];\n' +
    '\n' +
    'export const toolCatalog = [\n' +
    '  "web.fetch",\n' +
    '  "sql.query",\n' +
    '  "fs.write",\n' +
    '  "vector.search",\n' +
    '  "ssh.exec",\n' +
    '  "pcap.parse",\n' +
    '  "http.probe",\n' +
    '  "vault.read",\n' +
    '];\n' +
    '\n' +
    'export const adapterCatalog = ["Cloudflare", "Checkpoint", "X.com", "RSS", "Splunk", "Jira"];\n' +
    'export const targetCatalog = [\n' +
    '  "Forti-Group",\n' +
    '  "Checkpoint-Group",\n' +
    '  "edge-01",\n' +
