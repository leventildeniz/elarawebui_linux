    '  } catch {\n' +
    '    /* ignore */\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    'export function useAgents() {\n' +
    '  const [agents, setAgents] = useState<StudioAgent[]>(seedAgents);\n' +
    '  const [runs, setRuns] = useState<AgentRun[]>(seedRuns);\n' +
    '  const ctx = useOwnerCtx();\n' +
    '\n' +
    '  useEffect(() => {\n' +
    '    const sync = async () => {\n' +
    '      try {\n' +
    '        const data = await fetchApi("/api/agents");\n' +
    '        if (Array.isArray(data) && data.length > 0) {\n' +
    '          setAgents(data);\n' +
    '        } else {\n' +
    '          setAgents(seedAgents);\n' +
    '        }\n' +
    '      } catch (err) {\n' +
    '        console.error("Failed to load agents from API", err);\n' +
    '        setAgents(read());\n' +
    '      }\n' +
    '      setRuns(readRuns());\n' +
    '    };\n' +
    '    sync();\n' +
    '    window.addEventListener(EVT, sync);\n' +
    '    return () => window.removeEventListener(EVT, sync);\n' +
    '  }, []);\n' +
    '\n' +
    '  const create = useCallback(async (draft: Omit<StudioAgent, "id" | "createdAt">) => {\n' +
    '    const id = `agt.${Math.random().toString(36).slice(2, 8)}`;\n' +
    '    const newAgent = stampOwner({ ...draft, id, createdAt: Date.now() });\n' +
    '    try {\n' +
    '      await fetchApi("/api/agents", {\n' +
    '        method: "POST",\n' +
    '        body: JSON.stringify(newAgent)\n' +
    '      });\n' +
    '      setAgents((prev) => [...prev, newAgent]);\n' +
    '      return id;\n' +
    '    } catch (err) {\n' +
    '      console.error("Failed to create agent", err);\n' +
    '      throw err;\n' +
    '    }\n' +
    '  }, []);\n' +
    '    return id;\n' +
    '  }, [ctx]);\n' +
    '\n' +
    '  const update = useCallback(async (id: string, patch: Partial<StudioAgent>) => {\n' +
    '    try {\n' +
    '      await fetchApi(`/api/agents/${id}`, {\n' +
    '        method: "PUT",\n' +
    '        body: JSON.stringify(patch)\n' +
    '      });\n' +
    '      setAgents((prev) => prev.map((a) => (a.id === id ? { ...a, ...patch } : a)));\n' +
    '    } catch (err) {\n' +
    '      console.error("Failed to update agent", err);\n' +
    '    }\n' +
    '  }, []);\n' +
    '\n' +
    '  const remove = useCallback(async (id: string) => {\n' +
    '    try {\n' +
    '      await fetchApi(`/api/agents/${id}`, { method: "DELETE" });\n' +
    '      setAgents((prev) => prev.filter((a) => a.id !== id));\n' +
    '    } catch (err) {\n' +
    '      console.error("Failed to remove agent", err);\n' +
    '    }\n' +
    '  }, []);\n' +
    '\n' +
