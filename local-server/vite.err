      '        )}\n' +
      '        style={\n' +
      '          on\n' +
      '            ? { background: `var(--${tone})`, boxShadow: `0 0 12px -2px var(--${tone})` }\n' +
      '            : undefined\n' +
      '        }\n' +
      '      />\n' +
      '    </button>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      '/* ----------------------------------------------------------- dictionaries -- */\n' +
      '\n' +
      'function DictColumn({ kind }: { kind: DictKind }) {\n' +
      '  const { dict, upsertDict, removeDict, usedBy } = useAdapters();\n' +
      '  const meta = dictMeta[kind];\n' +
      '  const Icon = meta.icon;\n' +
      '  const [editing, setEditing] = useState<string | null>(null);\n' +
      '  const [draft, setDraft] = useState<{ key: string; label: string }>({ key: "", label: "" });\n' +
      '\n' +
      '  const startNew = () => {\n' +
      '    setEditing("new");\n' +
      '    setDraft({ key: "", label: "" });\n' +
      '  };\n' +
      '\n' +
      '  const commit = () => {\n' +
      '    const key = draft.key.trim().toLowerCase().replace(/\\s+/g, "_");\n' +
      '    if (!key) return setEditing(null);\n' +
      '    const id = editing === "new" ? `d.${key}.${Date.now().toString(36)}` : editing!;\n' +
      '    upsertDict(kind, { id, key, label: draft.label.trim() || key });\n' +
      '    setEditing(null);\n' +
      '  };\n' +
      '\n' +
      '  return (\n' +
