$ vite dev
Error parsing code /_app/settings import { createFileRoute } from "@tanstack/react-router";
import { PageShell, PageHeader } from "@/components/page-shell";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Badge } from "@/components/ui/badge";

import { Switch } from "@/components/ui/switch";
import { Slider } from "@/components/ui/slider";
import { Progress } from "@/components/ui/progress";
import {
  Select, SelectContent, SelectItem, SelectTrigger, SelectValue, SelectGroup, SelectLabel, SelectSeparator,
} from "@/components/ui/select";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Download, Upload, RotateCcw, Server, Plus, Minus, Palette, Plug, Cpu, MemoryStick, Activity, Sparkles, Trash2, Save, ImagePlus, BarChart3, Wand2, Database, ShieldCheck, Globe, Terminal, Zap } from "lucide-react";
import { SkillConverter } from "@/components/skill-converter";
import { RuntimeControlPanel } from "@/components/runtime-control-panel";

import { useRef } from "react";
import { useEffect, useState } from "react";
import {
  useAuth, ROLES, ROLE_PERMS,
  type AuthProviderConfig, type RbacRule, type Role,
} from "@/lib/auth";
import { useTheme, FONT_CATEGORIES, FONT_FAMILY_MAP, type ThemeName, type FontFamily } from "@/lib/theme";
import { useSystem } from "@/lib/system-store";
import { useSecurity } from "@/lib/security-store";
import { MetricsAPI, AuthAPI, ProvidersAPI, BackupAPI, SystemAPI, AppSettingsAPI, TelemetryAPI, SystemEngineAPI, getApiBaseUrl, type MetricsFrame, type AiProviderDTO, type ProviderUsageResponse, type VoiceProfileDTO, type AiRoutingPolicy } from "@/lib/api-client";
import { useVoice } from "@/lib/voice-store";
import { useI18n } from "@/lib/i18n";

import { toast } from "sonner";

export const Route = createFileRoute("/_app/settings")({ component: SettingsPage });

const PROVIDER_LABELS: Record<AuthProviderConfig["id"], string> = {
  local: "Local", ldap: "LDAP", radius: "RADIUS", saml: "SAML", oidc: "OIDC", oauth2: "OAuth2",
};

function SettingsPage() {
  const { t } = useI18n();
  const { providers, setProviders, rbac, setRbac, brand, setBrand } = useAuth();
  const { theme, setTheme, font, setFont, fontSize, setFontSize, custom, setCustom } = useTheme();
  const [testing, setTesting] = useState<string | null>(null);
  const backupInputRef = useRef<HTMLInputElement>(null);
  const [backupBusy, setBackupBusy] = useState<"export" | "import" | "rollback" | "pgdump" | "pgrestore" | "list" | "delete" | "restoreFile" | null>(null);
  const pgRestoreInputRef = useRef<HTMLInputElement>(null);
  const [restoreMode, setRestoreMode] = useState<"full" | "db" | "files">("full");
  const [backupFiles, setBackupFiles] = useState<Array<{ name: string; bytes: number; mtime: number; sha256: string | null }>>([]);
  const [supervisor, setSupervisor] = useState<{ kind: string; label?: string | null; plist?: string | null; keep_alive?: boolean | null; can_auto_restart: boolean; hint?: string } | null>(null);

  const refreshBackupList = async () => {
    try { const r = await BackupAPI.list(); setBackupFiles(r.files || []); }
    catch (e) { toast.error(`Catalog read failed: ${(e as Error).message}`); }
  };
  const refreshSupervisor = async () => {
    try { const r = await BackupAPI.supervisor(); setSupervisor(r.supervisor); }
    catch { /* bridge offline */ }
  };
  useEffect(() => { void refreshBackupList(); void refreshSupervisor(); }, []);

  const updateProvider = (id: AuthProviderConfig["id"], patch: Partial<AuthProviderConfig>) =>
    setProviders(providers.map(p => p.id === id ? { ...p, ...patch } : p));

  const testProvider = async (p: AuthProviderConfig) => {
    setTesting(p.id);
    const r = await AuthAPI.test(p.id, p as unknown as Record<string, unknown>);
    setTesting(null);
    if (r.ok) toast.success(`${p.id.toUpperCase()} OK · ${r.latencyMs}ms`);
    else toast.error(`${p.id.toUpperCase()} test failed: ${r.message}`);
  };
  const exportPgDump = async () => {
    setBackupBusy("pgdump");
    try { const bytes = await BackupAPI.pgDump(); toast.success(`pg_dumpall sealed · ${(bytes / 1024 / 1024).toFixed(2)} MB`); void refreshBackupList(); }
    catch (e) { toast.error(`pg_dumpall failed: ${(e as Error).message}`); }
    finally { setBackupBusy(null); }
  };
  const restorePgDump = async (file?: File) => {
    if (!file) return;
    if (!window.confirm(`Restore PostgreSQL from ${file.name}? This will OVERWRITE current data.`)) return;
    setBackupBusy("pgrestore");
    try {
      const r = await BackupAPI.pgRestore(file);
      if (r.ok) toast.success(`pg_restore applied · ${r.kind ?? "single"} · ${r.file ?? file.name}`);
      else toast.error(`pg_restore failed: ${r.error ?? "unknown"}`);
    } catch (e) { toast.error(`pg_restore failed: ${(e as Error).message}`); }
    finally { setBackupBusy(null); if (pgRestoreInputRef.current) pgRestoreInputRef.current.value = ""; }
  };
  const addRbac = () =>
    setRbac([...rbac, { id: `r${Date.now()}`, match: "", provider: "local", role: "Viewer" }]);
  const removeRbac = (id: string) => setRbac(rbac.filter(r => r.id !== id));
  const updRbac = (id: string, patch: Partial<RbacRule>) =>
    setRbac(rbac.map(r => r.id === id ? { ...r, ...patch } : r));

  const restoreSummary = (r: { db?: { mode: string; restored?: Record<string, unknown> }; uploads?: number; restart?: boolean }) => {
    const dbCount = r.db?.restored ? Object.keys(r.db.restored).length : 0;
    return `mode=${r.db?.mode ?? "?"} · ${dbCount} db · ${r.uploads ?? 0} files${r.restart ? " · restart scheduled" : ""}`;
  };

  const exportBackup = async () => {
    setBackupBusy("export");
    try { const bytes = await BackupAPI.download(); toast.success(`Snapshot sealed · ${(bytes / 1024 / 1024).toFixed(2)} MB`); void refreshBackupList(); }
    catch (e) { toast.error(`Export failed: ${(e as Error).message}`); }
    finally { setBackupBusy(null); }
  };
  const importBackup = async (file?: File) => {
    if (!file) return;
    if (!window.confirm(`Restore from ${file.name}?\nMode: ${restoreMode.toUpperCase()}\nA pre-restore snapshot will be taken automatically.`)) return;
    setBackupBusy("import");
    try {
      const r = await BackupAPI.restore(file, restoreMode);
      if (r.ok) {
        toast.success(`Restored · ${restoreSummary(r)}`);
        if (r.restart) toast.warning("Bridge will restart in ~2s to apply code swap. Reload the page after.");
        void refreshBackupList();
      } else toast.error(`Restore failed: ${r.error ?? "unknown"}`);
    } catch (e) { toast.error(`Import failed: ${(e as Error).message}`); }
    finally { setBackupBusy(null); if (backupInputRef.current) backupInputRef.current.value = ""; }
  };
  const rollbackBackup = async () => {
    if (!window.confirm("Roll back to the most recent pre-restore snapshot (or latest archive)?")) return;
    setBackupBusy("rollback");
    try {
      const r = await BackupAPI.rollback(restoreMode);
      if (r.ok) toast.success(`Rollback applied · ${(r as { source?: string }).source ?? ""} · ${(r as { file?: string }).file ?? ""}`);
      else toast.error(`Rollback failed: ${r.error ?? "unknown"}`);
      void refreshBackupList();
    } catch (e) { toast.error(`Rollback failed: ${(e as Error).message}`); }
    finally { setBackupBusy(null); }
  };
  const restoreCatalogFile = async (name: string) => {
    if (!window.confirm(`Restore from ${name}?\nMode: ${restoreMode.toUpperCase()}`)) return;
    setBackupBusy("restoreFile");
    try {
      const r = await BackupAPI.restoreFile(name, restoreMode);
      if (r.ok) {
        toast.success(`Restored · ${restoreSummary(r)}`);
        if (r.restart) toast.warning("Bridge will restart in ~2s to apply code swap.");
        void refreshBackupList();
      } else toast.error(`Restore failed: ${r.error ?? "unknown"}`);
    } catch (e) { toast.error(`Restore failed: ${(e as Error).message}`); }
    finally { setBackupBusy(null); }
  };
  const deleteCatalogFile = async (name: string) => {
    if (!window.confirm(`Delete ${name} permanently?`)) return;
    setBackupBusy("delete");
    try {
      const r = await BackupAPI.deleteFile(name);
      if (r.ok) { toast.success(`Deleted ${name}`); void refreshBackupList(); }
      else toast.error(`Delete failed: ${r.error ?? "unknown"}`);
    } catch (e) { toast.error(`Delete failed: ${(e as Error).message}`); }
    finally { setBackupBusy(null); }
  };

  return (
    <PageShell>
      <PageHeader title={t("nav.settings")} subtitle={t("settings.subtitle")} />

      <Tabs defaultValue="branding">
        <TabsList className="glass mb-4 flex-wrap h-auto">
          <TabsTrigger value="branding">{t("settings.tab.branding")}</TabsTrigger>
          <TabsTrigger value="profile">{t("settings.tab.profile")}</TabsTrigger>
          <TabsTrigger value="auth">{t("settings.tab.auth")}</TabsTrigger>
          <TabsTrigger value="rbac">{t("settings.tab.rbac")}</TabsTrigger>
          <TabsTrigger value="providers">{t("settings.tab.providers")}</TabsTrigger>
          
          <TabsTrigger value="usage">{t("settings.tab.usage")}</TabsTrigger>
          <TabsTrigger value="voice">{t("settings.tab.voice")}</TabsTrigger>
          <TabsTrigger value="hardware">{t("settings.tab.hardware")}</TabsTrigger>
          <TabsTrigger value="runtime"><Activity className="h-3 w-3 mr-1" />Runtime</TabsTrigger>
          <TabsTrigger value="services">{t("settings.tab.services")}</TabsTrigger>
          <TabsTrigger value="database"><Database className="h-3 w-3 mr-1" />Database</TabsTrigger>
          <TabsTrigger value="converter"><Wand2 className="h-3 w-3 mr-1" />{t("settings.tab.converter")}</TabsTrigger>
        </TabsList>

        {/* ---------------- RUNTIME (single source of truth) ---------------- */}
        <TabsContent value="runtime"><RuntimeControlPanel /></TabsContent>


        {/* ---------------- BRANDING ---------------- */}
        <TabsContent value="branding"><BrandingPanel/></TabsContent>

        {/* ---------------- PROFILE / THEME ---------------- */}
        <TabsContent value="profile">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <Card className="glass">
              <CardContent className="p-6 space-y-4">
                <h3 className="font-bold text-sm font-mono uppercase tracking-widest flex items-center gap-2">
                  <Palette className="h-4 w-4 text-primary" /> Theme
                </h3>
                <div className="grid grid-cols-3 gap-2">
                  {(["midnight","matrix","cyberpunk","obsidian","sunset","arctic","rose","forest","platinum","executive","azure","graphite","imperial","monarch","pearl","nebula","carbon","solaris","abyss","custom"] as ThemeName[]).map(th => (
                    <button key={th} onClick={() => setTheme(th)}
                      className={`border rounded p-2 text-xs font-mono capitalize ${theme===th?"border-primary text-primary":"border-border"}`}>
                      {th}
                    </button>
                  ))}
                </div>

                {theme === "custom" && (
                  <div className="space-y-3 border-t border-border pt-4">
                    <p className="text-xs font-mono uppercase tracking-widest text-muted-foreground">Custom Palette</p>
                    {(["background","primary","accent"] as const).map(k => (
                      <div key={k} className="flex items-center gap-3">
                        <Label className="w-28 capitalize">{k}</Label>
                        <input type="color" value={custom[k]} onChange={(e) => setCustom({ ...custom, [k]: e.target.value })}
                          className="h-9 w-12 rounded cursor-pointer bg-transparent" />
                        <Input value={custom[k]} onChange={(e) => setCustom({ ...custom, [k]: e.target.value })} className="font-mono" />
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>

            <Card className="glass">
              <CardContent className="p-6 space-y-4">
                <h3 className="font-bold text-sm font-mono uppercase tracking-widest">My Profile · Typography</h3>
                <div>
                  <Label>Font Family</Label>
                  <Select value={font} onValueChange={(v) => setFont(v as FontFamily)}>
                    <SelectTrigger className="mt-2" style={{ fontFamily: FONT_FAMILY_MAP[font] }}>
                      <SelectValue />
                    </SelectTrigger>
                    <SelectContent className="max-h-96">
                      {FONT_CATEGORIES.map((cat, ci) => (
                        <SelectGroup key={cat.label}>
                          {ci > 0 && <SelectSeparator />}
                          <SelectLabel className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground/70">
                            {cat.label}
                          </SelectLabel>
                          {cat.items.map((it) => (
                            <SelectItem key={it.id} value={it.id} style={{ fontFamily: FONT_FAMILY_MAP[it.id] }}>
                              {it.name}
                            </SelectItem>
                          ))}
                        </SelectGroup>
                      ))}
                    </SelectContent>
                  </Select>
                </div>
                <div>
                  <div className="flex items-center justify-between">
                    <Label>Font Size</Label>
                    <div className="flex items-center gap-2">
                      <Input
                        type="number" min={10} max={24}
                        value={fontSize}
                        onChange={(e) => {
                          const n = Number(e.target.value);
                          if (Number.isFinite(n)) setFontSize(n);
                        }}
                        className="h-7 w-16 text-xs font-mono text-right"
                      />
                      <span className="text-[10px] font-mono text-muted-foreground">px</span>
                      <Button variant="ghost" size="sm" className="h-7 px-2 text-[10px]" onClick={() => setFontSize(14)}>
                        Reset
                      </Button>
                    </div>
                  </div>
                  <Slider
                    className="mt-3"
                    value={[fontSize]}
                    min={10} max={24} step={1}
                    onValueChange={(v) => setFontSize(v[0])}
                  />
                  <div className="mt-1 flex justify-between text-[9px] font-mono text-muted-foreground/60">
                    <span>10</span><span>14</span><span>18</span><span>24</span>
                  </div>
                </div>
                <div className="border border-border rounded p-3 bg-card/40 space-y-1" style={{ fontFamily: FONT_FAMILY_MAP[font] }}>
                  <p className="text-xs text-muted-foreground font-mono mb-1">Preview</p>
                  <p className="text-xl font-semibold">Aa Bb Cc · The quick brown fox 0123</p>
                  <p className="text-base">The quick brown fox jumps over the lazy dog · 0123456789</p>
                </div>
              </CardContent>
            </Card>
          </div>
        </TabsContent>

        {/* ---------------- AUTH PROVIDERS ---------------- */}
        <TabsContent value="auth">
          <div className="space-y-3">
            {providers.map(p => (
              <Card key={p.id} className="glass">
                <CardContent className="p-5 space-y-3">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <Badge variant="outline" className="font-mono">{PROVIDER_LABELS[p.id]}</Badge>
                      {p.enabled && <span className="pulse-dot" />}
                    </div>
                    <Switch checked={p.enabled} onCheckedChange={(v) => updateProvider(p.id, { enabled: v })} />
                  </div>

                  {p.id === "ldap" && (
                    <>
                      <div className="grid grid-cols-2 gap-3">
                        <FieldX label="Host / IP"      v={p.host}         on={(x) => updateProvider(p.id, { host: x })} />
                        <FieldX label="Port"           v={p.port}         on={(x) => updateProvider(p.id, { port: x })} />
                        <FieldX label="Base DN"        v={p.baseDn}       on={(x) => updateProvider(p.id, { baseDn: x })} />
                        <FieldX label="Bind DN"        v={p.bindDn}       on={(x) => updateProvider(p.id, { bindDn: x })} />
                        <FieldX label="Bind Password"  v={p.bindPassword} on={(x) => updateProvider(p.id, { bindPassword: x })} type="password" />
                        <FieldX label="User Filter"    v={p.userFilter ?? ""}     on={(x) => updateProvider(p.id, { userFilter: x })} />
                      </div>
                      <div className="grid grid-cols-2 gap-3 pt-2 border-t border-border">
                        <FieldX label="User DN Template" v={p.userDnTemplate ?? ""} on={(x) => updateProvider(p.id, { userDnTemplate: x })} />
                        <div className="space-y-1">
                          <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">Role Map (group → role JSON)</Label>
                          <Input
                            className="font-mono text-xs h-9"
                            value={p.roleMap ? JSON.stringify(p.roleMap) : ""}
                            placeholder='{"Domain Admins":"Admin","Operators":"Operator"}'
                            onChange={(e) => {
                              try { updateProvider(p.id, { roleMap: e.target.value ? JSON.parse(e.target.value) : undefined }); }
                              catch { /* keep typing */ }
                            }}
                          />
                        </div>
                      </div>
                      <p className="text-[10px] text-muted-foreground font-mono">
                        Default filter <code>(|(uid={`{u}`})(sAMAccountName={`{u}`})(userPrincipalName={`{u}`}))</code> works for OpenLDAP &amp; Active Directory.
                      </p>
                    </>
                  )}
                  {p.id === "radius" && (
                    <>
                      <div className="grid grid-cols-2 gap-3">
                        <FieldX label="Host / IP"     v={p.host}   on={(x) => updateProvider(p.id, { host: x })} />
                        <FieldX label="Port"          v={p.port}   on={(x) => updateProvider(p.id, { port: x })} />
                        <FieldX label="Shared Secret" v={p.secret} on={(x) => updateProvider(p.id, { secret: x })} type="password" />
                        <div className="space-y-1">
                          <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">Auth Method</Label>
                          <Select value={p.authMethod ?? "pap"} onValueChange={(v) => updateProvider(p.id, { authMethod: v as "pap" | "mschapv2" })}>
                            <SelectTrigger className="h-9"><SelectValue /></SelectTrigger>
                            <SelectContent>
                              <SelectItem value="pap">PAP (User-Password)</SelectItem>
                              <SelectItem value="mschapv2">MSCHAPv2</SelectItem>
                            </SelectContent>
                          </Select>
                        </div>
                        <FieldX label="NAS-IP-Address"  v={p.nasIp ?? ""}         on={(x) => updateProvider(p.id, { nasIp: x })} />
                        <FieldX label="NAS-Identifier"  v={p.nasIdentifier ?? ""} on={(x) => updateProvider(p.id, { nasIdentifier: x })} />
                      </div>
                      <div className="grid grid-cols-2 gap-3 pt-2 border-t border-border">
                        <div className="space-y-1">
                          <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">Role Attribute (NPS reply)</Label>
                          <Select value={p.roleAttribute ?? "Filter-Id"} onValueChange={(v) => updateProvider(p.id, { roleAttribute: v as "Filter-Id" | "Class" | "Vendor-Specific" })}>
                            <SelectTrigger className="h-9"><SelectValue /></SelectTrigger>
                            <SelectContent>
                              <SelectItem value="Filter-Id">Filter-Id (recommended)</SelectItem>
                              <SelectItem value="Class">Class</SelectItem>
                              <SelectItem value="Vendor-Specific">Vendor-Specific (VSA)</SelectItem>
                            </SelectContent>
                          </Select>
                        </div>
                        <div className="space-y-1">
                          <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">Role Map (group → role JSON)</Label>
                          <Input
                            className="font-mono text-xs h-9"
                            value={p.roleMap ? JSON.stringify(p.roleMap) : ""}
                            placeholder='{"Domain Admins":"Admin","Operators":"Operator"}'
                            onChange={(e) => {
                              try { updateProvider(p.id, { roleMap: e.target.value ? JSON.parse(e.target.value) : undefined }); }
                              catch { /* keep typing */ }
                            }}
                          />
                        </div>
                      </div>
                      <div className="grid grid-cols-2 gap-3 pt-2 border-t border-border">
                        <FieldX label="Live test username" v={p.testUsername ?? ""} on={(x) => updateProvider(p.id, { testUsername: x })} />
                        <FieldX label="Live test password" v={p.testPassword ?? ""} on={(x) => updateProvider(p.id, { testPassword: x })} type="password" />
                      </div>
                      <p className="text-[10px] text-muted-foreground font-mono">
                        On NPS, attach a Network Policy with a <strong>Filter-Id</strong> RADIUS attribute (Standard tab → Add → Filter-Id) per AD group.
                        For MSCHAPv2 enable <strong>Constraints → Authentication Methods → Microsoft Encrypted Authentication v2</strong>.
                        Live-test fields are not persisted — they only run a real Access-Request when you press Test Connection.
                      </p>
                    </>
                  )}
                  {p.id === "saml" && (
                    <div className="grid grid-cols-2 gap-3">
                      <FieldX label="IdP Metadata URL" v={p.metadataUrl} on={(x) => updateProvider(p.id, { metadataUrl: x })} />
                      <FieldX label="SP Realm / Entity ID" v={p.realm}   on={(x) => updateProvider(p.id, { realm: x })} />
                    </div>
                  )}
                  {p.id === "oidc" && (
                    <div className="grid grid-cols-2 gap-3">
                      <FieldX label="Issuer URL"   v={p.issuer}       on={(x) => updateProvider(p.id, { issuer: x })} />
                      <FieldX label="Client ID"    v={p.clientId}     on={(x) => updateProvider(p.id, { clientId: x })} />
                      <FieldX label="Client Secret" v={p.clientSecret} on={(x) => updateProvider(p.id, { clientSecret: x })} type="password" />
                      <FieldX label="Redirect URI" v={p.redirectUri}  on={(x) => updateProvider(p.id, { redirectUri: x })} />
                      <FieldX label="Scope"        v={p.scope}        on={(x) => updateProvider(p.id, { scope: x })} />
                    </div>
                  )}
                  {p.id === "oauth2" && (
                    <div className="grid grid-cols-2 gap-3">
                      <FieldX label="Authorize URL" v={p.authorizeUrl} on={(x) => updateProvider(p.id, { authorizeUrl: x })} />
                      <FieldX label="Token URL"     v={p.tokenUrl}     on={(x) => updateProvider(p.id, { tokenUrl: x })} />
                      <FieldX label="Userinfo URL"  v={p.userinfoUrl}  on={(x) => updateProvider(p.id, { userinfoUrl: x })} />
                      <FieldX label="Client ID"     v={p.clientId}     on={(x) => updateProvider(p.id, { clientId: x })} />
                      <FieldX label="Client Secret" v={p.clientSecret} on={(x) => updateProvider(p.id, { clientSecret: x })} type="password" />
                      <FieldX label="Redirect URI"  v={p.redirectUri}  on={(x) => updateProvider(p.id, { redirectUri: x })} />
                      <FieldX label="Scope"         v={p.scope}        on={(x) => updateProvider(p.id, { scope: x })} />
                    </div>
                  )}
                  {p.id === "local" && (
                    <p className="text-xs text-muted-foreground font-mono">Local username/password authentication (always available).</p>
                  )}

                  {(p.id === "ldap" || p.id === "radius") && (
                    <div className="grid grid-cols-2 gap-3">
                      <FieldX label="Secondary Host (failover)" v={p.host2 ?? ""} on={(x)=>updateProvider(p.id,{ host2: x })}/>
                      <FieldX label="Secondary Port"            v={p.port2 ?? ""} on={(x)=>updateProvider(p.id,{ port2: x })}/>
                    </div>
                  )}

                  <div className="flex items-center gap-3 pt-2 border-t border-border">
                    <Label className="text-xs">Default role for new accounts:</Label>
                    <Select value={p.defaultRole ?? "Viewer"} onValueChange={(v) => updateProvider(p.id, { defaultRole: v as Role })}>
                      <SelectTrigger className="w-40 h-8"><SelectValue /></SelectTrigger>
                      <SelectContent>{ROLES.map(r => <SelectItem key={r} value={r}>{r}</SelectItem>)}</SelectContent>
                    </Select>
                    {p.id !== "local" && (
                      <Button size="sm" variant="outline" className="ml-auto"
                        disabled={testing===p.id} onClick={()=>testProvider(p)}>
                        <Plug className="h-3.5 w-3.5 mr-1"/>{testing===p.id?"Testing…":"Test Connection"}
                      </Button>
                    )}
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        </TabsContent>

        {/* ---------------- RBAC ---------------- */}
        <TabsContent value="rbac">
          <Card className="glass">
            <CardContent className="p-6 space-y-4">
              <div className="flex items-center justify-between">
                <h3 className="font-bold text-sm font-mono uppercase tracking-widest">Role Mapping Rules</h3>
                <Button size="sm" variant="outline" onClick={addRbac}><Plus className="h-3.5 w-3.5 mr-1" />Add Rule</Button>
              </div>
              <div className="grid grid-cols-5 gap-2 text-[10px] font-mono uppercase tracking-widest text-muted-foreground">
                <span>Match (user / group / *)</span><span>Provider</span><span>Role</span><span>Permission</span><span></span>
              </div>
              {rbac.map((r) => (
                <div key={r.id} className="grid grid-cols-5 gap-2 items-center">
                  <Input value={r.match} onChange={(e) => updRbac(r.id, { match: e.target.value })} placeholder="username or *" className="font-mono text-xs h-9" />
                  <Select value={r.provider} onValueChange={(v) => updRbac(r.id, { provider: v as AuthProviderConfig["id"] })}>
                    <SelectTrigger className="h-9"><SelectValue /></SelectTrigger>
                    <SelectContent>
                      {(Object.keys(PROVIDER_LABELS) as (keyof typeof PROVIDER_LABELS)[]).map(k =>
                        <SelectItem key={k} value={k}>{PROVIDER_LABELS[k]}</SelectItem>)}
                    </SelectContent>
                  </Select>
                  <Select value={r.role} onValueChange={(v) => updRbac(r.id, { role: v as Role })}>
                    <SelectTrigger className="h-9"><SelectValue /></SelectTrigger>
                    <SelectContent>{ROLES.map(role => <SelectItem key={role} value={role}>{role}</SelectItem>)}</SelectContent>
                  </Select>
                  <span className="text-[11px] text-muted-foreground font-mono">{ROLE_PERMS[r.role]}</span>
                  <Button size="icon" variant="ghost" className="h-9 w-9 text-destructive" onClick={() => removeRbac(r.id)}>
                    <Minus className="h-3.5 w-3.5" />
                  </Button>
                </div>
              ))}

              <div className="border-t border-border pt-3 mt-3">
                <p className="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-2">Role Reference</p>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                  {ROLES.map(r => (
                    <div key={r} className="flex justify-between border border-border rounded p-2 text-xs font-mono">
                      <span className="text-primary">{r}</span><span className="text-muted-foreground">{ROLE_PERMS[r]}</span>
                    </div>
                  ))}
                </div>
              </div>
            </CardContent>
          </Card>
        </TabsContent>

        {/* ---------------- AI PROVIDERS ---------------- */}
        <TabsContent value="providers"><ProvidersPanel /></TabsContent>

        {/* Agent Factory removed — manage agents in the Agents tab */}

        {/* ---------------- USAGE ---------------- */}
        <TabsContent value="usage"><UsagePanel/></TabsContent>

        <TabsContent value="voice"><VoiceAudioPanel/></TabsContent>

        {/* ---------------- HARDWARE (live, read-only) ---------------- */}
        <TabsContent value="hardware">
          <HardwareLive />
        </TabsContent>

        {/* ---------------- SERVICES + BACKUP ---------------- */}
        <TabsContent value="services">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <Card className="glass lg:col-span-2">
              <CardContent className="p-6 space-y-4">
                <div className="flex items-start justify-between gap-4 flex-wrap">
                  <div>
                    <h3 className="font-bold text-sm font-mono uppercase tracking-widest">System Snapshot (.eez)</h3>
                    <p className="text-xs text-muted-foreground">Code · DB (pg_dump -Fc) · uploads · config · memory. Pre-restore safety snapshot is automatic. <code className="text-primary">node_modules</code>/<code className="text-primary">.git</code>/models excluded.</p>
                  </div>
                  <div className="flex items-center gap-2 text-xs">
                    <span className="font-mono uppercase tracking-wider text-muted-foreground">Restore mode</span>
                    <div className="inline-flex rounded-md border border-border overflow-hidden font-mono text-xs">
                      {(["full", "db", "files"] as const).map((m) => (
                        <button key={m}
                          onClick={() => setRestoreMode(m)}
                          className={`px-3 py-1 ${restoreMode === m ? "bg-primary text-primary-foreground" : "bg-transparent hover:bg-muted/40"}`}>
                          {m.toUpperCase()}
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
                <div className="flex gap-2 flex-wrap">
                  <Button variant="outline" disabled={!!backupBusy} onClick={exportBackup}>
                    <Download className="h-4 w-4 mr-1" />{backupBusy === "export" ? "Snapshotting…" : "Export Snapshot (.eez)"}
                  </Button>
                  <Button variant="outline" disabled={!!backupBusy} onClick={() => backupInputRef.current?.click()}>
                    <Upload className="h-4 w-4 mr-1" />{backupBusy === "import" ? "Restoring…" : `Import (${restoreMode.toUpperCase()})`}
                  </Button>
                  <Button variant="outline" disabled={!!backupBusy} onClick={rollbackBackup}>
                    <RotateCcw className="h-4 w-4 mr-1" />{backupBusy === "rollback" ? "Rolling…" : "Rollback to pre-restore"}
                  </Button>
                  <Button variant="outline" disabled={!!backupBusy} onClick={() => void refreshBackupList()}>
                    Refresh catalog
                  </Button>
                  <input ref={backupInputRef} type="file" accept=".eez,.eezpg,.zip,.json,application/zip,application/json" hidden onChange={(e) => { void importBackup(e.target.files?.[0]); }} />
                </div>
                <p className="text-[10px] text-muted-foreground font-mono">
                  Restore order: pre-flight → code (staging) → DB → uploads → atomic swap → restart. <strong>FULL</strong> mode may schedule a bridge restart to apply code changes.
                </p>
              </CardContent>
            </Card>

            <Card className="glass border-primary/40">
              <CardContent className="p-6 space-y-4">
                <h3 className="font-bold text-sm font-mono uppercase tracking-widest flex items-center gap-2">
                  <Server className="h-4 w-4 text-primary" /> PostgreSQL Cluster Backup
                </h3>
                <p className="text-xs text-muted-foreground">
                  <code className="font-mono text-primary">pg_dumpall --globals-only</code> + per-DB <code className="font-mono text-primary">pg_dump -Fc</code> bundled in a <code>.eezpg</code> archive. Restores roles + every database, not just <code>{`elara_db`}</code>.
                </p>
                <div className="flex gap-2 flex-wrap">
                  <Button variant="outline" disabled={!!backupBusy} onClick={exportPgDump}>
                    <Download className="h-4 w-4 mr-1" />{backupBusy === "pgdump" ? "Dumping cluster…" : "Export pg_dumpall (.eezpg)"}
                  </Button>
                  <Button variant="outline" disabled={!!backupBusy} onClick={() => pgRestoreInputRef.current?.click()}>
                    <Upload className="h-4 w-4 mr-1" />{backupBusy === "pgrestore" ? "Restoring…" : "Restore (.eezpg/.dump/.sql)"}
                  </Button>
                  <input ref={pgRestoreInputRef} type="file" accept=".eezpg,.dump,.sql,.backup,.pgcustom,application/octet-stream,application/zip" hidden onChange={(e) => { void restorePgDump(e.target.files?.[0]); }} />
                </div>
                <p className="text-[10px] text-muted-foreground font-mono">
                  Backend: <span className="text-primary">GET /api/backup/pg-dump</span> · <span className="text-primary">POST /api/backup/pg-restore</span>. Major-version mismatch is rejected.
                </p>
              </CardContent>
            </Card>

            <Card className="glass lg:col-span-2">
              <CardContent className="p-6 space-y-3">
                <div className="flex items-center justify-between flex-wrap gap-2">
                  <h3 className="font-bold text-sm font-mono uppercase tracking-widest">Backup Catalog</h3>
                  <div className="flex items-center gap-2">
                    {supervisor && (
                      <Badge
                        variant="outline"
                        className={`font-mono text-[10px] ${supervisor.can_auto_restart ? "text-emerald-500 border-emerald-500/40" : "text-amber-500 border-amber-500/40"}`}
                        title={
                          supervisor.kind === "launchd"
                            ? `launchd · ${supervisor.label || ""}\nplist: ${supervisor.plist || "n/a"}\nKeepAlive: ${supervisor.keep_alive === null ? "unknown" : supervisor.keep_alive ? "true" : "false"}`
                            : supervisor.hint || `${supervisor.kind} supervisor`
                        }
                      >
                        {supervisor.can_auto_restart ? "AUTO-RESTART" : "MANUAL RESTART"} · {supervisor.kind.toUpperCase()}
                      </Badge>
                    )}
                    <Badge variant="outline" className="font-mono text-[10px]">{backupFiles.length} files</Badge>
                  </div>
                </div>
                {supervisor && !supervisor.can_auto_restart && (
                  <p className="text-[10px] font-mono text-amber-500/90 border border-amber-500/30 bg-amber-500/5 rounded px-2 py-1">
                    ⚠ No supervisor detected. After a FULL restore the bridge will exit and will NOT respawn automatically. {supervisor.hint || "Run under launchd (KeepAlive=true), pm2, or systemd."}
                  </p>
                )}
                {backupFiles.length === 0 ? (
                  <p className="text-xs text-muted-foreground">No archives in BACKUP_DIR yet. Run an export above.</p>
                ) : (
                  <div className="overflow-x-auto">
                    <table className="w-full text-xs font-mono">
                      <thead className="text-left text-muted-foreground">
                        <tr className="py-1 pr-3">
                          <th className="py-1 pr-3">File</th>
                          <th className="py-1 pr-3">Size</th>
                          <th className="py-1 pr-3">Date</th>
                          <th className="py-1 pr-3">SHA256</th>
                          <th className="py-1 pr-3 text-right">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        {backupFiles.map((f) => (
                          <tr key={f.name} className="border-t border-border/40">
                            <td className="py-1 pr-3 truncate max-w-[420px]" title={f.name}>{f.name}</td>
                            <td className="py-1 pr-3">{(f.bytes / 1024 / 1024).toFixed(2)} MB</td>
                            <td className="py-1 pr-3">{new Date(f.mtime).toLocaleString()}</td>
                            <td className="py-1 pr-3 text-muted-foreground">{f.sha256 ? f.sha256.slice(0, 10) : "—"}</td>
                            <td className="py-1 pr-3 text-right space-x-1">
                              <a href={`${getApiBaseUrl()}/api/backup/file/${encodeURIComponent(f.name)}`} target="_blank" rel="noreferrer" className="inline-block">
                                <Button size="sm" variant="ghost" className="h-7 px-2"><Download className="h-3 w-3" /></Button>
                              </a>
                              <Button size="sm" variant="ghost" className="h-7 px-2" disabled={!!backupBusy} onClick={() => void restoreCatalogFile(f.name)} title={`Restore (${restoreMode.toUpperCase()})`}>
                                <RotateCcw className="h-3 w-3" />
                              </Button>
                              <Button size="sm" variant="ghost" className="h-7 px-2 text-destructive" disabled={!!backupBusy} onClick={() => void deleteCatalogFile(f.name)}>
                                <Trash2 className="h-3 w-3" />
                              </Button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                <p className="text-[10px] text-muted-foreground font-mono">
                  Files written under <code className="text-primary">{`{UPLOAD_DIR}/backups`}</code>. Each archive has a sibling <code className="text-primary">.sha256</code>. <code className="text-primary">_pre-restore-*.dump</code> entries are auto-snapshots taken right before any restore.
                </p>
              </CardContent>
            </Card>
            <SystemInfrastructureCard />
            <ServicesTowerCard />
          </div>
        </TabsContent>

        <TabsContent value="database"><DatabasePanel /></TabsContent>
        <TabsContent value="converter"><SkillConverter /></TabsContent>
      </Tabs>
    </PageShell>
  );
}

function FieldX({ label, v, on, type = "text" }: { label: string; v?: string; on: (x: string) => void; type?: string }) {
  return (
    <div>
      <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">{label}</Label>
      <Input value={v ?? ""} onChange={(e) => on(e.target.value)} type={type} className="font-mono text-xs mt-1 h-9" />
    </div>
  );
}

function Stat({ l, v }: { l: string; v: string }) {
  return (
    <div className="border border-border rounded p-3">
      <p className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">{l}</p>
      <p className="text-base font-bold text-primary font-mono mt-1">{v}</p>
    </div>
  );
}

function HardwareLive() {
  const { hardware } = useSystem();
  const [m, setM] = useState<MetricsFrame | null>(null);

  useEffect(() => {
    const stop = MetricsAPI.subscribe(setM);
    return stop;
  }, []);

  // Prefer live hardware reported by the bridge over any stored UI defaults.
  const hw = m?.hardware;
  const cpuCores  = hw?.cpuCores       ?? hardware.cpuCores;
  const perfCores = hw?.cpuPerformance ?? hardware.cpuPerformance;
  const effCores  = hw?.cpuEfficiency  ?? hardware.cpuEfficiency;
  const gpuCores  = hw?.gpuCores       ?? hardware.gpuCores;
  const totalRam  = hw?.totalRamGb     ?? hardware.totalRamGb;
  const model     = hw?.model          ?? "Apple Silicon";

  const cpuPct = m?.cpu ?? 0;
  const ramPct = m?.ram ?? 0;
  const gpuPct = m?.gpu ?? 0;
  const mlxPct = m?.mlx ?? 0;
  const ramUsedGb = m?.ramUsedGb ?? (totalRam * ramPct) / 100;
  const mlxUsedGb = m?.mlxUsedGb ?? (totalRam * mlxPct) / 100;

  return (
    <div className="space-y-4">
      <Card className="glass">
        <CardContent className="p-6">
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-bold text-sm font-mono uppercase tracking-widest flex items-center gap-2">
              <Cpu className="h-4 w-4 text-primary"/>{model}
            </h3>
            <Badge variant="outline" className="font-mono text-[10px]">
              <span className="pulse-dot mr-2"/>{m ? "LIVE · 2Hz" : "PROBING…"}
            </Badge>
          </div>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
            <SpecBox label="CPU Cores" value={`${cpuCores}`} sub={perfCores || effCores ? `${perfCores}P + ${effCores}E` : "physical cores"}/>
            <SpecBox label="GPU Cores" value={gpuCores ? `${gpuCores}` : "—"} sub="Apple GPU"/>
            <SpecBox label="Unified RAM" value={`${totalRam} GB`} sub="LPDDR5X"/>
            <SpecBox label="Neural Engine" value="16-core" sub="Accelerated"/>
          </div>
        </CardContent>
      </Card>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <Meter icon={<Cpu className="h-4 w-4 text-primary"/>}
          label="CPU Usage" pct={cpuPct}
          detail={`${(cpuPct/100*cpuCores).toFixed(1)} of ${cpuCores} cores active`}/>
        <Meter icon={<Activity className="h-4 w-4 text-primary"/>}
          label="GPU Usage" pct={gpuPct}
          detail={gpuPct > 0
            ? `${gpuPct.toFixed(1)}% of ${gpuCores || "?"}-core GPU`
            : `requires powermetrics root · ${gpuCores || "?"}-core GPU`}/>
        <Meter icon={<MemoryStick className="h-4 w-4 text-primary"/>}
          label="System RAM" pct={ramPct}
          detail={`${ramUsedGb.toFixed(1)} GB / ${totalRam} GB unified`}/>
        <Meter icon={<MemoryStick className="h-4 w-4 text-primary"/>}
          label="Local Runtime Memory" pct={mlxPct}
          detail={mlxPct > 0
            ? `${mlxUsedGb.toFixed(1)} GB resident across local runtime`
            : `no local runtime process detected`}/>
      </div>

      <Card className="glass">
        <CardContent className="p-6">
          <h3 className="font-bold text-sm font-mono uppercase tracking-widest mb-3">Live Workload</h3>
          <div className="grid grid-cols-3 gap-3">
            <SpecBox label="Tokens / sec" value={m ? `${m.tps}` : "—"} sub="all models"/>
            <SpecBox label="Queue Depth" value={m ? `${m.queue}` : "—"} sub="pending requests"/>
            <SpecBox label="Avg Latency" value={m ? `${m.latency} ms` : "—"} sub="end-to-end"/>
          </div>
          <p className="text-[10px] font-mono text-muted-foreground mt-3">
            Activity Monitor view · {model} · vm_stat + top + powermetrics from /api/metrics/stream.
          </p>
        </CardContent>
      </Card>
    </div>
  );
}

function SpecBox({ label, value, sub }: { label: string; value: string; sub?: string }) {
  return (
    <div className="border border-border rounded p-3 bg-card/40">
      <p className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">{label}</p>
      <p className="text-lg font-bold text-primary font-mono mt-1">{value}</p>
      {sub && <p className="text-[10px] text-muted-foreground font-mono mt-0.5">{sub}</p>}
    </div>
  );
}

function Meter({ icon, label, pct, detail }: { icon: React.ReactNode; label: string; pct: number; detail: string }) {
  return (
    <Card className="glass">
      <CardContent className="p-5">
        <div className="flex items-center justify-between mb-2">
          <div className="flex items-center gap-2">
            {icon}
            <span className="text-xs font-mono uppercase tracking-widest text-muted-foreground">{label}</span>
          </div>
          <span className="text-2xl font-bold text-primary font-mono">{pct.toFixed(1)}%</span>
        </div>
        <Progress value={pct} className="h-2"/>
        <p className="text-[11px] text-muted-foreground font-mono mt-2">{detail}</p>
      </CardContent>
    </Card>
  );
}


function ProvidersPanel() {
  const { t } = useI18n();
  const [list, setList] = useState<AiProviderDTO[]>([]);
  const [drafts, setDrafts] = useState<Record<string, Partial<AiProviderDTO>>>({});
  const [pinging, setPinging] = useState<string | null>(null);
  const empty: Partial<AiProviderDTO> = { providerName: "", kind: "llm", baseUrl: "", model: "", apiKey: "", isActive: true, priority: 100 };
  const [draft, setDraft] = useState<Partial<AiProviderDTO>>(empty);

  const refresh = async () => {
    const r = await ProvidersAPI.list().catch(()=>[] as AiProviderDTO[]);
    setList(r);
    setDrafts(Object.fromEntries(r.map(p => [p.id, { ...p, apiKey: "" }])));
  };
  useEffect(() => { refresh(); }, []);

  const addNew = async () => {
    if (!draft.providerName) { toast.error("Provider name required"); return; }
    try { await ProvidersAPI.save(draft); toast.success(t("common.save")); setDraft(empty); refresh(); }
    catch (e) { toast.error((e as Error).message); }
  };
  const saveRow = async (id: string) => {
    const d = drafts[id]; if (!d) return;
    const payload: Partial<AiProviderDTO> = { ...d };
    if (!d.apiKey) delete payload.apiKey;
    try { await ProvidersAPI.save(payload); toast.success(t("common.save")); refresh(); }
    catch (e) { toast.error((e as Error).message); }
  };
  const remove = async (id: string) => {
    if (!confirm("Delete provider?")) return;
    await ProvidersAPI.remove(id); toast.success(t("common.delete")); refresh();
  };
  const ping = async (id: string) => {
    setPinging(id);
    const r = await ProvidersAPI.ping(id);
    setPinging(null);
    if (r.ok) toast.success(`${t("debug.reachable")} · ${r.latencyMs}ms`);
    else toast.error(`${t("debug.unreachable")}: ${r.error || r.message || r.status}`);
  };
  const updDraft = (id: string, patch: Partial<AiProviderDTO>) =>
    setDrafts(prev => ({ ...prev, [id]: { ...prev[id], ...patch } }));

  const PRESETS: Array<Partial<AiProviderDTO> & { providerName: string }> = [
    { providerName: "Gemini",     kind: "llm",    baseUrl: "https://generativelanguage.googleapis.com", model: "gemini-2.0-flash", priority: 10 },
    { providerName: "OpenAI",     kind: "llm",    baseUrl: "https://api.openai.com/v1",                  model: "gpt-4o-mini",      priority: 20 },
    { providerName: "Anthropic",  kind: "llm",    baseUrl: "https://api.anthropic.com/v1",               model: "claude-3-5-sonnet-latest", priority: 30 },
    { providerName: "Mistral",    kind: "llm",    baseUrl: "https://api.mistral.ai/v1",                  model: "mistral-large-latest", priority: 40 },
    { providerName: "Groq",       kind: "llm",    baseUrl: "https://api.groq.com/openai/v1",             model: "llama-3.3-70b-versatile", priority: 50 },
    { providerName: "DeepSeek",   kind: "llm",    baseUrl: "https://api.deepseek.com/v1",                model: "deepseek-chat",    priority: 60 },
    { providerName: "Cohere",     kind: "llm",    baseUrl: "https://api.cohere.com/v1",                  model: "command-r-plus",   priority: 70 },
    { providerName: "Perplexity", kind: "llm",    baseUrl: "https://api.perplexity.ai",                  model: "sonar-pro",        priority: 80 },
    { providerName: "OpenRouter", kind: "llm",    baseUrl: "https://openrouter.ai/api/v1",               model: "openrouter/auto",  priority: 90 },
    { providerName: "Legacy HTTP (local)", kind: "llm", baseUrl: "http://localhost:11434/v1",                 model: "llama3.1",         priority: 95 },
    { providerName: "Tavily",     kind: "search", baseUrl: "https://api.tavily.com",                     model: "",                 priority: 10 },
    { providerName: "Serper",     kind: "search", baseUrl: "https://google.serper.dev",                  model: "",                 priority: 20 },
    { providerName: "Brave Search", kind: "search", baseUrl: "https://api.search.brave.com/res/v1",      model: "",                 priority: 30 },
    { providerName: "SerpAPI",    kind: "search", baseUrl: "https://serpapi.com",                        model: "",                 priority: 40 },
  ];

  return (
    <div className="space-y-3">
      <RoutingPolicyCard providers={list} />
      <Card className="glass">
        <CardContent className="p-5 space-y-3">
          <div className="flex items-center justify-between">
            <h3 className="font-bold text-sm font-mono uppercase tracking-widest flex items-center gap-2">
              <Sparkles className="h-4 w-4 text-primary" /> {t("set.add_provider")}
            </h3>
            <Badge variant="outline" className="font-mono text-[10px]">{list.length} sealed · unlimited</Badge>
          </div>
          <div>
            <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">
              {t("set.presets_hint")}
            </Label>
            <div className="flex flex-wrap gap-1.5 mt-2">
              {PRESETS.map((p) => {
                const already = list.some(x => x.providerName.toLowerCase() === p.providerName.toLowerCase());
                return (
                  <Button
                    key={p.providerName}
                    size="sm" variant={already ? "secondary" : "outline"}
                    disabled={already}
                    className="h-7 text-[11px] font-mono"
                    onClick={async () => {
                      try {
                        await ProvidersAPI.save({ ...empty, ...p, isActive: true });
                        toast.success(`${p.providerName} added — set API key in the row below`);
                        refresh();
                      } catch (e) { toast.error((e as Error).message); }
                    }}
                  >
                    <Plus className="h-3 w-3 mr-1" />{p.providerName}
                    <span className="ml-1 text-muted-foreground">· {p.kind}</span>
                    {already && <span className="ml-1 text-primary">✓</span>}
                  </Button>
                );
              })}
              <Button size="sm" variant="ghost" className="h-7 text-[11px] font-mono" onClick={() => setDraft(empty)}>
                Clear form
              </Button>
            </div>
            <p className="text-[10px] text-muted-foreground font-mono mt-2">
              {t("set.custom_form_hint")}
            </p>
          </div>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
            <div><Label>Provider Name</Label><Input value={draft.providerName ?? ""} onChange={(e)=>setDraft({...draft, providerName:e.target.value})} placeholder="Gemini · Tavily · OpenAI · Serper" className="mt-1 font-mono"/></div>
            <div><Label>Kind</Label>
              <Select value={draft.kind ?? "llm"} onValueChange={(v)=>setDraft({...draft, kind: v as "llm"|"search"})}>
                <SelectTrigger className="mt-1"><SelectValue/></SelectTrigger>
                <SelectContent><SelectItem value="llm">LLM</SelectItem><SelectItem value="search">Search</SelectItem></SelectContent>
              </Select>
            </div>
            <div><Label>Priority</Label><Input type="number" value={String(draft.priority ?? 100)} onChange={(e)=>setDraft({...draft, priority:+e.target.value})} className="mt-1 font-mono"/></div>
            <div><Label>Base URL (optional)</Label><Input value={draft.baseUrl ?? ""} onChange={(e)=>setDraft({...draft, baseUrl:e.target.value})} className="mt-1 font-mono"/></div>
            <div><Label>Model (optional)</Label><Input value={draft.model ?? ""} onChange={(e)=>setDraft({...draft, model:e.target.value})} placeholder="gemini-2.0-flash" className="mt-1 font-mono"/></div>
            <div><Label>API Key</Label><Input type="password" value={draft.apiKey ?? ""} onChange={(e)=>setDraft({...draft, apiKey:e.target.value})} className="mt-1 font-mono"/></div>
          </div>
          <div className="flex items-center gap-3">
            <Switch checked={!!draft.isActive} onCheckedChange={(v)=>setDraft({...draft, isActive:v})}/>
            <Label className="text-xs">Active</Label>
            <Button className="ml-auto bg-gradient-primary text-primary-foreground" onClick={addNew}>
              <Plus className="h-4 w-4 mr-1"/>{t("set.seal_provider")}
            </Button>
          </div>
        </CardContent>
      </Card>

      <div className="space-y-2">
        {list.length === 0 && <p className="text-xs text-muted-foreground font-mono px-2">{t("set.no_providers")}</p>}
        {list.map(p => {
          const d = drafts[p.id] ?? p;
          return (
            <Card key={p.id} className="glass">
              <CardContent className="p-4 grid grid-cols-1 md:grid-cols-[1.4fr_70px_1fr_1.2fr_90px_140px_90px] gap-2 items-center">
                <Input value={d.providerName ?? ""} onChange={(e)=>updDraft(p.id,{providerName:e.target.value})} className="font-mono text-xs h-9"/>
                <Badge variant="outline" className="font-mono uppercase justify-center">{p.kind}</Badge>
                <Input value={d.model ?? ""} onChange={(e)=>updDraft(p.id,{model:e.target.value})} placeholder="model" className="font-mono text-xs h-9"/>
                <Input type="password" value={d.apiKey ?? ""} placeholder={p.hasKey ? "•••• (rotate)" : "set api key"} onChange={(e)=>updDraft(p.id,{apiKey:e.target.value})} className="font-mono text-xs h-9"/>
                <div className="flex items-center gap-2"><Switch checked={!!d.isActive} onCheckedChange={(v)=>updDraft(p.id,{isActive:v})}/><span className="text-[10px] font-mono">{d.isActive?"ON":"OFF"}</span></div>
                <div className="flex gap-1">
                  <Button size="sm" className="h-9 bg-gradient-primary text-primary-foreground" onClick={()=>saveRow(p.id)}>
                    <Save className="h-3.5 w-3.5 mr-1"/>{t("common.save")}
                  </Button>
                  <Button size="sm" variant="outline" className="h-9" disabled={pinging===p.id} onClick={()=>ping(p.id)}>
                    <Plug className="h-3.5 w-3.5"/>
                  </Button>
                </div>
                <Button size="icon" variant="ghost" className="h-9 w-9 text-destructive justify-self-end" onClick={()=>remove(p.id)}><Trash2 className="h-3.5 w-3.5"/></Button>
              </CardContent>
            </Card>
          );
        })}
      </div>
    </div>
  );
}

function RoutingPolicyCard({ providers }: { providers: AiProviderDTO[] }) {
  const { t } = useI18n();
  const [pol, setPol] = useState<AiRoutingPolicy>({ mode: "failover", allowUserOverride: true, rules: [] });
  const [loaded, setLoaded] = useState(false);
  useEffect(() => {
    AppSettingsAPI.get<AiRoutingPolicy>("ai.routing").then((v) => {
      if (v) setPol({ mode: v.mode || "failover", allowUserOverride: v.allowUserOverride !== false, rules: Array.isArray(v.rules) ? v.rules : [] });
      setLoaded(true);
    });
  }, []);
  const save = async (next: AiRoutingPolicy) => {
    setPol(next);
    try { await AppSettingsAPI.set("ai.routing", next); toast.success("Routing policy sealed"); }
    catch (e) { toast.error((e as Error).message); }
  };
  const llms = providers.filter(p => p.kind === "llm");
  return (
    <Card className="glass">
      <CardContent className="p-5 space-y-3">
        <div className="flex items-center justify-between">
          <h3 className="font-bold text-sm font-mono uppercase tracking-widest flex items-center gap-2">
            <Cpu className="h-4 w-4 text-primary" /> Multi-Provider Routing
          </h3>
          <Badge variant="outline" className="font-mono text-[10px]">{llms.length} LLM · {llms.filter(p=>p.isActive).length} active</Badge>
        </div>
        <p className="text-[11px] text-muted-foreground font-mono">
          {t("set.routing_hint")}
        </p>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
          <div>
            <Label>Default mode</Label>
            <Select value={pol.mode} onValueChange={(v) => save({ ...pol, mode: v as AiRoutingPolicy["mode"] })}>
              <SelectTrigger className="mt-1"><SelectValue/></SelectTrigger>
              <SelectContent>
                <SelectItem value="failover">Failover (priority order, fall through on error)</SelectItem>
                <SelectItem value="router">Smart router (regex rules → provider)</SelectItem>
                <SelectItem value="manual">Manual only (user picks every time)</SelectItem>
              </SelectContent>
            </Select>
          </div>
          <div className="flex items-end gap-3">
            <div className="flex items-center gap-2">
              <Switch checked={pol.allowUserOverride !== false} onCheckedChange={(v) => save({ ...pol, allowUserOverride: v })}/>
              <Label className="text-xs">Allow user override (chat dropdown)</Label>
            </div>
          </div>
        </div>
        {pol.mode === "router" && (
          <div className="space-y-2 pt-2 border-t border-border">
            <div className="flex items-center justify-between">
              <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">Router rules</Label>
              <Button size="sm" variant="outline" onClick={() => save({ ...pol, rules: [...pol.rules, { match: "", providerId: llms[0]?.id ?? "", note: "" }] })}>
                <Plus className="h-3 w-3 mr-1"/>Add rule
              </Button>
            </div>
            {pol.rules.length === 0 && <p className="text-[11px] text-muted-foreground font-mono">No rules yet. Example: <code>kod|code|python</code> → Claude, <code>arama|search|news</code> → Gemini.</p>}
            {pol.rules.map((r, i) => (
              <div key={i} className="grid grid-cols-[1.4fr_1fr_1fr_40px] gap-2 items-center">
                <Input value={r.match} placeholder="regex (kod|code|python)"
                  onChange={(e) => save({ ...pol, rules: pol.rules.map((x,j)=> j===i?{...x, match:e.target.value}:x) })}
                  className="font-mono text-xs h-9"/>
                <Select value={r.providerId} onValueChange={(v) => save({ ...pol, rules: pol.rules.map((x,j)=> j===i?{...x, providerId:v}:x) })}>
                  <SelectTrigger className="h-9"><SelectValue placeholder="provider"/></SelectTrigger>
                  <SelectContent>{llms.map(p => <SelectItem key={p.id} value={p.id}>{p.providerName}</SelectItem>)}</SelectContent>
                </Select>
                <Input value={r.note ?? ""} placeholder="note"
                  onChange={(e) => save({ ...pol, rules: pol.rules.map((x,j)=> j===i?{...x, note:e.target.value}:x) })}
                  className="font-mono text-xs h-9"/>
                <Button size="icon" variant="ghost" className="h-9 w-9 text-destructive"
                  onClick={() => save({ ...pol, rules: pol.rules.filter((_,j)=> j!==i) })}>
                  <Trash2 className="h-3.5 w-3.5"/>
                </Button>
              </div>
            ))}
          </div>
        )}
        {!loaded && <p className="text-[10px] text-muted-foreground font-mono">loading…</p>}
      </CardContent>
    </Card>
  );
}

// AgentFactoryPanel removed — Agents are now managed exclusively in the Agents tab.

// ---------------- Branding (with logo upload + Save) ----------------
function BrandingPanel() {
  const { t } = useI18n();
  const { brand, setBrand } = useAuth();
  const [draft, setDraft] = useState(brand);
  const fileRef = useRef<HTMLInputElement>(null);
  useEffect(() => { setDraft(brand); }, [brand]);

  const onUpload = async (file: File) => {
    if (!file.type.startsWith("image/")) { toast.error("Image files only"); return; }
    if (file.size > 2 * 1024 * 1024) { toast.error("Logo must be ≤ 2 MB"); return; }
    // Downscale to max 256x256 → dataURL (auto-sized for topbar/login/sidebar)
    const dataUrl: string = await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          const max = 256;
          const scale = Math.min(1, max / Math.max(img.width, img.height));
          const w = Math.round(img.width * scale), h = Math.round(img.height * scale);
          const canvas = document.createElement("canvas");
          canvas.width = w; canvas.height = h;
          const ctx = canvas.getContext("2d");
          if (!ctx) return reject(new Error("canvas unavailable"));
          ctx.drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL(file.type === "image/svg+xml" ? "image/png" : file.type, 0.92));
        };
        img.onerror = () => reject(new Error("invalid image"));
        img.src = String(reader.result || "");
      };
      reader.onerror = () => reject(new Error("read error"));
      reader.readAsDataURL(file);
    });
    setDraft(d => ({ ...d, logoUrl: dataUrl }));
  };

  const save = () => { setBrand(draft); toast.success(t("set.save_branding")); };
  const reset = () => setDraft(brand);

  return (
    <Card className="glass">
      <CardContent className="p-6 space-y-4">
        <h3 className="font-bold text-sm font-mono uppercase tracking-widest">{t("set.branding")} · login + topbar</h3>
        <div>
          <Label>{t("set.app_name")}</Label>
          <Input value={draft.name} onChange={(e) => setDraft({ ...draft, name: e.target.value })} className="mt-2" />
        </div>
        <div>
          <Label>{t("set.tagline")}</Label>
          <Input value={draft.tagline} onChange={(e) => setDraft({ ...draft, tagline: e.target.value })} className="mt-2" />
        </div>
        <div>
          <Label>{t("set.logo_url")}</Label>
          <div className="flex gap-2 mt-2">
            <Input value={draft.logoUrl} onChange={(e) => setDraft({ ...draft, logoUrl: e.target.value })} placeholder="https://… (PNG / SVG) — or upload" className="font-mono" />
            <Button variant="outline" onClick={()=>fileRef.current?.click()}>
              <ImagePlus className="h-4 w-4 mr-1"/>{t("set.upload_logo")}
            </Button>
            <input ref={fileRef} type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" className="hidden"
              onChange={(e)=>{ const f = e.target.files?.[0]; if (f) onUpload(f); e.target.value = ""; }} />
          </div>
          {draft.logoUrl && (
            <div className="flex items-end gap-4 mt-3 p-3 rounded border border-border bg-card/40">
              <div><p className="text-[10px] font-mono text-muted-foreground mb-1">Topbar 24px</p><img src={draft.logoUrl} alt="logo" className="h-6 object-contain"/></div>
              <div><p className="text-[10px] font-mono text-muted-foreground mb-1">Sidebar 40px</p><img src={draft.logoUrl} alt="logo" className="h-10 object-contain"/></div>
              <div><p className="text-[10px] font-mono text-muted-foreground mb-1">Login 56px</p><img src={draft.logoUrl} alt="logo" className="h-14 object-contain"/></div>
            </div>
          )}
        </div>
        <div className="grid grid-cols-2 gap-3">
          <div><Label>NTP Server 1</Label><Input defaultValue="time.apple.com" className="mt-2 font-mono" /></div>
          <div><Label>NTP Server 2</Label><Input defaultValue="pool.ntp.org" className="mt-2 font-mono" /></div>
        </div>
        <div className="flex gap-2 pt-2 border-t border-border">
          <Button className="bg-gradient-primary text-primary-foreground" onClick={save}>
            <Save className="h-4 w-4 mr-1"/>{t("set.save_branding")}
          </Button>
          <Button variant="outline" onClick={reset}>{t("common.cancel")}</Button>
        </div>
      </CardContent>
    </Card>
  );
}

// ---------------- Provider Token Usage ----------------
function UsagePanel() {
  const { t } = useI18n();
  const [data, setData] = useState<ProviderUsageResponse | null>(null);
  const [loading, setLoading] = useState(false);
  const refresh = async () => {
    setLoading(true);
    try { setData(await ProvidersAPI.usage(24, "hour")); } finally { setLoading(false); }
  };
  useEffect(() => { refresh(); const id = setInterval(refresh, 15000); return () => clearInterval(id); }, []);
  const totals = data?.totals ?? [];
  const totalTokens = totals.reduce((s,r)=>s + r.total_tokens, 0);
  const totalCalls  = totals.reduce((s,r)=>s + r.calls, 0);
  return (
    <div className="space-y-4">
      <Card className="glass">
        <CardContent className="p-5">
          <div className="flex items-center justify-between mb-3">
            <h3 className="font-bold text-sm font-mono uppercase tracking-widest flex items-center gap-2">
              <BarChart3 className="h-4 w-4 text-primary"/>{t("usage.title")}
            </h3>
            <Badge variant="outline" className="font-mono text-[10px]">{t("usage.window24")}</Badge>
          </div>
          <p className="text-xs text-muted-foreground mb-4">{t("usage.subtitle")}</p>
          <div className="grid grid-cols-3 gap-3 mb-4">
            <Stat l={t("usage.tokens")} v={totalTokens.toLocaleString()}/>
            <Stat l={t("usage.calls")} v={String(totalCalls)}/>
            <Stat l="Providers" v={String(totals.length)}/>
          </div>
          {totals.length === 0 ? (
            <p className="text-xs text-muted-foreground font-mono p-4 text-center">
              {loading ? "…" : t("usage.no_data")}
            </p>
          ) : (
            <div className="border border-border rounded overflow-hidden">
              <div className="grid grid-cols-[1.4fr_70px_1fr_1fr_1fr_90px] gap-2 px-3 py-2 bg-muted/30 text-[10px] font-mono uppercase tracking-widest text-muted-foreground">
                <span>Provider</span><span>Kind</span><span>Prompt</span><span>Response</span><span>Total</span><span>Calls</span>
              </div>
              {totals.map((r,i)=>(
                <div key={i} className="grid grid-cols-[1.4fr_70px_1fr_1fr_1fr_90px] gap-2 px-3 py-2 border-t border-border text-[11px] font-mono">
                  <span className="text-primary">{r.providerName}</span>
                  <Badge variant="outline" className="text-[9px] w-fit uppercase">{r.kind}</Badge>
                  <span>{r.prompt_tokens.toLocaleString()}</span>
                  <span>{r.response_tokens.toLocaleString()}</span>
                  <span className="font-bold">{r.total_tokens.toLocaleString()}</span>
                  <span>{r.calls}</span>
                </div>
              ))}
            </div>
          )}
        </CardContent>
      </Card>
    </div>
  );
}

// ---------------- Vision & Audio (Voice profiles per language) ----------------
function VoiceAudioPanel() {
  const { profiles, voices, save, remove, refresh, speak, playbackRate, setPlaybackRate } = useVoice();
  const empty: Partial<VoiceProfileDTO> = { lang: "en", label: "", engine: "local", voiceUri: "", rate: 1, pitch: 1, premiumProvider: "", isDefault: false };
  const [draft, setDraft] = useState<Partial<VoiceProfileDTO>>(empty);
  const [previewing, setPreviewing] = useState(false);
  useEffect(() => { void refresh(); }, [refresh]);

  const langVoices = voices.filter(v => v.lang.toLowerCase().startsWith((draft.lang || "en")));

  const addNew = async () => {
    if (!draft.label) { toast.error("Label required"); return; }
    try { await save(draft); toast.success("Voice profile sealed"); setDraft(empty); }
    catch (e) { toast.error((e as Error).message); }
  };
  const previewDraft = async () => {
    const sample = draft.lang === "tr" ? "Merhaba, sistem hazır." : "Hello, system ready.";
    if (typeof window === "undefined" || !window.speechSynthesis) { toast.error("Browser TTS unavailable"); return; }
    setPreviewing(true);
    try {
      const u = new SpeechSynthesisUtterance(sample);
      u.lang = draft.lang === "tr" ? "tr-TR" : "en-US";
      u.rate = (draft.rate ?? 1) * playbackRate;
      u.pitch = draft.pitch ?? 1;
      if (draft.voiceUri && draft.voiceUri !== "default") {
        const v = voices.find(x => x.voiceURI === draft.voiceUri || x.name === draft.voiceUri);
        if (v) u.voice = v;
      }
      u.onend = () => setPreviewing(false);
      u.onerror = () => { setPreviewing(false); toast.error("Voice preview failed"); };
      window.speechSynthesis.cancel();
      window.speechSynthesis.resume();
      window.speechSynthesis.speak(u);
      setTimeout(() => setPreviewing(false), 5000);
    } catch (e) { setPreviewing(false); toast.error((e as Error).message); }
  };

  return (
    <div className="space-y-3">
      <Card className="glass">
        <CardContent className="p-5 space-y-3">
          <h3 className="font-bold text-sm font-mono uppercase tracking-widest flex items-center gap-2">
            <Sparkles className="h-4 w-4 text-primary"/>Add Voice Profile (TR · EN)
          </h3>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
            <div><Label>Language</Label>
              <Select value={draft.lang ?? "en"} onValueChange={(v)=>setDraft({...draft, lang: v})}>
                <SelectTrigger className="mt-1"><SelectValue/></SelectTrigger>
                <SelectContent>
                  <SelectItem value="tr">Türkçe (tr)</SelectItem>
                  <SelectItem value="en">English (en)</SelectItem>
                </SelectContent>
              </Select>
            </div>
            <div><Label>Label</Label><Input value={draft.label ?? ""} onChange={(e)=>setDraft({...draft, label:e.target.value})} placeholder="TR · Yelda · warm" className="mt-1 font-mono"/></div>
            <div><Label>Engine</Label>
              <Select value={draft.engine ?? "local"} onValueChange={(v)=>setDraft({...draft, engine: v as "local"|"premium"})}>
                <SelectTrigger className="mt-1"><SelectValue/></SelectTrigger>
                <SelectContent>
                  <SelectItem value="local">Local (browser TTS)</SelectItem>
                  <SelectItem value="premium">Premium (DeepDive · Cloud TTS)</SelectItem>
                </SelectContent>
              </Select>
            </div>
            <div><Label>Voice</Label>
              <Select value={draft.voiceUri ?? ""} onValueChange={(v)=>setDraft({...draft, voiceUri: v})}>
                <SelectTrigger className="mt-1"><SelectValue placeholder="Pick voice"/></SelectTrigger>
                <SelectContent>
                  {langVoices.length === 0 && <SelectItem value="default">System default</SelectItem>}
                  {langVoices.map(v => <SelectItem key={v.voiceURI} value={v.voiceURI}>{v.name} · {v.lang}</SelectItem>)}
                </SelectContent>
              </Select>
            </div>
            <div><Label>Rate · {(draft.rate ?? 1).toFixed(2)}x</Label>
              <input type="range" min={0.5} max={2} step={0.05} value={draft.rate ?? 1}
                onChange={(e)=>setDraft({...draft, rate: +e.target.value})} className="w-full mt-3"/>
            </div>
            <div><Label>Pitch · {(draft.pitch ?? 1).toFixed(2)}</Label>
              <input type="range" min={0.5} max={2} step={0.05} value={draft.pitch ?? 1}
                onChange={(e)=>setDraft({...draft, pitch: +e.target.value})} className="w-full mt-3"/>
            </div>
            {draft.engine === "premium" && (
              <div><Label>Premium Provider</Label>
                <Select value={draft.premiumProvider ?? ""} onValueChange={(v)=>setDraft({...draft, premiumProvider: v})}>
                  <SelectTrigger className="mt-1"><SelectValue placeholder="OpenAI / GCloud"/></SelectTrigger>
                  <SelectContent>
                    <SelectItem value="openai">OpenAI TTS</SelectItem>
                    <SelectItem value="gcloud">Google Cloud TTS</SelectItem>
                    <SelectItem value="elevenlabs">ElevenLabs</SelectItem>
                  </SelectContent>
                </Select>
              </div>
            )}
          </div>
          <div className="flex items-center gap-3 pt-2 border-t border-border">
            <Switch checked={!!draft.isDefault} onCheckedChange={(v)=>setDraft({...draft, isDefault:v})}/>
            <Label className="text-xs">Default for this language (auto-switch)</Label>
            <Button variant="outline" size="sm" className="ml-auto"
              onClick={previewDraft}><Plug className="h-3.5 w-3.5 mr-1"/>{previewing ? "Playing…" : "Preview"}</Button>
            <Button className="bg-gradient-primary text-primary-foreground" onClick={addNew}>
              <Plus className="h-4 w-4 mr-1"/>Seal Profile
            </Button>
          </div>
        </CardContent>
      </Card>

      <Card className="glass">
        <CardContent className="p-5 space-y-2">
          <div className="flex items-center justify-between">
            <h3 className="font-bold text-sm font-mono uppercase tracking-widest">Global Playback Speed</h3>
            <div className="flex items-center gap-2">
              {[0.8, 1.0, 1.25, 1.5].map(r => (
                <button key={r} onClick={()=>setPlaybackRate(r)}
                  className={`text-xs font-mono px-2 py-1 rounded border ${playbackRate===r?"border-primary text-primary":"border-border text-muted-foreground"}`}>
                  {r}x
                </button>
              ))}
            </div>
          </div>
        </CardContent>
      </Card>

      <div className="space-y-2">
        {profiles.length === 0 && <p className="text-xs text-muted-foreground font-mono px-2">No voice profiles yet. Add one above for TR / EN.</p>}
        {profiles.map(p => (
          <Card key={p.id} className="glass">
            <CardContent className="p-3 grid grid-cols-1 md:grid-cols-[60px_1.4fr_1fr_80px_80px_90px_120px_50px] gap-2 items-center">
              <Badge variant="outline" className="font-mono uppercase justify-center">{p.lang}</Badge>
              <span className="text-xs font-mono">{p.label}</span>
              <span className="text-[11px] font-mono text-muted-foreground truncate">{p.voiceUri || "—"}</span>
              <span className="text-[10px] font-mono">r:{p.rate.toFixed(2)}</span>
              <span className="text-[10px] font-mono">p:{p.pitch.toFixed(2)}</span>
              <Badge variant="outline" className="text-[9px]">{p.engine}{p.isDefault?" · DEFAULT":""}</Badge>
              <Button size="sm" variant="outline" className="h-8" onClick={()=>speak(p.lang === "tr" ? "Merhaba" : "Hello", p.lang)}>
                <Plug className="h-3.5 w-3.5 mr-1"/>Test
              </Button>
              <Button size="icon" variant="ghost" className="h-8 w-8 text-destructive" onClick={()=>{ if (confirm("Delete profile?")) remove(p.id); }}>
                <Trash2 className="h-3.5 w-3.5"/>
              </Button>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  );
}

type ServiceState = "running" | "stopped" | "restarting";
interface ServiceDef { key: string; name: string; kind: "http" | "postgres"; url?: string }
interface ServiceStatus { key: string; name: string; state: ServiceState; latency: number; detail?: string }

const SERVICES_KEY = "settings.services.registry.v1";
const DEFAULT_SERVICES: ServiceDef[] = [
  { key: "legacy", name: "Legacy HTTP", kind: "http", url: "http://127.0.0.1:11434/api/tags" },
  { key: "mlx", name: "MLX Runtime", kind: "http", url: "http://127.0.0.1:8080/v1/models" },
  { key: "node", name: "Node API (:3005)", kind: "http", url: "http://127.0.0.1:3005/api/health" },
  { key: "postgres", name: "PostgreSQL", kind: "postgres" },
];
// Faz 20 — Services Tower registry persisted server-side via AppSettingsAPI
// (key: settings.services.registry.v1) so operators share the same monitored set
// regardless of which browser they use. The previous localStorage path is kept
// as a one-time fallback during hydration so existing operators don't lose state.
function loadServicesLocal(): ServiceDef[] {
  try {
    const raw = localStorage.getItem(SERVICES_KEY);
    if (!raw) return DEFAULT_SERVICES;
    const arr = JSON.parse(raw);
    return Array.isArray(arr) && arr.length ? arr : DEFAULT_SERVICES;
  } catch { return DEFAULT_SERVICES; }
}
async function loadServicesRemote(): Promise<ServiceDef[]> {
  const remote = await AppSettingsAPI.get<ServiceDef[]>(SERVICES_KEY);
  if (Array.isArray(remote) && remote.length) return remote;
  // Migrate from legacy localStorage if remote is empty.
  const local = loadServicesLocal();
  if (local !== DEFAULT_SERVICES) {
    void AppSettingsAPI.set(SERVICES_KEY, local).catch(() => {});
  }
  return local;
}
async function saveServicesRemote(s: ServiceDef[]) {
  try { localStorage.setItem(SERVICES_KEY, JSON.stringify(s)); } catch { /* ignore */ }
  await AppSettingsAPI.set(SERVICES_KEY, s).catch(() => {});
}

function ServicesTowerCard() {
  const { t } = useI18n();
  // Hydrate from backend; legacy localStorage is used as a one-time migration source.
  const [services, setServices] = useState<ServiceDef[]>(() => loadServicesLocal());
  useEffect(() => {
    let cancelled = false;
    void loadServicesRemote().then((next) => { if (!cancelled) setServices(next); });
    return () => { cancelled = true; };
  }, []);
  const [statuses, setStatuses] = useState<Record<string, ServiceStatus>>({});
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState<string | null>(null);
  const [editing, setEditing] = useState<ServiceDef | null>(null);
  const [adding, setAdding] = useState(false);
  const [draft, setDraft] = useState<ServiceDef>({ key: "", name: "", kind: "http", url: "" });

  const refresh = async (list: ServiceDef[] = services) => {
    if (!list.length) { setStatuses({}); setLoading(false); return; }
    try {
      const r = await SystemAPI.servicesProbe(list.map(s => ({ key: s.key, name: s.name, url: s.url, kind: s.kind })));
      const map: Record<string, ServiceStatus> = {};
      for (const s of r.services) map[s.key] = s;
      setStatuses(map);
      setError(null);
    } catch (e) {
      setError((e as Error).message || "bridge offline");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    refresh(services);
    const id = setInterval(() => refresh(services), 30_000);
    return () => clearInterval(id);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [services]);

  const persist = (next: ServiceDef[]) => {
    setServices(next);
    void saveServicesRemote(next);
  };

  const act = async (key: string, action: "start" | "stop" | "restart") => {
    setBusy(`${key}:${action}`);
    try {
      const r = await SystemAPI.serviceAction(key, action);
      toast.success(`${key} · ${action} · ${r.message}`);
      setStatuses((prev) => ({ ...prev, [key]: { ...(prev[key] || { key, name: key, latency: 0 }), state: action === "stop" ? "stopped" : action === "restart" ? "restarting" : (prev[key]?.state ?? "stopped") } }));
      setTimeout(() => refresh(services), 2000);
    } catch (e) {
      toast.error(`${key} ${action} failed · ${(e as Error).message}`);
    } finally { setBusy(null); }
  };

  const startAdd = () => {
    setDraft({ key: "", name: "", kind: "http", url: "" });
    setEditing(null);
    setAdding(true);
  };
  const startEdit = (s: ServiceDef) => {
    setDraft({ ...s });
    setEditing(s);
    setAdding(false);
  };
  const cancelDraft = () => { setAdding(false); setEditing(null); };

  const saveDraft = () => {
    const key = draft.key.trim().toLowerCase().replace(/\s+/g, "-");
    const name = draft.name.trim();
    if (!key || !name) { toast.error(t("set.key_required")); return; }
    if (draft.kind === "http" && !draft.url?.trim()) { toast.error(t("set.url_required")); return; }
    if (adding && services.some(s => s.key === key)) { toast.error(t("set.key_exists").replace("{0}", key)); return; }
    const newDef: ServiceDef = { key, name, kind: draft.kind, url: draft.kind === "http" ? draft.url?.trim() : undefined };
    const next = editing
      ? services.map(s => s.key === editing.key ? newDef : s)
      : [...services, newDef];
    persist(next);
    cancelDraft();
    toast.success(`Service "${name}" ${editing ? "updated" : "added"}`);
  };

  const removeService = (s: ServiceDef) => {
    if (!window.confirm(t("set.confirm_remove_service").replace("{0}", s.name))) return;
    persist(services.filter(x => x.key !== s.key));
    toast.success(`"${s.name}" removed`);
  };

  const ledColor = (s: ServiceState) =>
    s === "running" ? "#22c55e" : s === "restarting" ? "#f59e0b" : "#ef4444";
  const ledLabel = (s: ServiceState) =>
    s === "running" ? "ONLINE" : s === "restarting" ? "RESTART" : "OFFLINE";

  return (
    <Card className="glass">
      <CardContent className="p-6">
        <div className="flex items-center justify-between mb-3 gap-2">
          <h3 className="font-bold text-sm font-mono uppercase tracking-widest">Background Services Tower</h3>
          <div className="flex items-center gap-2 text-[10px] font-mono text-muted-foreground">
            <span>auto-refresh 30s</span>
            <Button size="sm" variant="ghost" className="h-7 text-[10px]" onClick={() => refresh(services)}>
              <RotateCcw className="h-3 w-3 mr-1" /> Refresh
            </Button>
            <Button size="sm" className="h-7 text-[10px] bg-gradient-primary text-primary-foreground" onClick={startAdd}>
              <Plus className="h-3 w-3 mr-1" /> Add
            </Button>
          </div>
        </div>
        {loading && <p className="text-xs text-muted-foreground font-mono">Probing services …</p>}
        {error && <p className="text-xs text-destructive font-mono mb-2">Bridge: {error}</p>}

        {(adding || editing) && (
          <div className="border border-primary/40 rounded p-3 mb-3 bg-card/40 space-y-2">
            <p className="text-[10px] font-mono uppercase tracking-widest text-primary">
              {editing ? `Edit · ${editing.name}` : "New Service"}
            </p>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
              <div>
                <Label className="text-[10px] font-mono">Key (unique)</Label>
                <Input value={draft.key} disabled={!!editing} onChange={e => setDraft({ ...draft, key: e.target.value })} className="font-mono mt-1 h-8" placeholder="my-service" />
              </div>
              <div>
                <Label className="text-[10px] font-mono">Name</Label>
                <Input value={draft.name} onChange={e => setDraft({ ...draft, name: e.target.value })} className="font-mono mt-1 h-8" placeholder="My Service" />
              </div>
              <div>
                <Label className="text-[10px] font-mono">Kind</Label>
                <Select value={draft.kind} onValueChange={(v) => setDraft({ ...draft, kind: v as "http" | "postgres" })}>
                  <SelectTrigger className="h-8 mt-1 font-mono"><SelectValue /></SelectTrigger>
                  <SelectContent>
                    <SelectItem value="http">HTTP probe</SelectItem>
                    <SelectItem value="postgres">PostgreSQL pool</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              {draft.kind === "http" && (
                <div>
                  <Label className="text-[10px] font-mono">Probe URL</Label>
                  <Input value={draft.url ?? ""} onChange={e => setDraft({ ...draft, url: e.target.value })} className="font-mono mt-1 h-8" placeholder="http://127.0.0.1:8080/health" />
                </div>
              )}
            </div>
            <div className="flex gap-2 justify-end">
              <Button size="sm" variant="ghost" className="h-7 text-[10px]" onClick={cancelDraft}>Cancel</Button>
              <Button size="sm" className="h-7 text-[10px] bg-gradient-primary text-primary-foreground" onClick={saveDraft}>
                <Save className="h-3 w-3 mr-1" /> {editing ? "Save" : "Add"}
              </Button>
            </div>
          </div>
        )}

        <div className="space-y-2">
          {services.length === 0 && (
            <p className="text-xs text-muted-foreground font-mono">No services defined. Use Add to register one.</p>
          )}
          {services.map((s) => {
            const st = statuses[s.key]?.state ?? "stopped";
            const latency = statuses[s.key]?.latency ?? 0;
            const detail = statuses[s.key]?.detail ?? (s.url || s.kind);
            return (
              <div key={s.key} className="border border-border rounded p-3 flex items-center justify-between gap-3">
                <div className="flex items-center gap-3 min-w-0">
                  <span
                    className="inline-block h-2.5 w-2.5 rounded-full shrink-0"
                    style={{
                      background: ledColor(st),
                      boxShadow: `0 0 8px ${ledColor(st)}, 0 0 2px ${ledColor(st)}`,
                      animation: st === "restarting" ? "pulse 1s ease-in-out infinite" : undefined,
                    }}
                    title={ledLabel(st)}
                  />
                  <Server className="h-4 w-4 text-primary shrink-0" />
                  <div className="min-w-0">
                    <span className="text-sm font-mono">{s.name}</span>
                    <p className="text-[10px] font-mono text-muted-foreground truncate">
                      {ledLabel(st)}{latency ? ` · ${latency}ms` : ""} · {detail}
                    </p>
                  </div>
                </div>
                <div className="flex gap-1 shrink-0">
                  <Button size="sm" variant="ghost" disabled={busy === `${s.key}:start`} className="h-7 text-[10px]" onClick={() => act(s.key, "start")}>Start</Button>
                  <Button size="sm" variant="ghost" disabled={busy === `${s.key}:stop`} className="h-7 text-[10px]" onClick={() => act(s.key, "stop")}>Stop</Button>
                  <Button size="sm" variant="ghost" disabled={busy === `${s.key}:restart`} className="h-7 text-[10px]" onClick={() => act(s.key, "restart")}>Restart</Button>
                  <Button size="icon" variant="ghost" className="h-7 w-7" title="Edit" onClick={() => startEdit(s)}>
                    <Plug className="h-3.5 w-3.5" />
                  </Button>
                  <Button size="icon" variant="ghost" className="h-7 w-7 text-destructive" title="Remove" onClick={() => removeService(s)}>
                    <Trash2 className="h-3.5 w-3.5" />
                  </Button>
                </div>
              </div>
            );
          })}
        </div>
      </CardContent>
    </Card>
  );
}


function SystemInfrastructureCard() {
  const { t } = useI18n();
  const [busy, setBusy] = useState<string | null>(null);

  const services = [
    { key: "elara-middleware", label: "Middleware API" },
    { key: "elara-proxy", label: "TLS Proxy" },
    { key: "elara-worker", label: "Engine Worker" },
  ];

  const runAction = async (service: string, action: "start" | "stop" | "restart") => {
    setBusy(`${service}-${action}`);
    try {
      const r = await SystemEngineAPI.serviceAction(service, action);
      if (r.ok) toast.success(`${service} ${action}ed successfully`);
      else toast.error(`${service} ${action} failed: ${r.error ?? "unknown error"}`);
    } catch (e) {
      toast.error(`Service error: ${(e as Error).message}`);
    } finally {
      setBusy(null);
    }
  };

  const generateCerts = async () => {
    setBusy("certs");
    try {
      const r = await SystemEngineAPI.certsGenerate();
      if (r.ok) toast.success(`Certificates generated at ${r.path}`);
      else toast.error(`Cert generation failed: ${r.error ?? "unknown error"}`);
    } catch (e) {
      toast.error(`Cert error: ${(e as Error).message}`);
    } finally {
      setBusy(null);
    }
  };

  return (
    <Card className="glass border-primary/30 lg:col-span-2">
      <CardContent className="p-6 space-y-6">
        <div className="flex items-center justify-between flex-wrap gap-4">
          <div className="flex items-center gap-2">
            <Terminal className="h-5 w-5 text-primary" />
            <h3 className="font-bold text-sm font-mono uppercase tracking-widest">System Infrastructure</h3>
          </div>
          <Button size="sm" variant="outline" className="border-primary/40 text-primary hover:bg-primary/10" disabled={busy === "certs"} onClick={generateCerts}>
            <ShieldCheck className="h-4 w-4 mr-2" /> {busy === "certs" ? "Generating..." : "Create & Apply SSL Certificates"}
          </Button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          {services.map(s => (
            <div key={s.key} className="border border-border rounded-lg p-3 bg-card/30 space-y-3">
              <div className="flex items-center justify-between">
                <span className="text-xs font-mono font-medium">{s.label}</span>
                <Badge variant="outline" className="text-[9px] font-mono opacity-60">{s.key}</Badge>
              </div>
              <div className="flex gap-1">
                <Button size="icon" variant="ghost" className="h-7 w-7" disabled={!!busy} onClick={() => runAction(s.key, "start")} title="Start"><Zap className="h-3 w-3 text-emerald-500" /></Button>
                <Button size="icon" variant="ghost" className="h-7 w-7" disabled={!!busy} onClick={() => runAction(s.key, "stop")} title="Stop"><Minus className="h-3 w-3 text-destructive" /></Button>
                <Button size="icon" variant="ghost" className="h-7 w-7" disabled={!!busy} onClick={() => runAction(s.key, "restart")} title="Restart"><RotateCcw className="h-3 w-3 text-sky-500" /></Button>
              </div>
            </div>
          ))}
        </div>

        <div className="border-t border-border pt-4 space-y-3">
          <div className="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-muted-foreground">
            <Globe className="h-3 w-3" /> Connectivity Guide
          </div>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-[11px] font-mono leading-relaxed">
            <div className="space-y-2 p-3 rounded-lg bg-muted/30 border border-border/50">
              <p className="font-bold text-primary uppercase text-[10px]">WSL2 Networking</p>
              <p>For seamless access, use <strong className="text-foreground">mirrored networking</strong> in <code className="bg-muted px-1">.wslconfig</code>:</p>
              <div className="bg-black/40 p-2 rounded text-[10px] opacity-80">[wsl2]&#10;networkingMode=mirrored&#10;dnsTunneling=true</div>
            </div>
            <div className="space-y-2 p-3 rounded-lg bg-muted/30 border border-border/50">
              <p className="font-bold text-primary uppercase text-[10px]">Hostname Resolution</p>
              <p>Install <strong className="text-foreground">avahi-daemon</strong> on Linux to support <code className="bg-muted px-1">elara.local</code> resolution across your LAN.</p>
              <div className="bg-black/40 p-2 rounded text-[10px] opacity-80">sudo apt install avahi-daemon&#10;sudo systemctl enable --now avahi-daemon</div>
            </div>
          </div>
          <div className="flex items-center justify-between p-3 rounded-lg bg-primary/5 border border-primary/20 text-xs font-mono">
            <div className="flex items-center gap-4">
              <span className="opacity-60">HTTP: <a href="http://elara.local:3005" target="_blank" rel="noopener noreferrer" className="text-foreground font-bold hover:underline">http://elara.local:3005</a></span>
              <span className="opacity-60">HTTPS: <a href="https://elara.local:10443" target="_blank" rel="noopener noreferrer" className="text-foreground font-bold hover:underline">https://elara.local:10443</a></span>
            </div>
            <Badge variant="outline" className="text-[9px]">LAN Access</Badge>
          </div>
        </div>
      </CardContent>
    </Card>
  );
}
  const { pg, setPg } = useSecurity();
  const [draft, setDraft] = useState(pg);
  const [hb, setHb] = useState<{ ok: boolean; uptime?: number; latency?: number } | null>(null);

  useEffect(() => { setDraft(pg); }, [pg]);
  useEffect(() => {
    const ping = async () => {
      const t0 = performance.now();
      try {
        const r = await SystemAPI.health();
        setHb({ ok: r.status === "ok", uptime: r.uptime, latency: Math.round(performance.now() - t0) });
      } catch { setHb({ ok: false }); }
    };
    ping();
    const id = setInterval(ping, 5000);
    return () => clearInterval(id);
  }, []);

  const dirty = JSON.stringify(pg) !== JSON.stringify(draft);
  const [testing, setTesting] = useState(false);

  const testConnection = async () => {
    setTesting(true);
    const t0 = performance.now();
    try {
      const r = await TelemetryAPI.dbPulse();
      const ms = Math.round(performance.now() - t0);
      if (r.ok) {
        toast.success(`Connected · ${r.db || "db"} · ${r.latency || ms}ms · ${r.activeQueries} active · pool ${r.poolSize}`);
      } else {
        toast.error(`Connection failed: ${r.message ?? "unknown"}`);
      }
    } catch (e) {
      toast.error(`Connection failed: ${(e as Error).message}`);
    } finally {
      setTesting(false);
    }
  };

  return (
    <Card className="glass">
      <CardContent className="p-6 space-y-4">
        <div className="flex items-center gap-2">
          <Database className="h-4 w-4 text-primary" />
          <h3 className="font-bold text-sm font-mono uppercase tracking-widest">Bridge Health</h3>
          <Badge variant="outline" className={`ml-2 font-mono text-[10px] ${hb?.ok ? "text-emerald-500" : "text-destructive"}`}>
            {hb?.ok ? `BRIDGE ONLINE · ${hb.latency}ms` : "BRIDGE OFFLINE"}
          </Badge>
        </div>
        <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
          <div><Label>Host</Label><Input value={draft.host} onChange={e => setDraft({ ...draft, host: e.target.value })} className="font-mono mt-1"/></div>
          <div><Label>Port</Label><Input type="number" value={draft.port} onChange={e => setDraft({ ...draft, port: Number(e.target.value) })} className="font-mono mt-1"/></div>
          <div><Label>Database</Label><Input value={draft.database} onChange={e => setDraft({ ...draft, database: e.target.value })} className="font-mono mt-1"/></div>
          <div><Label>User</Label><Input value={draft.username} onChange={e => setDraft({ ...draft, username: e.target.value })} className="font-mono mt-1"/></div>
          <div><Label>Password</Label><Input type="password" value={draft.password} onChange={e => setDraft({ ...draft, password: e.target.value })} className="font-mono mt-1"/></div>
        </div>
        <div className="flex items-center justify-between border-t border-border pt-3 gap-3">
          <p className="text-[10px] font-mono text-muted-foreground">
            Hybrid memory: documents → Vector DB · chats &amp; agent logs → PostgreSQL · schema auto-migrated on backend boot.
          </p>
          <div className="flex items-center gap-2 shrink-0">
            <Button size="sm" variant="outline" onClick={testConnection} disabled={testing}>
              <Plug className="h-3.5 w-3.5 mr-1" />{testing ? "Testing…" : "Test Connection"}
            </Button>
            <Button size="sm" disabled={!dirty} onClick={() => { setPg(draft); toast.success("PostgreSQL config saved (restart middleware to apply)"); }}>
              <Save className="h-3.5 w-3.5 mr-1" />Save
            </Button>
          </div>
        </div>
      </CardContent>
    </Card>
  );
}

