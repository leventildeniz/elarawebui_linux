      '\n' +
      'const field =\n' +
      '  "w-full rounded-lg border border-white/[0.07] bg-raised/40 px-3 py-2 font-mono text-[12.5px] leading-relaxed text-foreground outline-none transition-colors focus:border-sapphire/50";\n' +
      '\n' +
      'function EnginePage() {\n' +
      '  const { view } = Route.useSearch();\n' +
      '\n' +
      '  return (\n' +
      '    <Surface\n' +
      '      title="System Engine"\n' +
      '      meta="semantic intent router · orchestrator bridge · live console"\n' +
      '      wide\n' +
      '    >\n' +
      '      <AnimatePresence mode="wait">\n' +
      '        <motion.div\n' +
      '          key={view}\n' +
      '          initial={{ opacity: 0, y: 8 }}\n' +
      '          animate={{ opacity: 1, y: 0 }}\n' +
      '          exit={{ opacity: 0, y: -6 }}\n' +
      '          transition={{ duration: 0.16, ease: [0.22, 1, 0.36, 1] }}\n' +
      '        >\n' +
      '          {view === "console" ? (\n' +
      '            <LiveConsole />\n' +
      '          ) : view === "bridge" ? (\n' +
