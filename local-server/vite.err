    '      user: "admin",\n' +
    '      adapter: "spawn",\n' +
    '      status: "ok",\n' +
    '      startedAt: Date.now(),\n' +
    '      durationMs: 1200 + Math.floor(Math.random() * 24000),\n' +
    '    };\n' +
