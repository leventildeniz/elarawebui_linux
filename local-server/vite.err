      'import { cn, fmtDate } from "@/lib/utils";\n' +
      'import { fetchApi } from "@/lib/api";\n' +
      'import { syncJobs, syncLiveLines } from "@/mocks";\n' +
      '\n' +
      'const views = ["control", "spaces", "aliases", "tuning"] as const;\n' +
      'type Tab = (typeof views)[number];\n' +
      '\n' +
      'export const Route = createFileRoute("/knowledge")({\n' +
      '  validateSearch: (search: Record<string, unknown>): { view: Tab } => {\n' +
      '    const v = search["view"];\n' +
      '    return { view: views.includes(v as Tab) ? (v as Tab) : "control" };\n' +
      '  },\n' +
      '  head: () => ({\n' +
      '    meta: [\n' +
      '      { title: "Knowledge Hub (RAG) — Elara Sovereign Studio" },\n' +
      '      {\n' +
      '        name: "description",\n' +
      '        content:\n' +
      '          "Ingestion control, chunk health, brand aliases, vector forge telemetry, webhook adapters and graph retrieval for the sovereign knowledge layer.",\n' +
      '      },\n' +
      '      { property: "og:title", content: "Knowledge Hub (RAG) — Elara Sovereign Studio" },\n' +
      '      {\n' +
      '        property: "og:description",\n' +
      '        content:\n' +
      '          "Ingestion control, chunk health, brand aliases, vector forge telemetry and graph retrieval.",\n' +
      '      },\n' +
      '      { property: "og:type", content: "website" },\n' +
      '      { name: "twitter:card", content: "summary_large_image" },\n' +
      '    ],\n' +
      '  }),\n' +
      '  component: KnowledgePage,\n' +
      '});\n' +
      '\n' +
      'const field =\n' +
      '  "w-full rounded-lg border border-white/[0.07] bg-raised/40 px-3 py-2 font-mono text-[12.5px] text-foreground outline-none transition-colors placeholder:text-muted-foreground/45 focus:border-sapphire/50";\n' +
      'const label = "mono-label mb-1.5 block";\n' +
      '\n' +
      'function KnowledgePage() {\n' +
      '  const { view: tab } = Route.useSearch();\n' +
      '  const [addOpen, setAddOpen] = useState(false);\n' +
      '\n' +
      '  return (\n' +
      '    <Surface\n' +
      '      title="Knowledge Hub (RAG)"\n' +
      '      meta="PDF · TXT · URL · Drive · auto-extract .zip/.tar/.rar"\n' +
      '      wide\n' +
      '      action={\n' +
      '        <div className="flex items-center gap-1.5">\n' +
      '          {tab === "control" && (\n' +
      '            <JewelButton size="sm" onClick={() => setAddOpen(true)}>\n' +
      '              <Plus size={13} /> Add Source\n' +
      '            </JewelButton>\n' +
      '          )}\n' +
      '        </div>\n' +
      '      }\n' +
      '    >\n' +
      '      <AnimatePresence mode="wait">\n' +
      '        <motion.div\n' +
      '          key={tab}\n' +
      '          initial={{ opacity: 0, y: 8 }}\n' +
      '          animate={{ opacity: 1, y: 0 }}\n' +
      '          exit={{ opacity: 0, y: -6 }}\n' +
      '          transition={{ duration: 0.16, ease: [0.22, 1, 0.36, 1] }}\n' +
      '        >\n' +
      '          {tab === "control" && <ControlTab />}\n' +
      '          {tab === "spaces" && <KnowledgeSpacesTab />}\n' +
      '          {tab === "aliases" && <BrandAliasesTab />}\n' +
      '          {tab === "tuning" && <AdvancedTuningTab />}\n' +
      '        </motion.div>\n' +
      '      </AnimatePresence>\n' +
      '\n' +
      '      <AnimatePresence>\n' +
      '        {addOpen && <AddSourceDialog onClose={() => setAddOpen(false)} />}\n' +
      '      </AnimatePresence>\n' +
      '    </Surface>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      '/* ----------------------------------------------------------- control tab */\n' +
      '\n' +
      'function ControlTab() {\n' +
      '  const k = useKnowledge();\n' +
      '  const access = useSpaceAccess();\n' +
      '  const [spin, setSpin] = useState(false);\n' +
      '\n' +
      '  // Retrieval boundary: a source is only visible when the principal reads its\n' +
      '  // space. Admin principals are sovereign and see everything.\n' +
      '  const visible = k.sources.filter(\n' +
      '    (s) => access.sovereign || (s.space ? access.canRead(s.space) : true),\n' +
      '  );\n' +
      '  const spaceName = (id?: string) => access.spaces.find((x) => x.id === id)?.name ?? "unscoped";\n' +
      '\n' +
      '  const refresh = () => {\n' +
      '    setSpin(true);\n' +
      '    setTimeout(() => setSpin(false), 700);\n' +
      '  };\n' +
      '\n' +
      '  const metrics: {\n' +
      '    label: string;\n' +
      '    value: number;\n' +
      '    tone?: "ruby" | "topaz" | "emerald" | undefined;\n' +
      '  }[] = [\n' +
      '    { label: "Chunks", value: k.health.chunks },\n' +
      '    { label: "FTS NULL", value: k.health.ftsNull, tone: k.health.ftsNull ? "topaz" : undefined },\n' +
      '    { label: "Embed OK", value: k.health.embedOk, tone: "emerald" },\n' +
      '    { label: "Embed Pending", value: k.health.embedPending },\n' +
      '    { label: "In Progress", value: k.health.inProgress },\n' +
      '    { label: "Stale", value: k.health.stale, tone: k.health.stale ? "topaz" : undefined },\n' +
      '    {\n' +
      '      label: "Embed Error",\n' +
      '      value: k.health.embedError,\n' +
      '      tone: k.health.embedError ? "ruby" : undefined,\n' +
      '    },\n' +
      '    { label: "Sources", value: k.sources.length },\n' +
      '    { label: "Parse OK", value: k.health.parseOk },\n' +
      '    { label: "Parse Low", value: k.health.parseLow },\n' +
      '  ];\n' +
      '\n' +
      '  return (\n' +
      '    <div className="space-y-6">\n' +
      '      <Panel>\n' +
      '        <div className="flex flex-wrap items-center justify-between gap-3">\n' +
      '          <div className="flex items-center gap-2.5">\n' +
      '            <Activity size={15} className="text-sapphire" />\n' +
      '            <h2 className="text-[16.5px] font-medium tracking-tight text-foreground">\n' +
      '              RAG Control &amp; Health\n' +
      '            </h2>\n' +
      '            <Tag tone="platinum">single source of truth</Tag>\n' +
      '          </div>\n' +
      '          <button\n' +
      '            type="button"\n' +
      '            onClick={refresh}\n' +
      '            className="flex items-center gap-2 rounded-md px-2 py-1 text-[12.5px] text-muted-foreground transition-colors hover:text-foreground"\n' +
      '          >\n' +
      '            <RefreshCw size={13} className={cn(spin && "animate-spin")} /> Refresh\n' +
      '          </button>\n' +
      '        </div>\n' +
      '\n' +
      '        <div className="mt-5 space-y-2.5">\n' +
      '          <ToggleRow\n' +
      '            title="Auto Ingestion"\n' +
      '            badge={k.autoIngestion ? "ON · watching disk" : "OFF · Manual sync only"}\n' +
      '            badgeTone={k.autoIngestion ? "emerald" : "ruby"}\n' +
      '            hint="OFF means disk changes never start ingestion by themselves. Sources are indexed only from explicit Add Source / Sync actions."\n' +
      '            checked={k.autoIngestion}\n' +
      '            onChange={(v) => k.patch({ autoIngestion: v })}\n' +
      '          />\n' +
      '          <ToggleRow\n' +
      '            title="Auto Re-enrich on Ingest"\n' +
      '            badge={k.autoReEnrich ? "ON · automatic" : "OFF · manual from /knowledge/aliases"}\n' +
      '            badgeTone={k.autoReEnrich ? "emerald" : "platinum"}\n' +
      '            hint="When ON, every successful document add (file / URL / inline text) automatically spawns brand re-enrichment + stale-marks chunks. Per-brand 409 guard prevents duplicate jobs. Default OFF."\n' +
      '            checked={k.autoReEnrich}\n' +
      '            onChange={(v) => k.patch({ autoReEnrich: v })}\n' +
      '          />\n' +
      '        </div>\n' +
      '\n' +
      '        <div className="mt-5 grid gap-px overflow-hidden rounded-lg border border-white/[0.07] bg-white/[0.05] sm:grid-cols-2 lg:grid-cols-4">\n' +
      '          {metrics.map((m) => (\n' +
      '            <div key={m.label} className="bg-panel/60 px-4 py-3">\n' +
      '              <div className="mono-label">{m.label}</div>\n' +
      '              <div\n' +
      '                className={cn(\n' +
      '                  "mt-1 font-mono text-[15px] text-foreground",\n' +
      '                  m.tone === "ruby" && "text-ruby",\n' +
      '                  m.tone === "topaz" && "text-topaz",\n' +
      '                  m.tone === "emerald" && "text-emerald",\n' +
      '                )}\n' +
      '              >\n' +
      '                {(m.value ?? 0).toLocaleString()}\n' +
      '              </div>\n' +
      '            </div>\n' +
      '          ))}\n' +
      '        </div>\n' +
      '\n' +
      '        <div className="mt-5 flex flex-wrap items-center gap-2">\n' +
      '          <MaintButton \n' +
      '            icon={<Zap size={13} />} \n' +
      '            onClick={() => fetchApi("/api/rag/repair-fts", { method: "POST" })}\n' +
      '          >\n' +
      '            Repair FTS\n' +
      '          </MaintButton>\n' +
      '          <MaintButton \n' +
      '            icon={<RefreshCw size={13} />}\n' +
      '            onClick={() => fetchApi("/api/knowledge/embeddings/mark-pending", { method: "POST" })}\n' +
