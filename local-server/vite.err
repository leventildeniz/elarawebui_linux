      '\n' +
      '  return (\n' +
      '    <div className="rounded-xl border border-white/[0.06] bg-raised/20 p-4">\n' +
      '      <div className="mono-label mb-2">\n' +
      '        {label} · {selected.length}\n' +
      '      </div>\n' +
      '      <div className="flex flex-wrap items-center gap-2">\n' +
      '        <select\n' +
      '          value={value}\n' +
      '          disabled={!available.length}\n' +
      '          onChange={(e) => setPick(e.target.value)}\n' +
      '          className={cn(input, "h-[34px] w-auto min-w-[220px] flex-1 py-1 font-mono text-[12.5px]")}\n' +
      '        >\n' +
      '          {available.length ? (\n' +
      '            available.map((c) => (\n' +
