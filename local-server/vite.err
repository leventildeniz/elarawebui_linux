    '      agentId: a.id,\n' +
    '      agent: a.name.toLowerCase(),\n' +
    '      source: "console",\n' +
    '      user: "admin",\n' +
    '      adapter: "spawn",\n' +
    '      status: "ok",\n' +
    '      startedAt: Date.now(),\n' +
    '      durationMs: 1200 + Math.floor(Math.random() * 24000),\n' +
    '    };\n' +
    '    setRuns((prev) => {\n' +
    '      const next = [run, ...prev].slice(0, 200);\n' +
    '      writeRuns(next);\n' +
    '      return next;\n' +
    '    });\n' +
    '    return run;\n' +
    '  }, []);\n' +
    '\n' +
    "  /* The roster is the caller's desk: own agents, shared ones, system seeds. */\n" +
    '  const visible = scopeOwned(agents, ctx);\n' +
    '\n' +
    '  return { agents: visible, allAgents: agents, ctx, runs, create, update, remove, dispatch };\n' +
    '}\n' +
    '\n' +
    '/* ------------------------------------------------------------------ squads */\n' +
    '\n' +
    'export type Squad = { id: string; name: string; tone: string };\n' +
    '\n' +
    'export const squadTones = ["sapphire", "emerald", "amethyst", "topaz", "ruby"] as const;\n' +
    '\n' +
    'const SQUADS_KEY = "sovereign.squads";\n' +
