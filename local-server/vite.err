      '            checked={k.autoReEnrich}\n' +
      '            onChange={(v) => k.patch({ autoReEnrich: v })}\n' +
      '          />\n' +
      '        </div>\n' +
      '\n' +
      '        <div className="mt-5 grid gap-px overflow-hidden rounded-lg border border-white/[0.07] bg-white/[0.05] sm:grid-cols-2 lg:grid-cols-4">\n' +
      '          {metrics.map((m) => (\n' +
      '            <div key={m.label} className="bg-panel/60 px-4 py-3">\n' +
      '              <div className="mono-label">{m.label}</div>\n' +
      '              <div\n' +
