    '];\n' +
    '\n' +
    'import { fetchApi } from "@/lib/api";\n' +
    '\n' +
    'const KEY = "sovereign.agents";\n' +
    'const RUNS_KEY = "sovereign.agents.runs";\n' +
    'const EVT = "sovereign:agents";\n' +
    '\n' +
    '\n' +
    'export { seedAgents };\n' +
    '\n' +
    'const runAgents = seedAgents.filter((a) => a.stats.calls > 0);\n' +
    '\n' +
    'export const seedRuns: AgentRun[] = Array.from({ length: 40 }, (_, i) => {\n' +
    '  const a = runAgents[i % runAgents.length]!;\n' +
    '  const status: AgentRun["status"] = i % 11 === 3 ? "error" : "ok";\n' +
    '  return {\n' +
    '    id: `run.${i}`,\n' +
    '    agentId: a.id,\n' +
    '    agent: a.name.toLowerCase(),\n' +
