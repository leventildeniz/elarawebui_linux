      '        </div>\n' +
      '\n' +
      '        <div className="mt-5 space-y-2.5">\n' +
      '          <ToggleRow\n' +
      '            title="Auto Ingestion"\n' +
      '            badge={k.autoIngestion ? "ON · watching disk" : "OFF · Manual sync only"}\n' +
      '            badgeTone={k.autoIngestion ? "emerald" : "ruby"}\n' +
