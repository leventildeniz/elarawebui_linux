  pluginCode: 'import { seedNow } from "@/lib/utils";\n' +
    'import { useCallback, useEffect, useState } from "react";\n' +
    'import { builtinWebhooks } from "@/mocks/knowledge-seed";\n' +
    'import { defaultKnowledge } from "@/mocks/knowledge-seed";\n' +
    'import { fetchApi } from "@/lib/api";\n' +
    'import { currentAccount } from "@/lib/group-store";\n' +
    '\n' +
    'let cachedState = defaultKnowledge;\n' +
    '\n' +
    'async function syncBackend() {\n' +
    '  try {\n' +
    '    const res = await fetchApi("/api/knowledge/state");\n' +
    '    cachedState = { ...defaultKnowledge, ...res };\n' +
    '    window.dispatchEvent(new CustomEvent(EVT));\n' +
    '  } catch (e) {\n' +
    '    console.warn("Failed to sync knowledge state:", e);\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    '/**\n' +
    ' * Knowledge Hub (RAG) state — ingestion control, sources, webhook adapters,\n' +
    ' * graph statistics. Persisted locally until the retrieval layer gets a backend.\n' +
    ' */\n' +
    '\n' +
    'export type SourceKind = "file" | "directory" | "url" | "text";\n' +
    '\n' +
    'export type KnowledgeSource = {\n' +
    '  id: string;\n' +
    '  name: string;\n' +
    '  kind: SourceKind;\n' +
    '  brand: string;\n' +
    '  chunks: number;\n' +
    '  status: "indexed" | "pending" | "stale" | "error";\n' +
    '  addedAt: number;\n' +
    '  /** Knowledge space this source belongs to — the permission boundary. */\n' +
    '  space?: string;\n' +
    '  /** Account id of the principal who ingested it. */\n' +
    '  owner?: string;\n' +
    '  /** Display handle of the uploader, kept for the audit line. */\n' +
    '  ownerName?: string;\n' +
    '  /** Upload size in MB, when known. */\n' +
    '  sizeMb?: number;\n' +
    '  /** Collection (virtual folder) this document was dropped into. */\n' +
    '  folder?: string;\n' +
    '  /** Tags derived automatically at ingest time — never typed by the user. */\n' +
    '  tags?: string[];\n' +
    '  /** Moment the document entered the ingest queue. */\n' +
    '  queuedAt?: number;\n' +
    '  /** Moment the index finished writing. */\n' +
    '  indexedAt?: number;\n' +
    '  /** Human-readable stage while the document is still pending. */\n' +
    '  stage?: string;\n' +
    '};\n' +
    '\n' +
    'export type WebhookAdapter = {\n' +
    '  id: string;\n' +
    '  label: string;\n' +
    '  slug: string;\n' +
    '  enabled: boolean;\n' +
    '  secret: string;\n' +
    '  urlOverride: string;\n' +
    '  builtin: boolean;\n' +
    '  /** when true, payloads from this adapter are ingested into the RAG layer */\n' +
    '  ingestToRag: boolean;\n' +
    '};\n' +
    '\n' +
    'export type KnowledgeHealth = {\n' +
    '  chunks: number;\n' +
    '  ftsNull: number;\n' +
    '  embedOk: number;\n' +
    '  embedPending: number;\n' +
    '  inProgress: number;\n' +
    '  stale: number;\n' +
    '  embedError: number;\n' +
    '  parseOk: number;\n' +
    '  parseLow: number;\n' +
    '};\n' +
    '\n' +
    'export type KnowledgeState = {\n' +
    '  autoIngestion: boolean;\n' +
    '  autoReEnrich: boolean;\n' +
    '  batchSize: 500 | 1000 | 2500;\n' +
    '  embedModel: string;\n' +
    '  health: KnowledgeHealth;\n' +
    '  sources: KnowledgeSource[];\n' +
    '  webhooks: WebhookAdapter[];\n' +
    '  graph: { entities: number; edges: number; orphanEntities: number; orphanEdges: number };\n' +
    '  brandAliases: {\n' +
    '    id: string;\n' +
    '    brand: string;\n' +
    '    aliases: string;\n' +
    '    chunks?: number;\n' +
    '    enrichedDaysAgo?: number;\n' +
    '  }[];\n' +
    '};\n' +
    '\n' +
    'export { builtinWebhooks };\n' +
    '\n' +
    'export function webhookUrl(w: WebhookAdapter) {\n' +
    '  if (w.urlOverride) return w.urlOverride;\n' +
    '  const host = typeof window !== "undefined" ? window.location.origin : "";\n' +
    '  return `${host}/api/webhooks/${w.slug}`;\n' +
    '}\n' +
    '\n' +
    'export const topEntities: { name: string; kind: string; degree: number }[] = [];\n' +
    '\n' +
    'export { defaultKnowledge };\n' +
    '\n' +
    'const KEY = "sovereign.knowledge";\n' +
    'const EVT = "sovereign:knowledge";\n' +
    '\n' +
    'function read(): KnowledgeState {\n' +
    '  return cachedState;\n' +
    '}\n' +
    '\n' +
    'function write(next: KnowledgeState) {\n' +
    '  cachedState = next;\n' +
    '  window.dispatchEvent(new CustomEvent(EVT));\n' +
    '}\n' +
    '\n' +
    'const uid = (p: string) => `${p}_${Math.random().toString(36).slice(2, 8)}`;\n' +
    '\n' +
    'export function useKnowledge() {\n' +
    '  const [state, setState] = useState<KnowledgeState>(cachedState);\n' +
    '\n' +
    '  useEffect(() => {\n' +
    '    const sync = () => setState(read());\n' +
    '    sync();\n' +
    '    window.addEventListener(EVT, sync);\n' +
    '    syncBackend();\n' +
    '    return () => window.removeEventListener(EVT, sync);\n' +
    '  }, []);\n' +
    '\n' +
    '  const patch = useCallback((p: Partial<KnowledgeState>) => {\n' +
    '    const next = { ...read(), ...p };\n' +
    '    write(next);\n' +
    '    setState(next);\n' +
    '\n' +
    '    const body: Record<string, any> = {};\n' +
    `    if ('autoIngestion' in p) body["autoIngestion"] = p.autoIngestion;\n` +
    `    if ('autoReEnrich' in p) body["autoReEnrich"] = p.autoReEnrich;\n` +
    `    if ('batchSize' in p) body["batchSize"] = p.batchSize;\n` +
    `    if ('embedModel' in p) body["embedModel"] = p.embedModel;\n` +
    '\n' +
    '    if (Object.keys(body).length > 0) {\n' +
    '      fetchApi("/api/knowledge/config", {\n' +
    '        method: "PATCH",\n' +
    '        body: JSON.stringify(body)\n' +
    '      }).catch(console.error);\n' +
    '    }\n' +
    '  }, []);\n' +
    '\n' +
    '  const addSource = useCallback(\n' +
    '    async (src: {\n' +
    '      name: string;\n' +
    '      kind: SourceKind;\n' +
    '      brand: string;\n' +
    '      space?: string;\n' +
    '      owner?: string;\n' +
    '      ownerName?: string;\n' +
    '      sizeMb?: number;\n' +
    '      folder?: string;\n' +
    '      tags?: string[];\n' +
    '      file?: File | null;\n' +
    '      content?: string;\n' +
    '    }) => {\n' +
    '      const entry: KnowledgeSource = {\n' +
    '        id: uid("src"),\n' +
    '        name: src.name,\n' +
    '        kind: src.kind,\n' +
    '        brand: src.brand || "auto-detect",\n' +
    '        space: src.space ?? "",\n' +
    '        owner: src.owner ?? "",\n' +
    '        ownerName: src.ownerName ?? "",\n' +
    '        sizeMb: src.sizeMb ?? 0,\n' +
    '        folder: src.folder ?? "",\n' +
    '        tags: src.tags ?? [],\n' +
    '        chunks: 0,\n' +
    '        status: "pending",\n' +
    '        addedAt: Date.now(),\n' +
    '        queuedAt: Date.now(),\n' +
    '        stage: "queued",\n' +
    '      };\n' +
    '\n' +
    '      const current = read();\n' +
    '      const next = {\n' +
    '        ...current,\n' +
    '        sources: [entry, ...current.sources],\n' +
    '        health: { ...current.health, embedPending: current.health.embedPending + 1 },\n' +
    '      };\n' +
    '      write(next);\n' +
    '      setState(next);\n' +
    '\n' +
    '      try {\n' +
    '        let res;\n' +
    '        if (src.kind === "file" && src.file) {\n' +
    '          const fd = new FormData();\n' +
    '          fd.append("file", src.file);\n' +
    '          if (src.brand) fd.append("brand", src.brand);\n' +
    '          if (src.space) fd.append("spaceId", src.space);\n' +
    '          if (src.owner) fd.append("ownerId", src.owner);\n' +
    '          if (src.ownerName) fd.append("ownerName", src.ownerName);\n' +
    '          \n' +
    '          const headers = new Headers();\n' +
    '          const sessionId = localStorage.getItem("sovereign.sessionId");\n' +
    '          if (sessionId) headers.set("x-session-id", sessionId);\n' +
    '\n' +
    '          res = await fetch("/api/knowledge/file", {\n' +
    '            method: "POST",\n' +
    '            body: fd,\n' +
    '            headers\n' +
    '          }).then(r => r.json());\n' +
    '        } else if (src.kind === "url") {\n' +
    '          res = await fetchApi("/api/knowledge/fetch", {\n' +
    '            method: "POST",\n' +
    '            body: JSON.stringify({\n' +
    '              url: src.content,\n' +
    '              brand: src.brand,\n' +
    '              spaceId: src.space,\n' +
    '              ownerId: src.owner,\n' +
    '              ownerName: src.ownerName\n' +
    '            })\n' +
    '          });\n' +
    '        } else if (src.kind === "text") {\n' +
    '          res = await fetchApi("/api/knowledge/text", {\n' +
    '            method: "POST",\n' +
    '            body: JSON.stringify({\n' +
    '              content: src.content,\n' +
    '              name: src.name,\n' +
    '              brand: src.brand,\n' +
    '              spaceId: src.space,\n' +
    '              ownerId: src.owner,\n' +
    '              ownerName: src.ownerName\n' +
    '            })\n' +
    '          });\n' +
    '        } else if (src.kind === "directory") {\n' +
    '          res = await fetchApi("/api/knowledge/index-directory", {\n' +
    '            method: "POST",\n' +
    '            body: JSON.stringify({\n' +
    '              path: src.content,\n' +
    '              recursive: true,\n' +
    '              spaceId: src.space,\n' +
    '              ownerId: src.owner,\n' +
    '              ownerName: src.ownerName\n' +
    '            })\n' +
    '          });\n' +
    '        }\n' +
    '        \n' +
    '        console.log("Ingest response:", res); catch (e) {\n' +
    '        console.error("Ingest POST failed:", e);\n' +
    '      }\n' +
    '      \n' +
    '      // Refresh to get real DB status\n' +
    '      await syncBackend();\n' +
    '      return entry.id;\n' +
    '    },\n' +
    '    [],\n' +
    '  );\n' +
    '\n' +
    '  const removeSource = useCallback(async (id: string) => {\n' +
    '    // Optimistic\n' +
    '    const current = read();\n' +
    '    const next = { ...current, sources: current.sources.filter((s) => s.id !== id) };\n' +
    '    write(next);\n' +
    '    setState(next);\n' +
    '\n' +
    '    try {\n' +
    '      await fetchApi("/api/knowledge/purge", {\n' +
    '        method: "POST",\n' +
    '        body: JSON.stringify({ sourceId: id })\n' +
    '      });\n' +
    '      syncBackend();\n' +
    '    } catch (e) {\n' +
    '      console.error("removeSource failed:", e);\n' +
    '    }\n' +
    '  }, []);\n' +
    '\n' +
    '  const patchSource = useCallback((id: string, p: Partial<KnowledgeSource>) => {\n' +
    '    const current = read();\n' +
    '    const next = {\n' +
    '      ...current,\n' +
    '      sources: current.sources.map((s) => (s.id === id ? { ...s, ...p } : s)),\n' +
    '    };\n' +
    '    write(next);\n' +
    '    setState(next);\n' +
    '\n' +
    '    if (p.brand !== undefined) {\n' +
    '      fetchApi(`/api/knowledge/source/${id}/brand`, {\n' +
    '        method: "PATCH",\n' +
    '        body: JSON.stringify({ brand: p.brand })\n' +
    '      }).catch(console.error);\n' +
    '    }\n' +
    '  }, []);\n' +
    '\n' +
    '  const patchWebhook = useCallback((id: string, p: Partial<WebhookAdapter>) => {\n' +
    '    const current = read();\n' +
    '    const next = {\n' +
    '      ...current,\n' +
    '      webhooks: current.webhooks.map((w) => (w.id === id ? { ...w, ...p } : w)),\n' +
    '    };\n' +
    '    write(next);\n' +
    '    setState(next);\n' +
    '  }, []);\n' +
    '\n' +
    '  const addWebhook = useCallback((label: string, slug: string) => {\n' +
    '    const current = read();\n' +
    '    const next = {\n' +
    '      ...current,\n' +
    '      webhooks: [\n' +
    '        ...current.webhooks,\n' +
    '        {\n' +
    '          id: uid("wh"),\n' +
    '          label,\n' +
    '          slug: slug || label.toLowerCase().replace(/\\s+/g, "-"),\n' +
    '          enabled: false,\n' +
    '          secret: "",\n' +
    '          urlOverride: "",\n' +
    '          builtin: false,\n' +
