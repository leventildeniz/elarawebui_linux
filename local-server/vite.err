    '  }));\n' +
    '\n' +
    'function readSquads(): Squad[] {\n' +
    '  if (typeof window === "undefined") return seedSquads;\n' +
    '  try {\n' +
    '    const raw = window.localStorage.getItem(SQUADS_KEY);\n' +
    '    if (!raw) return seedSquads;\n' +
