      '      { property: "og:title", content: "Knowledge Hub (RAG) — Elara Sovereign Studio" },\n' +
      '      {\n' +
      '        property: "og:description",\n' +
      '        content:\n' +
      '          "Ingestion control, chunk health, brand aliases, vector forge telemetry and graph retrieval.",\n' +
      '      },\n' +
      '      { property: "og:type", content: "website" },\n' +
      '      { name: "twitter:card", content: "summary_large_image" },\n' +
      '    ],\n' +
      '  }),\n' +
      '  component: KnowledgePage,\n' +
