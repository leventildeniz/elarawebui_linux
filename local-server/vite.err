      '\n' +
      '  return (\n' +
      '    <Surface\n' +
      '      title="Knowledge Hub (RAG)"\n' +
      '      meta="PDF · TXT · URL · Drive · auto-extract .zip/.tar/.rar"\n' +
      '      wide\n' +
      '      action={\n' +
      '        <div className="flex items-center gap-1.5">\n' +
