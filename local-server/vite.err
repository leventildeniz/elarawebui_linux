      '  children: React.ReactNode;\n' +
      '}) {\n' +
      '  return (\n' +
      '    <section className="rounded-xl border border-white/[0.07] bg-white/[0.015] p-6">\n' +
      '      <header className="mb-4 flex items-start justify-between gap-4">\n' +
      '        <div className="flex items-center gap-2.5">\n' +
      '          {icon && <span className="text-sapphire/80">{icon}</span>}\n' +
