      '  return (\n' +
      '    <div className="flex flex-wrap items-center gap-1.5">\n' +
      '      {options.map((o) => (\n' +
      '        <button\n' +
      '          key={o}\n' +
      '          type="button"\n' +
      '          onClick={() => onChange(o)}\n' +
      '          className={cn(\n' +
      '            "rounded-lg border px-3 py-[5px] font-mono text-[12px] transition-all duration-150 ease-in-out",\n' +
      '            value === o\n' +
      '              ? "border-sapphire/45 bg-sapphire/12 text-sapphire shadow-[0_0_24px_-14px_var(--sapphire)]"\n' +
      '              : "border-white/[0.07] bg-raised/25 text-muted-foreground/80 hover:border-white/15 hover:text-foreground",\n' +
      '          )}\n' +
      '        >\n' +
      '          {o}\n' +
      '        </button>\n' +
      '      ))}\n' +
      '    </div>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      '/* --------------------------------------------------------------- runtime */\n' +
      '\n' +
      'function IntentRouter() {\n' +
      '  const { config, update, reset } = useEngine();\n' +
      '\n' +
      '  const [draftPrompt, setDraftPrompt] = useState(config.classifierPrompt);\n' +
      '  const dirtyPrompt = draftPrompt !== config.classifierPrompt;\n' +
      '\n' +
      '  useEffect(() => {\n' +
      '    setDraftPrompt(config.classifierPrompt);\n' +
      '  }, [config.classifierPrompt]);\n' +
      '\n' +
      '  return (\n' +
      '    <div className="space-y-6">\n' +
      '      <div\n' +
      '        className={cn(\n' +
      '          "rounded-xl border p-5",\n' +
      '          config.bypassEnabled\n' +
      '            ? "border-emerald/30 bg-emerald/[0.05]"\n' +
      '            : "border-ruby/30 bg-ruby/[0.05]",\n' +
      '        )}\n' +
      '      >\n' +
      '        <div className="flex items-start justify-between gap-6">\n' +
      '          <div className="min-w-0">\n' +
      '            <div className="flex items-center gap-2">\n' +
      '              <BanIcon size={14} className={config.bypassEnabled ? "text-emerald" : "text-ruby"} />\n' +
      '              <span className="font-mono text-[12px] tracking-[0.14em] text-foreground/90">\n' +
      '                {config.bypassEnabled ? "BYPASS ENABLED" : "BYPASS DISABLED"} · POLICY V4\n' +
      '              </span>\n' +
      '            </div>\n' +
      '            <p className="mt-2 max-w-[86ch] text-[13.5px] leading-relaxed text-muted-foreground">\n' +
      '              Instant template bypass removed. Every request — chit-chat or technical — flows\n' +
      '              through the active runtime. The router only shapes system-prompt tone (smalltalk vs\n' +
      '              query); it no longer routes around the model.\n' +
      '            </p>\n' +
      '          </div>\n' +
      '          <JewelButton\n' +
      '            variant={config.bypassEnabled ? "danger" : "outline"}\n' +
      '            size="sm"\n' +
      '            onClick={() => update({ bypassEnabled: !config.bypassEnabled })}\n' +
      '          >\n' +
      '            {config.bypassEnabled ? "Disable bypass" : "Enable bypass"}\n' +
      '          </JewelButton>\n' +
      '        </div>\n' +
      '      </div>\n' +
      '\n' +
      '      <Panel\n' +
      '        title="Similarity Threshold (RAG anchor)"\n' +
      '        hint="Query is compared to the technical/library concept vector. Below this threshold the router bypasses RAG/PostgreSQL and answers directly."\n' +
      '        right={\n' +
      '          <span className="rounded-md border border-white/[0.08] bg-raised/50 px-2.5 py-1 font-mono text-[12.5px] text-sapphire">\n' +
      '            {config.similarity.toFixed(2)}\n' +
      '          </span>\n' +
      '        }\n' +
      '      >\n' +
      '        <input\n' +
      '          type="range"\n' +
      '          min={0}\n' +
      '          max={1}\n' +
      '          step={0.01}\n' +
      '          value={config.similarity}\n' +
      '          onChange={(e) => update({ similarity: Number(e.target.value) })}\n' +
      '          className="w-full accent-[var(--sapphire)]"\n' +
      '          aria-label="Similarity threshold"\n' +
      '        />\n' +
      '      </Panel>\n' +
      '\n' +
      '      <Panel\n' +
      '        title="Classifier Mode"\n' +
      '        hint="embedding → runtime cosine gate · llm → zero-shot to local LLM · hybrid → embedding first, LLM fallback."\n' +
      '      >\n' +
      '        <Segmented<ClassifierMode>\n' +
      '          value={config.classifier}\n' +
      '          options={["embedding", "llm", "hybrid"] as const}\n' +
      '          onChange={(v) => update({ classifier: v })}\n' +
      '        />\n' +
      '      </Panel>\n' +
