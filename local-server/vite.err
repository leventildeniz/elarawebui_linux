    '/** Columns understood by the bulk importer, in template order. */\n' +
    'export const importColumns: { key: string; accepts: string; note: string }[] = [\n' +
    '  { key: "name", accepts: "text", note: "target display name (required)" },\n' +
    '  { key: "ip", accepts: "IPv4 / IPv6", note: "address of the endpoint" },\n' +
    '  { key: "host", accepts: "FQDN", note: "e.g. fw01.corp.local" },\n' +
    '  {\n' +
    '    key: "port",\n' +
    '    accepts: "443 · 443,22,8443 · 8000-8005",\n' +
    '    note: "multi-port rows auto-create endpoints",\n' +
    '  },\n' +
    '  { key: "adapter", accepts: "adapter name", note: "matched against the adapter registry" },\n' +
    '  { key: "group", accepts: "group name", note: "falls back to the filtered group" },\n' +
    '  { key: "tags", accepts: "a;b or a|b", note: "comma-, semicolon- or pipe-separated" },\n' +
    '  { key: "vault_scope", accepts: "studio · workspace · agent · user", note: "credential scope" },\n' +
    '  { key: "vault_name", accepts: "text", note: "credential name inside the vault" },\n' +
    '  { key: "risk_level", accepts: "low · medium · high · critical", note: "defaults to low" },\n' +
    '  { key: "owner", accepts: "free text", note: "accountable operator" },\n' +
    '  { key: "notes", accepts: "free text", note: "operator annotation" },\n' +
    '];\n' +
    '\n' +
    '/** Downloadable starter sheet, mirrored by the importer docs. */\n' +
    'export const importTemplateCsv = [\n' +
    '  "name,ip,host,port,adapter,group,tags,vault_scope,vault_name,risk_level,owner,notes",\n' +
    `  'fw01,10.0.0.1,fw01.corp.local,"443,22",Fortinet FortiOS,Perimeter,"prod;dmz",studio,fw-admin,high,netsec,primary perimeter pair',\n` +
    '  "fw02,10.0.0.2,fw02.corp.local,443,Fortinet FortiOS,Perimeter,prod,studio,fw-admin,high,netsec,standby node",\n' +
    `  'web01,10.0.1.10,,"80,443",SSH,Linux DMZ,"prod;web",workspace,linux-svc,medium,platform,public web head',\n` +
    '  "db01,10.0.2.20,db01.corp.local,5432,PostgreSQL,Data,prod,studio,pg-admin,critical,data,primary cluster",\n' +
    '].join("\\n");\n' +
    '\n' +
    '/** Expand "443,22" / "8000-8005" into a normalised port list. */\n' +
    'function expandPorts(raw: string): string[] {\n' +
    '  const out: string[] = [];\n' +
    '  for (const part of raw\n' +
    '    .split(/[,;|]/)\n' +
    '    .map((p) => p.trim())\n' +
    '    .filter(Boolean)) {\n' +
    '    const range = part.match(/^(\\d+)\\s*-\\s*(\\d+)$/);\n' +
    '    if (range) {\n' +
    '      const from = Number(range[1]);\n' +
    '      const to = Number(range[2]);\n' +
    '      if (to >= from && to - from <= 512) {\n' +
    '        for (let p = from; p <= to; p++) out.push(String(p));\n' +
    '        continue;\n' +
    '      }\n' +
    '    }\n' +
    '    out.push(part);\n' +
    '  }\n' +
    '  return out;\n' +
    '}\n' +
    '\n' +
    '/** Quote-aware single-line splitter (handles "443,22" inside a CSV cell). */\n' +
    'function splitRow(line: string, delim: string): string[] {\n' +
    '  if (delim === "\\t") return line.split("\\t").map((c) => c.trim());\n' +
    '  const cells: string[] = [];\n' +
    '  let cur = "";\n' +
    '  let quoted = false;\n' +
    '  for (let i = 0; i < line.length; i++) {\n' +
    '    const ch = line[i];\n' +
    `    if (ch === '"') {\n` +
    `      if (quoted && line[i + 1] === '"') {\n` +
    `        cur += '"';\n` +
    '        i++;\n' +
    '      } else quoted = !quoted;\n' +
    '      continue;\n' +
    '    }\n' +
    '    if (ch === delim && !quoted) {\n' +
    '      cells.push(cur.trim());\n' +
    '      cur = "";\n' +
    '      continue;\n' +
    '    }\n' +
    '    cur += ch;\n' +
    '  }\n' +
    '  cells.push(cur.trim());\n' +
    '  return cells;\n' +
    '}\n' +
    '\n' +
    'const columnAliases: Record<string, string[]> = {\n' +
    '  name: ["name", "target", "display_name", "hostname"],\n' +
    '  ip: ["ip", "address", "ipv4", "ipv6"],\n' +
    '  host: ["host", "fqdn", "dns"],\n' +
    '  ports: ["port", "ports", "service_port"],\n' +
    '  adapter: ["adapter", "driver", "connector"],\n' +
    '  group: ["group", "target_group", "folder"],\n' +
    '  tags: ["tags", "labels"],\n' +
    '  vaultScope: ["vault_scope", "scope", "credential_scope"],\n' +
    '  vaultName: ["vault_name", "credential", "credential_name"],\n' +
    '  risk: ["risk_level", "risk", "criticality"],\n' +
    '  owner: ["owner", "responsible"],\n' +
    '  notes: ["notes", "note", "description", "comment"],\n' +
    '};\n' +
    '\n' +
    '/** Parse CSV / TSV / plain host list into draft targets. */\n' +
    'export function parseTargetImport(text: string): Target[] {\n' +
    '  const lines = text\n' +
    '    .split(/\\r?\\n/)\n' +
    '    .map((l) => l.trim())\n' +
    '    .filter(Boolean);\n' +
    '  const first = lines[0];\n' +
    '  if (!first) return [];\n' +
    '  const delim = first.includes(",") ? "," : first.includes("\\t") ? "\\t" : "";\n' +
    '  const out: Target[] = [];\n' +
    '\n' +
    '  const draft = (patch: Partial<Target>): Target => ({\n' +
    '    ...emptyTarget(),\n' +
    '    id: `tgt-${Math.floor(1000 + Math.random() * 8999)}`,\n' +
    '    ...patch,\n' +
    '  });\n' +
    '\n' +
    '  if (!delim) {\n' +
    '    /* TXT shortcut — one host per line: ip, name, or ip:port */\n' +
    '    for (const line of lines) {\n' +
    '      const [addr, port] = line.split(":");\n' +
    '      const value = (addr ?? line).trim();\n' +
