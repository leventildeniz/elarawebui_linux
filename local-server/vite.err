    '  squad: "NetSec",\n' +
    '  role: "Operator",\n' +
    '  description: "",\n' +
    '  systemPrompt: "",\n' +
    '  modelId: "system_default",\n' +
    '  provider: "System Default",\n' +
    '  runtimePath: "/opt/elara/local-server/.venv/bin/python · Python 3.12.13",\n' +
    '  scriptPath: "",\n' +
    '  bridgeHost: "http://localhost",\n' +
    '  port: "3005",\n' +
    '  healthEndpoint: "/api/health",\n' +
    '  thinking: false,\n' +
    '  enabled: true,\n' +
    '  live: false,\n' +
    '  priority: 5,\n' +
    '  stopGraceMs: 5000,\n' +
    '  temperature: 0.2,\n' +
    '  topP: 0.85,\n' +
    '  repetitionPenalty: 1.25,\n' +
    '  maxTokens: 4096,\n' +
    '  contextWindow: 8192,\n' +
    '  stopSequences: [],\n' +
    '  customParams: [],\n' +
    '  skills: [],\n' +
    '  tools: [],\n' +
    '  adapters: [],\n' +
    '  targets: [],\n' +
    '  mcpServers: [],\n' +
    '  packs: [],\n' +
    '  rag: false,\n' +
    '  ragBrands: [],\n' +
    '  ragKeywords: "",\n' +
    '  icon: "Bot",\n' +
    '  avatar: { seed: "atlas", style: "prism", jewel: "sapphire" },\n' +
    '  stats: { calls: 0, success: 100, latencyMs: 0 },\n' +
    '};\n' +
    '\n' +
    'function read(): StudioAgent[] {\n' +
    '  if (typeof window === "undefined") return seedAgents;\n' +
    '  try {\n' +
    '    const raw = window.localStorage.getItem(KEY);\n' +
    '    if (!raw) return seedAgents;\n' +
    '    const parsed = JSON.parse(raw) as StudioAgent[];\n' +
    '    if (!Array.isArray(parsed) || !parsed.length) return seedAgents;\n' +
    '    return parsed.map((a) => ({ ...emptyAgent, ...a }));\n' +
    '  } catch {\n' +
    '    return seedAgents;\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    'function write(list: StudioAgent[]) {\n' +
    '  try {\n' +
    '    window.localStorage.setItem(KEY, JSON.stringify(list));\n' +
    '    window.dispatchEvent(new CustomEvent(EVT));\n' +
    '  } catch {\n' +
    '    /* ignore */\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    'function readRuns(): AgentRun[] {\n' +
    '  if (typeof window === "undefined") return seedRuns;\n' +
    '  try {\n' +
