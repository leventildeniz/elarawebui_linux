    '                p95: walk(s.ai.p95, 90, 160, 2400),\n' +
    '                ttft: walk(s.ai.ttft, 60, 90, 1400),\n' +
    '                hallucination: walk(s.ai.hallucination, 0.5, 0.1, 9),\n' +
