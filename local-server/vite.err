    pluginCode: 'import { useEffect, useMemo, useState } from "react";\n' +
      'import { createFileRoute, Link } from "@tanstack/react-router";\n' +
      'import { AnimatePresence, motion } from "motion/react";\n' +
      'import {\n' +
      '  Activity,\n' +
      '  Braces,\n' +
      '  Check,\n' +
      '  ChevronDown,\n' +
      '  History as HistoryIcon,\n' +
      '  Copy,\n' +
      '  Database,\n' +
      '  FileText,\n' +
      '  Folder,\n' +
      '  Layers,\n' +
      '  Link2,\n' +
      '  Play,\n' +
      '  Plus,\n' +
      '  Square,\n' +
      '  RefreshCw,\n' +
      '  Save,\n' +
      '  Search,\n' +
      '  Share2,\n' +
      '  Tag as TagIcon,\n' +
      '  Trash2,\n' +
      '  Type,\n' +
      '  Upload,\n' +
      '  Webhook,\n' +
      '  X,\n' +
      '  Zap,\n' +
      '} from "lucide-react";\n' +
      'import { Surface } from "@/components/sovereign/surface";\n' +
      'import { JewelButton, StatusDot, Tag } from "@/components/sovereign/primitives";\n' +
      'import { confirmAction } from "@/components/sovereign/confirm-dialog";\n' +
      'import {\n' +
      '  topEntities,\n' +
      '  useKnowledge,\n' +
      '  type KnowledgeSource,\n' +
      '  type SourceKind,\n' +
      '} from "@/lib/knowledge-store";\n' +
      'import { tuningSchema, useTuning, type Knob, type TuningGroup } from "@/lib/tuning-store";\n' +
      'import { gateAction } from "@/lib/approval-gate";\n' +
      'import { currentAccount } from "@/lib/group-store";\n' +
      'import { KnowledgeSpacesTab } from "@/components/sovereign/knowledge-spaces";\n' +
