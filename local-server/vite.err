  pluginCode: 'import { useCallback, useEffect, useState } from "react";\n' +
    'import { fetchApi } from "./api";\n' +
    '\n' +
    '/**\n' +
    ' * System Engine configuration — Intent Router + Orchestrator Bridge.\n' +
    " * Persisted in Postgres (app_system_config) under key 'engine_policy'.\n" +
    ' */\n' +
    '\n' +
    'export type ClassifierMode = "embedding" | "llm" | "hybrid";\n' +
    'export type RagMode = "auto" | "always" | "never";\n' +
    'export type GuardOverride = "auto" | "force-on" | "force-off";\n' +
    'export type RuntimeProvider = "legacy" | "custom";\n' +
    '\n' +
    'export const runtimePresets: Record<\n' +
    '  RuntimeProvider,\n' +
    '  { label: string; baseUrl: string; note: string }\n' +
    '> = {\n' +
    '  legacy: { label: "LEGACY", baseUrl: "http://127.0.0.1:11434", note: "Legacy HTTP endpoint" },\n' +
    '  custom: { label: "CUSTOM", baseUrl: "", note: "Your own endpoint" },\n' +
    '};\n' +
    '\n' +
    'export type EngineConfig = {\n' +
    '  /* runtime provider */\n' +
    '  runtimeProvider: RuntimeProvider;\n' +
    '  baseUrlOverride: string;\n' +
    '  activeModelId: string;\n' +
    '  /* intent router */\n' +
    '  bypassEnabled: boolean;\n' +
    '  similarity: number;\n' +
    '  classifier: ClassifierMode;\n' +
    '  classifierPrompt: string;\n' +
    '  ragMode: RagMode;\n' +
    '  /* orchestrator bridge */\n' +
    '  guard: GuardOverride;\n' +
    '  allowedAgents: string;\n' +
    '  allowedTools: string;\n' +
    '  disarmedTools: string;\n' +
    '  /* deny lists — empty = everything permitted */\n' +
    '  deniedAgents: string;\n' +
    '  deniedTools: string;\n' +
    '  deniedSkills: string;\n' +
    '};\n' +
    '\n' +
    'export const defaultClassifierPrompt =\n' +
    '  "Classify the user message below. If it needs the Library/RAG (technical docs, network, security, product/device configuration, error/log analysis, version, CVE, etc.), reply with a single word: RAG. If it is a greeting, social small-talk, or personal chit-chat, reply with a single word: CHAT. Output only RAG or CHAT — nothing else.";\n' +
    '\n' +
    'export const defaultEngine: EngineConfig = {\n' +
    '  runtimeProvider: "legacy",\n' +
    '  baseUrlOverride: "http://127.0.0.1:11434",\n' +
    '  activeModelId: "qwen2.5:72b",\n' +
    '  bypassEnabled: false,\n' +
    '  similarity: 0.35,\n' +
    '  classifier: "hybrid",\n' +
    '  classifierPrompt: defaultClassifierPrompt,\n' +
    '  ragMode: "auto",\n' +
    '  guard: "auto",\n' +
    '  allowedAgents: "",\n' +
    '  allowedTools: "",\n' +
    '  disarmedTools: "",\n' +
    '  deniedAgents: "",\n' +
    '  deniedTools: "",\n' +
    '  deniedSkills: "",\n' +
    '};\n' +
    '\n' +
    'export function useEngine() {\n' +
    '  const [config, setConfig] = useState<EngineConfig>(defaultEngine);\n' +
    '  const [loading, setLoading] = useState(true);\n' +
    '\n' +
    '  const loadData = useCallback(async () => {\n' +
    '    try {\n' +
    '      setLoading(true);\n' +
    '      const data = await fetchApi("/system/config/engine_policy");\n' +
    '      if (data && typeof data === "object") {\n' +
    '        setConfig({ ...defaultEngine, ...data });\n' +
    '      }\n' +
    '    } catch (e) {\n' +
    '      console.error("Failed to load engine policy", e);\n' +
    '    } finally {\n' +
    '      setLoading(false);\n' +
    '    }\n' +
    '  }, []);\n' +
    '\n' +
    '  useEffect(() => {\n' +
    '    loadData();\n' +
    '  }, [loadData]);\n' +
    '\n' +
    '  const update = useCallback(\n' +
    '    async (patch: Partial<EngineConfig>) => {\n' +
    '      const next = { ...config, ...patch };\n' +
    '      setConfig(next); // optimistic\n' +
    '      try {\n' +
    '        await fetchApi("/system/config/engine_policy", {\n' +
    '          method: "PUT",\n' +
    '          body: JSON.stringify(next),\n' +
    '        });\n' +
    '      } catch (e) {\n' +
    '        console.error("Failed to save engine policy", e);\n' +
    '        loadData(); // Resync on error\n' +
    '      }\n' +
    '    },\n' +
    '    [config, loadData],\n' +
    '  );\n' +
    '\n' +
    '  const reset = useCallback(async () => {\n' +
    '    const keys: (keyof EngineConfig)[] = [\n' +
    '      "allowedAgents",\n' +
    '      "allowedTools",\n' +
    '      "disarmedTools",\n' +
    '      "deniedAgents",\n' +
    '      "deniedTools",\n' +
    '      "deniedSkills",\n' +
    '    ];\n' +
    '    \n' +
    '    const patch = Object.fromEntries(keys.map((k) => [k, defaultEngine[k]]));\n' +
    '    await update(patch);\n' +
    '  }, [update]);\n' +
    '\n' +
    '  return { config, update, reset, loading };\n' +
    '}\n' +
    '  const reset = useCallback((keys: (keyof EngineConfig)[]) => {\n' +
    '    const patch = Object.fromEntries(\n' +
    '      keys.map((k) => [k, defaultEngine[k]]),\n' +
    '    ) as Partial<EngineConfig>;\n' +
    '    const next = { ...read(), ...patch };\n' +
    '    try {\n' +
    '      window.localStorage.setItem(KEY, JSON.stringify(next));\n' +
    '      window.dispatchEvent(new CustomEvent(EVT));\n' +
    '    } catch {\n' +
    '      /* ignore */\n' +
    '    }\n' +
    '    setConfig(next);\n' +
    '  }, []);\n' +
    '\n' +
    '  return { config, update, reset };\n' +
    '}\n',
