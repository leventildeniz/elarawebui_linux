      '    </label>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      'function Toggle({ on, onToggle, label }: { on: boolean; onToggle: () => void; label?: string }) {\n' +
      '  return (\n' +
      '    <button\n' +
      '      type="button"\n' +
      '      onClick={onToggle}\n' +
      '      className="flex items-center gap-2"\n' +
      '      aria-pressed={on}\n' +
      '      aria-label={label ?? "toggle"}\n' +
      '      title={label ?? "toggle"}\n' +
      '    >\n' +
      '      <span\n' +
      '        className={cn(\n' +
      '          "relative h-5 w-9 rounded-full border transition-colors duration-150",\n' +
      '          on ? "border-emerald/50 bg-emerald/25" : "border-white/10 bg-white/[0.05]",\n' +
      '        )}\n' +
      '      >\n' +
      '        <motion.span\n' +
      '          layout\n' +
      '          transition={{ duration: 0.16, ease: "easeInOut" }}\n' +
      '          className={cn(\n' +
