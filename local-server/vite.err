    '  stats: { calls: 0, success: 100, latencyMs: 0 },\n' +
    '};\n' +
    '\n' +
    'function read(): StudioAgent[] {\n' +
    '  if (typeof window === "undefined") return seedAgents;\n' +
    '  try {\n' +
    '    const raw = window.localStorage.getItem(KEY);\n' +
    '    if (!raw) return seedAgents;\n' +
    '    const parsed = JSON.parse(raw) as StudioAgent[];\n' +
    '    if (!Array.isArray(parsed) || !parsed.length) return seedAgents;\n' +
    '    return parsed.map((a) => ({ ...emptyAgent, ...a }));\n' +
