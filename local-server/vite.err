      '\n' +
      '  return (\n' +
      '    <Surface\n' +
      '      title="Knowledge Hub (RAG)"\n' +
      '      meta="PDF · TXT · URL · Drive · auto-extract .zip/.tar/.rar"\n' +
      '      wide\n' +
      '      action={\n' +
      '        <div className="flex items-center gap-1.5">\n' +
      '          {tab === "control" && (\n' +
      '            <JewelButton size="sm" onClick={() => setAddOpen(true)}>\n' +
      '              <Plus size={13} /> Add Source\n' +
      '            </JewelButton>\n' +
      '          )}\n' +
      '        </div>\n' +
      '      }\n' +
      '    >\n' +
      '      <AnimatePresence mode="wait">\n' +
      '        <motion.div\n' +
      '          key={tab}\n' +
      '          initial={{ opacity: 0, y: 8 }}\n' +
      '          animate={{ opacity: 1, y: 0 }}\n' +
      '          exit={{ opacity: 0, y: -6 }}\n' +
      '          transition={{ duration: 0.16, ease: [0.22, 1, 0.36, 1] }}\n' +
