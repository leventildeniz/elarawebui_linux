      '          )}\n' +
      '        </div>\n' +
      '      }\n' +
      '    >\n' +
      '      <AnimatePresence mode="wait">\n' +
      '        <motion.div\n' +
      '          key={tab}\n' +
      '          initial={{ opacity: 0, y: 8 }}\n' +
      '          animate={{ opacity: 1, y: 0 }}\n' +
      '          exit={{ opacity: 0, y: -6 }}\n' +
      '          transition={{ duration: 0.16, ease: [0.22, 1, 0.36, 1] }}\n' +
