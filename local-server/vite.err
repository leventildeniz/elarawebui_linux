    ' */\n' +
    '\n' +
    'export type ClassifierMode = "embedding" | "llm" | "hybrid";\n' +
    'export type RagMode = "auto" | "always" | "never";\n' +
    'export type GuardOverride = "auto" | "force-on" | "force-off";\n' +
    'export type RuntimeProvider = "legacy" | "custom";\n' +
    '\n' +
