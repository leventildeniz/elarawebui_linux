      'import { createFileRoute } from "@tanstack/react-router";\n' +
      'import { motion } from "motion/react";\n' +
      'import { Cpu, Database, Pause, Play, Plus, X } from "lucide-react";\n' +
      'import { Surface, Meter } from "@/components/sovereign/surface";\n' +
      'import { Sheen, StatusDot, Tag } from "@/components/sovereign/primitives";\n' +
      'import { useAgents } from "@/lib/agent-store";\n' +
      'import { useWorkflows } from "@/lib/workflow-store";\n' +
      'import { useChains } from "@/lib/orchestration-store";\n' +
      'import { useSkills } from "@/lib/skill-store";\n' +
      'import { useMcp } from "@/lib/mcp-store";\n' +
      'import { useForge } from "@/lib/forge-store";\n' +
      'import { useCapabilities } from "@/lib/capability-store";\n' +
      'import { useIdentity } from "@/lib/group-store";\n' +
      'import {\n' +
      '  accountUsage,\n' +
      '  agentSample,\n' +
      '  dbTableSample,\n' +
      '  dbTables,\n' +
      '  formatUptime,\n' +
      '  providerUsage,\n' +
      '  useLiveTelemetry,\n' +
      '} from "@/lib/telemetry-live";\n' +
      'import { useTelemetryBoards, type BoardEntry, type BoardKind } from "@/lib/telemetry-board-store";\n' +
      'import { useEngine } from "@/lib/engine-store";\n' +
      '\n' +
      'import { cn } from "@/lib/utils";\n' +
      '\n' +
      'type View = "system" | "operators" | "database" | "agents";\n' +
      '\n' +
      'const views: View[] = ["system", "operators", "database", "agents"];\n' +
      '\n' +
      'export const Route = createFileRoute("/fleet")({\n' +
      '  validateSearch: (search: Record<string, unknown>): { view?: View } => ({\n' +
      '    view: views.includes(search["view"] as View) ? (search["view"] as View) : "system",\n' +
      '  }),\n' +
      '\n' +
      '  head: () => ({\n' +
      '    meta: [\n' +
      '      { title: "Fleet Telemetry — Elara Sovereign Studio" },\n' +
      '      {\n' +
      '        name: "description",\n' +
      '        content:\n' +
      '          "Live cockpit for the Sovereign runtime: host vitals, database health, connected operators, inventory and per-agent telemetry.",\n' +
      '      },\n' +
      '      { property: "og:title", content: "Fleet Telemetry — Elara Sovereign Studio" },\n' +
      '      {\n' +
      '        property: "og:description",\n' +
      '        content: "Host vitals, AI quality signals and live per-agent telemetry in one cockpit.",\n' +
      '      },\n' +
      '      { property: "og:type", content: "website" },\n' +
      '      { name: "twitter:card", content: "summary_large_image" },\n' +
      '    ],\n' +
      '  }),\n' +
      '  component: FleetView,\n' +
      '});\n' +
      '\n' +
      '/* ------------------------------------------------------------- primitives */\n' +
      '\n' +
      'function Card({\n' +
      '  label,\n' +
      '  meta,\n' +
      '  children,\n' +
      '  className,\n' +
      '}: {\n' +
      '  label: string;\n' +
      '  meta?: string;\n' +
      '  children: React.ReactNode;\n' +
      '  className?: string;\n' +
      '}) {\n' +
      '  return (\n' +
      '    <motion.section\n' +
      '      initial={{ opacity: 0, y: 10 }}\n' +
      '      animate={{ opacity: 1, y: 0 }}\n' +
      '      transition={{ duration: 0.28, ease: [0.22, 1, 0.36, 1] }}\n' +
      '      className={`rounded-[12px] border border-white/[0.06] bg-white/[0.015] px-5 py-4 ${className ?? ""}`}\n' +
      '    >\n' +
      '      <div className="mb-4 flex items-baseline justify-between gap-3">\n' +
      '        <span className="mono-label">{label}</span>\n' +
      '        {meta && <span className="font-mono text-[10.5px] text-muted-foreground/45">{meta}</span>}\n' +
      '      </div>\n' +
      '      {children}\n' +
      '    </motion.section>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      'function Spark({ data, tone = "sapphire" }: { data: number[]; tone?: string }) {\n' +
      '  const path = useMemo(() => {\n' +
      '    if (!data.length) return "";\n' +
      '    const min = Math.min(...data);\n' +
      '    const max = Math.max(...data);\n' +
      '    const span = max - min || 1;\n' +
      '    return data\n' +
      '      .map((v, i) => {\n' +
      '        const x = (i / (data.length - 1)) * 100;\n' +
      '        const y = 28 - ((v - min) / span) * 26 - 1;\n' +
      '        return `${i === 0 ? "M" : "L"}${x.toFixed(2)},${y.toFixed(2)}`;\n' +
      '      })\n' +
      '      .join(" ");\n' +
      '  }, [data]);\n' +
      '\n' +
      '  return (\n' +
      '    <svg viewBox="0 0 100 28" preserveAspectRatio="none" className="h-8 w-full">\n' +
      '      <path\n' +
      '        d={path}\n' +
      '        fill="none"\n' +
      '        stroke={`var(--${tone})`}\n' +
      '        strokeWidth={1.2}\n' +
      '        vectorEffect="non-scaling-stroke"\n' +
      '        style={{ filter: `drop-shadow(0 0 5px var(--${tone}))` }}\n' +
      '      />\n' +
      '    </svg>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      'function Vital({\n' +
      '  label,\n' +
      '  value,\n' +
      '  unit,\n' +
      '  pct,\n' +
      '  tone = "sapphire",\n' +
      '  series,\n' +
      '  sub,\n' +
      '}: {\n' +
      '  label: string;\n' +
      '  value: string;\n' +
      '  unit?: string;\n' +
      '  pct?: number;\n' +
      '  tone?: string;\n' +
      '  series?: number[];\n' +
      '  sub?: string;\n' +
      '}) {\n' +
      '  return (\n' +
      '    <div className="rounded-[10px] border border-white/[0.05] bg-white/[0.012] px-4 py-3.5">\n' +
      '      <div className="flex items-baseline justify-between">\n' +
      '        <span className="mono-label">{label}</span>\n' +
      '        {sub && <span className="font-mono text-[10px] text-muted-foreground/45">{sub}</span>}\n' +
      '      </div>\n' +
      '      <div className="mt-2 flex items-baseline gap-1.5">\n' +
      '        <span\n' +
      '          className="font-mono text-[22px] leading-none tracking-tight"\n' +
      '          style={{ color: `var(--${tone})`, textShadow: `0 0 18px var(--${tone})` }}\n' +
      '        >\n' +
      '          {value}\n' +
      '        </span>\n' +
      '        {unit && <span className="font-mono text-[11px] text-muted-foreground/55">{unit}</span>}\n' +
      '      </div>\n' +
      '      {series ? (\n' +
      '        <div className="mt-1.5 -mb-1">\n' +
      '          <Spark data={series} tone={tone} />\n' +
      '        </div>\n' +
      '      ) : pct !== undefined ? (\n' +
      '        <div className="mt-3">\n' +
      '          <Meter value={pct} tone={tone} />\n' +
      '        </div>\n' +
      '      ) : null}\n' +
      '    </div>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      'function KV({ k, v, tone }: { k: string; v: string; tone?: string | undefined }) {\n' +
      '  return (\n' +
      '    <div className="flex items-center justify-between gap-4 py-[7px]">\n' +
      '      <span className="mono-label">{k}</span>\n' +
      '      <span\n' +
      '        className="font-mono text-[12.5px]"\n' +
      '        style={tone ? { color: `var(--${tone})` } : { color: "rgba(226,232,240,0.9)" }}\n' +
      '      >\n' +
      '        {v}\n' +
      '      </span>\n' +
      '    </div>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      'const toneFor = (v: number, warn: number, bad: number) =>\n' +
      '  v >= bad ? "ruby" : v >= warn ? "topaz" : "emerald";\n' +
      '\n' +
      '/* ------------------------------------------------------------------ route */\n' +
      '\n' +
      'function FleetView() {\n' +
      '  const { view } = Route.useSearch();\n' +
      '  if (view === "agents") return <AgentsTelemetry />;\n' +
      '  if (view === "operators") return <OperatorsTelemetry />;\n' +
      '  if (view === "database") return <DatabaseTelemetry />;\n' +
      '  return <SystemGeneral />;\n' +
      '}\n' +
      '\n' +
      '/* --------------------------------------------------------- system general */\n' +
      '\n' +
      'function SystemGeneral() {\n' +
      '  const [paused, setPaused] = useState(false);\n' +
      '  const t = useLiveTelemetry(paused);\n' +
      '  const { agents } = useAgents();\n' +
      '  const { workflows } = useWorkflows();\n' +
      '  const { chains } = useChains();\n' +
      '  const { skills } = useSkills();\n' +
      '  const mcp = useMcp();\n' +
      '  const { items: tools } = useForge();\n' +
      '  const { packs } = useCapabilities();\n' +
      '  const { accounts } = useIdentity();\n' +
      '\n' +
      '  const h = t.host;\n' +
      '  const ai = t.ai;\n' +
      '\n' +
      '  const liveAgents = agents.filter((a) => a.enabled && a.live).length;\n' +
      '  const activeWorkflows = workflows.filter((w) => w.status !== "draft").length;\n' +
      '  const mcpClients = mcp.clients ?? [];\n' +
      '  const online = accounts.filter((a) => !a.locked && a.status === "active");\n' +
      '\n' +
      '  return (\n' +
      '    <Surface\n' +
      '      title="System General"\n' +
      '      meta={`live sampler · 2s interval · uptime ${formatUptime(h.uptimeSec)}`}\n' +
      '      wide\n' +
      '      crumb="Fleet Telemetry"\n' +
      '      action={\n' +
      '        <button\n' +
      '          onClick={() => setPaused((p) => !p)}\n' +
      '          className="flex items-center gap-2 rounded-lg border border-white/[0.08] bg-raised/40 px-3 py-[6px] font-mono text-[11.5px] text-muted-foreground/80 transition-colors hover:border-sapphire/40 hover:text-foreground"\n' +
      '        >\n' +
      '          {paused ? <Play className="h-3.5 w-3.5" /> : <Pause className="h-3.5 w-3.5" />}\n' +
      '          {paused ? "resume stream" : "pause stream"}\n' +
      '        </button>\n' +
      '      }\n' +
      '    >\n' +
      '      <div className="space-y-8">\n' +
      '        {/* ---------------------------------------------------- host vitals */}\n' +
      '        <Card\n' +
      '          label="host vitals"\n' +
      '          meta={`sov-prod-01 · load ${h.loadAvg.map((l) => l.toFixed(2)).join(" / ")}`}\n' +
      '        >\n' +
      '          <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">\n' +
      '            <Vital\n' +
      '              label="cpu"\n' +
      '              value={h.cpu.toFixed(0)}\n' +
      '              unit="%"\n' +
      '              tone={toneFor(h.cpu, 70, 88)}\n' +
      '              series={t.history.cpu}\n' +
      '              sub={`${h.cores.length} cores`}\n' +
      '            />\n' +
      '            <Vital\n' +
      '              label="gpu"\n' +
      '              value={h.gpu.toFixed(0)}\n' +
      '              unit="%"\n' +
      '              tone={toneFor(h.gpu, 80, 93)}\n' +
      '              series={t.history.gpu}\n' +
      '              sub={`${h.gpuTemp.toFixed(0)}°C`}\n' +
      '            />\n' +
      '            <Vital\n' +
      '              label="memory"\n' +
      '              value={((h.ram / 100) * h.ramTotalGb).toFixed(1)}\n' +
      '              unit={`/ ${h.ramTotalGb} GB`}\n' +
      '              tone={toneFor(h.ram, 75, 90)}\n' +
      '              series={t.history.ram}\n' +
      '              sub={`swap ${h.swap.toFixed(1)}%`}\n' +
      '            />\n' +
      '            <Vital\n' +
      '              label="vram"\n' +
      '              value={h.vram.toFixed(0)}\n' +
      '              unit="%"\n' +
      '              pct={h.vram}\n' +
      '              tone={toneFor(h.vram, 80, 93)}\n' +
      '              sub="48 GB pool"\n' +
      '            />\n' +
      '          </div>\n' +
      '\n' +
      '          <div className="mt-4 rounded-[10px] border border-white/[0.05] bg-white/[0.012] px-4 py-3.5">\n' +
      '            <div className="mb-3 flex items-center gap-2">\n' +
      '              <Cpu className="h-3.5 w-3.5 text-sapphire" strokeWidth={1.6} />\n' +
      '              <span className="mono-label">per-core load</span>\n' +
      '            </div>\n' +
      '            <div className="flex items-end gap-1.5">\n' +
      '              {h.cores.map((c, i) => (\n' +
      '                <div key={i} className="flex-1">\n' +
      '                  <div className="flex h-14 items-end">\n' +
      '                    <motion.div\n' +
      '                      animate={{ height: `${Math.max(4, c)}%` }}\n' +
      '                      transition={{ duration: 0.34, ease: [0.22, 1, 0.36, 1] }}\n' +
      '                      className="w-full rounded-[3px]"\n' +
      '                      style={{\n' +
      '                        background: `var(--${toneFor(c, 70, 90)})`,\n' +
      '                        boxShadow: `0 0 10px -3px var(--${toneFor(c, 70, 90)})`,\n' +
      '                        opacity: 0.85,\n' +
      '                      }}\n' +
      '                    />\n' +
      '                  </div>\n' +
      '                  <div className="mt-1.5 text-center font-mono text-[9px] text-muted-foreground/40">\n' +
      '                    {i}\n' +
      '                  </div>\n' +
      '                </div>\n' +
      '              ))}\n' +
      '            </div>\n' +
      '          </div>\n' +
