    'import { useSnippets } from "@/lib/snippet-store";\n' +
    'import { refKey } from "@/lib/registry-store";\n' +
    'import { routingModes, useProviders } from "@/lib/provider-store";\n' +
    'import { useAccess } from "@/lib/rbac-store";\n' +
    'import { EntityAvatar } from "@/components/sovereign/identity";\n' +
    'import { FileHoverPreview } from "@/components/sovereign/file-preview";\n' +
    '\n' +
    'export type Attachment = {\n' +
    '  id: string;\n' +
    '  name: string;\n' +
    '  size: number;\n' +
    '  kind: "image" | "file" | "audio";\n' +
    '  mime?: string;\n' +
    '  url?: string | undefined;\n' +
    '};\n' +
    '\n' +
    'export type Mention = {\n' +
    '  id: string;\n' +
    '  label: string;\n' +
    '  kind: "agent" | "tool" | "skill" | "mcp";\n' +
    '  tone: string;\n' +
    '};\n' +
    '\n' +
    '/** Chat dispatch prefixes: @ agent · / tool · ! skill · # mcp */\n' +
    'export const mentionPrefix: Record<Mention["kind"], string> = {\n' +
    '  agent: "@",\n' +
    '  tool: "/",\n' +
    '  skill: "!",\n' +
    '  mcp: "#",\n' +
    '};\n' +
    '\n' +
    'const prefixKind: Record<"@" | "/" | "!" | "#" | ">", Mention["kind"] | "snippet"> = {\n' +
    '  "@": "agent",\n' +
    '  "/": "tool",\n' +
    '  "!": "skill",\n' +
    '  "#": "mcp",\n' +
    '  ">": "snippet",\n' +
    '};\n' +
    '\n' +
    'const toneText: Record<string, string> = {\n' +
    '  sapphire: "text-sapphire",\n' +
    '  emerald: "text-emerald",\n' +
    '  amethyst: "text-amethyst",\n' +
    '  topaz: "text-topaz",\n' +
    '  ruby: "text-ruby",\n' +
    '};\n' +
    '\n' +
    'export function useComposerAttachments() {\n' +
    '  const [attachments, setAttachments] = useState<Attachment[]>([]);\n' +
    '  /** Signatures already attached — guards against duplicate paste/drop events. */\n' +
    '  const seen = useRef(new Set<string>());\n' +
    '  const addFiles = (files: FileList | File[]) => {\n' +
    '    const fresh = Array.from(files).filter((f) => {\n' +
    '      const sig = `${f.name}|${f.size}|${f.lastModified}|${f.type}`;\n' +
    '      if (seen.current.has(sig)) return false;\n' +
    '      seen.current.add(sig);\n' +
    '      setTimeout(() => seen.current.delete(sig), 1500);\n' +
    '      return true;\n' +
    '    });\n' +
    '    const next = fresh.map((f) => ({\n' +
    '      id: `${f.name}-${f.size}-${Math.random().toString(36).slice(2, 7)}`,\n' +
    '      name: f.name,\n' +
    '      size: f.size,\n' +
    '      kind: (f.type.startsWith("image/")\n' +
    '        ? "image"\n' +
    '        : f.type.startsWith("audio/")\n' +
    '          ? "audio"\n' +
    '          : "file") as Attachment["kind"],\n' +
    '      mime: f.type || "application/octet-stream",\n' +
    '      url: typeof URL !== "undefined" ? URL.createObjectURL(f) : undefined,\n' +
    '    }));\n' +
    '\n' +
    '    if (next.length) setAttachments((a) => [...a, ...next]);\n' +
    '  };\n' +
    '  const remove = (id: string) =>\n' +
    '    setAttachments((a) => {\n' +
    '      /* release the object URL of a chip that never got sent */\n' +
    '      const gone = a.find((x) => x.id === id);\n' +
    '      if (gone?.url && typeof URL !== "undefined") URL.revokeObjectURL(gone.url);\n' +
    '      return a.filter((x) => x.id !== id);\n' +
    '    });\n' +
    '  const clear = () => setAttachments([]);\n' +
    '  return { attachments, addFiles, remove, clear };\n' +
    '}\n' +
    '\n' +
    'function formatSize(bytes: number) {\n' +
    '  if (bytes < 1024) return `${bytes} B`;\n' +
    '  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;\n' +
    '  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;\n' +
    '}\n' +
    '\n' +
    'type MenuTab = "attachment" | "agent" | "tool" | "skill" | "mcp" | "snippet";\n' +
    '\n' +
    'export type Effort = "none" | "low" | "medium" | "high";\n' +
    '\n' +
    'const efforts: { id: Effort; hint: string }[] = [\n' +
    '  { id: "none", hint: "Instant, no reasoning" },\n' +
    '  { id: "low", hint: "Light reasoning pass" },\n' +
    '  { id: "medium", hint: "Balanced deliberation" },\n' +
    '  { id: "high", hint: "Deep, multi-step reasoning" },\n' +
    '];\n' +
    '\n' +
    'const effortTone: Record<Effort, string> = {\n' +
    '  none: "text-muted-foreground/60",\n' +
    '  low: "text-emerald",\n' +
    '  medium: "text-topaz",\n' +
    '  high: "text-amethyst",\n' +
    '};\n' +
    '\n' +
    '/** Compact context-window gauge shown in the composer toolbar. */\n' +
    'function ContextGauge({ used, total }: { used: number; total: number }) {\n' +
    '  const pct = total > 0 ? Math.min(100, (used / total) * 100) : 0;\n' +
    '  const tone =\n' +
    '    pct >= 90\n' +
    '      ? "var(--ruby)"\n' +
    '      : pct >= 70\n' +
    '        ? "var(--topaz)"\n' +
    '        : pct >= 35\n' +
    '          ? "var(--sapphire)"\n' +
    '          : "var(--emerald)";\n' +
    '  const fmt = (n: number) =>\n' +
    '    n >= 1_000_000\n' +
    '      ? `${(n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 1)}M`\n' +
    '      : n >= 1000\n' +
    '        ? `${(n / 1000).toFixed(n >= 100_000 || n % 1000 === 0 ? 0 : 1)}k`\n' +
    '        : `${n}`;\n' +
    '\n' +
    '  return (\n' +
    '    <span\n' +
    '      title={`Context: ${used.toLocaleString()} / ${total.toLocaleString()} tokens (${pct.toFixed(1)}%)`}\n' +
    '      className="ml-1.5 inline-flex items-center gap-2 rounded-lg px-2 py-1.5 transition-colors hover:bg-raised/50"\n' +
    '    >\n' +
    '      <span className="relative block h-1 w-14 overflow-hidden rounded-full bg-border/70">\n' +
    '        <span\n' +
    '          className="absolute inset-y-0 left-0 rounded-full transition-[width] duration-300"\n' +
    '          style={{\n' +
    '            width: `${Math.max(pct, used > 0 ? 3 : 0)}%`,\n' +
    '            background: tone,\n' +
    '            boxShadow: `0 0 8px -1px ${tone}`,\n' +
    '          }}\n' +
    '        />\n' +
    '      </span>\n' +
    '      <span className="font-mono text-[10.5px] tracking-[0.14em] text-muted-foreground/70">\n' +
    '        <span style={{ color: tone }}>{fmt(used)}</span>\n' +
    '        <span className="opacity-50">/{fmt(total)}</span>\n' +
    '      </span>\n' +
    '    </span>\n' +
    '  );\n' +
    '}\n' +
    '\n' +
    'export function Composer({\n' +
    '  value,\n' +
    '  onChange,\n' +
    '  onSend,\n' +
    '  attachments,\n' +
    '  addFiles,\n' +
    '  removeAttachment,\n' +
    '  onPurge,\n' +
    '  onCompactContext,\n' +
    '  streaming,\n' +
    '  onStop,\n' +
    '  onEffortChange,\n' +
    '  onModelChange,\n' +
    '  contextTokens = 0,\n' +
    '  zen = false,\n' +
    '  onZenToggle,\n' +
    '  pinnedContext = "",\n' +
    '  onPinContext,\n' +
    '  webSearch = false,\n' +
    '  onWebSearchToggle,\n' +
    '}: {\n' +
    '  value: string;\n' +
    '  onChange: (v: string) => void;\n' +
    '  onSend: (mentions: Mention[]) => void;\n' +
    '  attachments: Attachment[];\n' +
    '  addFiles: (files: FileList | File[]) => void;\n' +
    '  removeAttachment: (id: string) => void;\n' +
    '  onPurge?: () => void;\n' +
    '  onCompactContext?: () => void;\n' +
    '  streaming?: boolean;\n' +
    '  onStop?: () => void;\n' +
    '  onEffortChange?: (e: Effort) => void;\n' +
    '  onModelChange?: (m: string) => void;\n' +
    "  /** Tokens already committed to the active thread's context. */\n" +
    '  contextTokens?: number;\n' +
    '  /** Zen mode toggle from the parent shell. */\n' +
    '  zen?: boolean;\n' +
    '  onZenToggle?: () => void;\n' +
    '  /** Thread-level pinned context for the toolbar indicator. */\n' +
    '  pinnedContext?: string;\n' +
    '  onPinContext?: () => void;\n' +
    '  /** Web search toggle for the current turn. */\n' +
    '  webSearch?: boolean;\n' +
    '  onWebSearchToggle?: () => void;\n' +
    '}) {\n' +
    '  const inputRef = useRef<HTMLTextAreaElement>(null);\n' +
    '  const fileRef = useRef<HTMLInputElement>(null);\n' +
    '  const cameraRef = useRef<HTMLInputElement>(null);\n' +
    '  const wrapRef = useRef<HTMLDivElement>(null);\n' +
    '  const [menu, setMenu] = useState(false);\n' +
    '  const [tab, setTab] = useState<MenuTab>("attachment");\n' +
    '  const [search, setSearch] = useState("");\n' +
    '  const [emoji, setEmoji] = useState(false);\n' +
    '  const [recording, setRecording] = useState(false);\n' +
    '  const [mentions, setMentions] = useState<Mention[]>([]);\n' +
    '  const [trigger, setTrigger] = useState<{\n' +
    '    kind: Mention["kind"] | "snippet";\n' +
    '    query: string;\n' +
    '    start: number;\n' +
    '  } | null>(null);\n' +
    '  const [liveCall, setLiveCall] = useState(false);\n' +
    '  const [effort, setEffort] = useState<Effort>("high");\n' +
    '  const [effortOpen, setEffortOpen] = useState(false);\n' +
    '  const { activeId: defaultId, models } = useModels();\n' +
    '  const { agents } = useAgents();\n' +
    '  const { skills } = useSkills();\n' +
    '  const tools = useToolUniverse();\n' +
    '  const { clients: mcpClients } = useMcp();\n' +
    '  const { snippets, add: addSnippet, remove: removeSnippet } = useSnippets();\n' +
    '  \n' +
    '  /** `#server.tool` exposures offered by registered MCP clients. */\n' +
    '  const mcpTools = mcpClients\n' +
    '    .filter((c) => c.enabled && (c.status === "ready" || c.status === "connected"))\n' +
    '    .flatMap((c) => {\n' +
    '      const catalog = Array.isArray(c.toolCatalog) ? c.toolCatalog : [];\n' +
    '      return catalog.map((tool: any) => ({\n' +
    '        id: `${c.id}.${tool.name}`,\n' +
    '        name: tool.name,\n' +
    '        meta: c.name,\n' +
    '        tone: "topaz",\n' +
    '      }));\n' +
    '    });\n' +
    '  const { models: registry, defaultId } = useModels();\n' +
    '  const models = registry.filter((m) => m.enabled);\n' +
    '  const [modelId, setModelId] = useState<string | null>(null);\n' +
    '  const model = models.find((m) => m.id === (modelId ?? defaultId)) ?? models[0];\n' +
    '  const [effortSub, setEffortSub] = useState(false);\n' +
    '  const { providers, routing } = useProviders();\n' +
    '  const { sovereign } = useAccess();\n' +
    '  const [localRoutingMode, setLocalRoutingMode] = useState<string | null>(null);\n' +
    '  const llmProviders = providers.filter((p) => p.kind === "llm" && p.active);\n' +
    '  const [routeOpen, setRouteOpen] = useState(false);\n' +
    '  const [manualProvider, setManualProvider] = useState<string | null>(null);\n' +
    '  const canOverride = routing.allowUserOverride || sovereign;\n' +
    '\n' +
    '  const currentMode = localRoutingMode ?? routing.mode;\n' +
    '  const activeMode = routingModes.find((m) => m.key === currentMode);\n' +
    '  const manualBlocked =\n' +
    '    currentMode === "manual_only" && !llmProviders.some((p) => p.id === manualProvider);\n' +
    '\n' +
    '  const closeAllMenus = () => {\n' +
    '    setMenu(false);\n' +
    '    setEmoji(false);\n' +
    '    setEffortOpen(false);\n' +
    '    setEffortSub(false);\n' +
    '    setRouteOpen(false);\n' +
    '  };\n' +
    '\n' +
    '  useEffect(() => {\n' +
    '    const onDoc = (e: MouseEvent) => {\n' +
    '      if (!wrapRef.current?.contains(e.target as Node)) closeAllMenus();\n' +
    '    };\n' +
    '    const onKey = (e: KeyboardEvent) => {\n' +
