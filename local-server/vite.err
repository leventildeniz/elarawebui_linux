    '  "markdown-report",\n' +
    '  "pii-redactor",\n' +
    '  "config-diff",\n' +
    '  "packet-triage",\n' +
    '  "cve-correlate",\n' +
    '  "cta-microcopy",\n' +
    '  "sql-analyst",\n' +
    '];\n' +
    '\n' +
    'export const toolCatalog = [\n' +
    '  "web.fetch",\n' +
    '  "sql.query",\n' +
    '  "fs.write",\n' +
    '  "vector.search",\n' +
    '  "ssh.exec",\n' +
    '  "pcap.parse",\n' +
    '  "http.probe",\n' +
    '  "vault.read",\n' +
    '];\n' +
    '\n' +
    'export const adapterCatalog = ["Cloudflare", "Checkpoint", "X.com", "RSS", "Splunk", "Jira"];\n' +
