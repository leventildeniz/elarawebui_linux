      '    value: number;\n' +
      '    tone?: "ruby" | "topaz" | "emerald" | undefined;\n' +
      '  }[] = [\n' +
      '    { label: "Chunks", value: k.health.chunks },\n' +
      '    { label: "FTS NULL", value: k.health.ftsNull, tone: k.health.ftsNull ? "topaz" : undefined },\n' +
      '    { label: "Embed OK", value: k.health.embedOk, tone: "emerald" },\n' +
      '    { label: "Embed Pending", value: k.health.embedPending },\n' +
      '    { label: "In Progress", value: k.health.inProgress },\n' +
      '    { label: "Stale", value: k.health.stale, tone: k.health.stale ? "topaz" : undefined },\n' +
      '    {\n' +
      '      label: "Embed Error",\n' +
      '      value: k.health.embedError,\n' +
      '      tone: k.health.embedError ? "ruby" : undefined,\n' +
      '    },\n' +
      '    { label: "Sources", value: k.sources.length },\n' +
      '    { label: "Parse OK", value: k.health.parseOk },\n' +
      '    { label: "Parse Low", value: k.health.parseLow },\n' +
      '  ];\n' +
      '\n' +
      '  return (\n' +
      '    <div className="space-y-6">\n' +
      '      <Panel>\n' +
      '        <div className="flex flex-wrap items-center justify-between gap-3">\n' +
      '          <div className="flex items-center gap-2.5">\n' +
      '            <Activity size={15} className="text-sapphire" />\n' +
      '            <h2 className="text-[16.5px] font-medium tracking-tight text-foreground">\n' +
      '              RAG Control &amp; Health\n' +
      '            </h2>\n' +
      '            <Tag tone="platinum">single source of truth</Tag>\n' +
      '          </div>\n' +
      '          <button\n' +
      '            type="button"\n' +
      '            onClick={refresh}\n' +
      '            className="flex items-center gap-2 rounded-md px-2 py-1 text-[12.5px] text-muted-foreground transition-colors hover:text-foreground"\n' +
      '          >\n' +
      '            <RefreshCw size={13} className={cn(spin && "animate-spin")} /> Refresh\n' +
      '          </button>\n' +
      '        </div>\n' +
      '\n' +
      '        <div className="mt-5 space-y-2.5">\n' +
      '          <ToggleRow\n' +
      '            title="Auto Ingestion"\n' +
      '            badge={k.autoIngestion ? "ON · watching disk" : "OFF · Manual sync only"}\n' +
      '            badgeTone={k.autoIngestion ? "emerald" : "ruby"}\n' +
      '            hint="OFF means disk changes never start ingestion by themselves. Sources are indexed only from explicit Add Source / Sync actions."\n' +
      '            checked={k.autoIngestion}\n' +
      '            onChange={(v) => k.patch({ autoIngestion: v })}\n' +
      '          />\n' +
      '          <ToggleRow\n' +
      '            title="Auto Re-enrich on Ingest"\n' +
      '            badge={k.autoReEnrich ? "ON · automatic" : "OFF · manual from /knowledge/aliases"}\n' +
      '            badgeTone={k.autoReEnrich ? "emerald" : "platinum"}\n' +
      '            hint="When ON, every successful document add (file / URL / inline text) automatically spawns brand re-enrichment + stale-marks chunks. Per-brand 409 guard prevents duplicate jobs. Default OFF."\n' +
      '            checked={k.autoReEnrich}\n' +
      '            onChange={(v) => k.patch({ autoReEnrich: v })}\n' +
      '          />\n' +
      '        </div>\n' +
      '\n' +
      '        <div className="mt-5 grid gap-px overflow-hidden rounded-lg border border-white/[0.07] bg-white/[0.05] sm:grid-cols-2 lg:grid-cols-4">\n' +
      '          {metrics.map((m) => (\n' +
      '            <div key={m.label} className="bg-panel/60 px-4 py-3">\n' +
      '              <div className="mono-label">{m.label}</div>\n' +
      '              <div\n' +
      '                className={cn(\n' +
      '                  "mt-1 font-mono text-[15px] text-foreground",\n' +
      '                  m.tone === "ruby" && "text-ruby",\n' +
      '                  m.tone === "topaz" && "text-topaz",\n' +
      '                  m.tone === "emerald" && "text-emerald",\n' +
      '                )}\n' +
      '              >\n' +
      '                {(m.value ?? 0).toLocaleString()}\n' +
      '              </div>\n' +
      '            </div>\n' +
      '          ))}\n' +
      '        </div>\n' +
      '\n' +
