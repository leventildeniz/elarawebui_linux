Error parsing code /_app/settings // src/routes/_app.settings.tsx

// ... (inside SettingsPage component)

  // --- Certificate State ---
  const [certStatus, setCertStatus] = useState<{ exists: boolean; hostname: string } | null>(null);
  const [certBusy, setCertBusy] = useState(false);

  const refreshCertStatus = async () => {
    try {
      const r = await SystemAPI.getCertificateStatus();
      setCertStatus({ exists: r.exists, hostname: r.hostname });
    } catch (e) {
      console.error("Cert status fetch failed", e);
    }
  };

  const handleGenerateCert = async () => {
    if (!window.confirm("Generating new certificates will overwrite existing ones. Continue?")) return;
    setCertBusy(true);
    try {
      const r = await SystemAPI.generateCertificate();
      if (r.ok) {
        toast.success("Certificates generated successfully!");
        await refreshCertStatus();
        toast.warning("Please restart the bridge/server to apply new certificates.");
      } else {
        toast.error(`Generation failed: ${r.error || r.details}`);
      }
    } catch (e) {
      toast.error(`Error: ${(e as Error).message}`);
    } finally {
      setCertBusy(false);
    }
  };

  useEffect(() => {
    void refreshCertStatus();
  }, []);

  // ... (inside return statement)

  // 1. Add TabTrigger
  <TabsTrigger value="security">
    <ShieldCheck className="h-3 w-3 mr-1" /> Security & SSL
  </TabsTrigger>

  // 2. Add TabsContent
  <TabsContent value="security">
    <Card className="glass">
      <CardContent className="p-6 space-y-6">
        <div className="flex items-center justify-between">
          <div>
            <h3 className="font-bold text-sm font-mono uppercase tracking-widest">SSL Certificate Management</h3>
            <p className="text-xs text-muted-foreground">
              Manage local TLS certificates for secure HTTPS access. 
              Uses <code className="text-primary">mkcert</code> for local trust.
            </p>
          </div>
          <Badge variant={certStatus?.exists ? "outline" : "destructive"} className="font-mono">
            {certStatus?.exists ? "SECURE" : "INSECURE / HTTP"}
          </Badge>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div className="p-4 rounded-lg bg-card/50 border border-border space-y-2">
            <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">Detected Hostname</Label>
            <div className="flex items-center gap-2 font-mono text-sm">
              <Globe className="h-3 w-3 text-primary" />
              {certStatus?.hostname || "Loading..."}
            </div>
          </div>
          <div className="p-4 rounded-lg bg-card/50 border border-border space-y-2">
            <Label className="text-[10px] font-mono uppercase tracking-widest text-muted-foreground">Certificate Status</Label>
            <div className="flex items-center gap-2 text-sm">
              {certStatus?.exists ? (
                <span className="text-emerald-500 flex items-center gap-1">
                  <ShieldCheck className="h-3 w-3" /> Valid certificates found
                </span>
              ) : (
                <span className="text-destructive flex items-center gap-1">
                  <Zap className="h-3 w-3" /> Missing or invalid certificates
                </span>
              )}
            </div>
          </div>
        </div>

        <div className="flex items-center gap-3 pt-4 border-t border-border">
          <Button 
            variant="outline" 
            disabled={certBusy} 
            onClick={refreshCertStatus}
          >
            <RotateCcw className={`h-3 w-3 mr-1 ${certBusy ? "animate-spin" : ""}`} />
            Refresh Status
          </Button>
          <Button 
            variant="default" 
            className="bg-primary text-primary-foreground hover:bg-primary/90" 
            disabled={certBusy} 
            onClick={handleGenerateCert}
          >
            <ShieldCheck className="h-3 w-3 mr-1" />
            {certBusy ? "Generating..." : "Generate & Deploy Certificates"}
          </Button>
        </div>
        
        <div className="p-3 rounded bg-amber-500/10 border border-amber-500/20 text-[11px] font-mono text-amber-200/80">
          <strong>Pro Tip:</strong> After generating certificates, the bridge must be restarted to load the new .pem files. 
          Use the <strong>Runtime</strong> tab to restart the services.
        </div>
      </CardContent>
    </Card>
  </TabsContent>
