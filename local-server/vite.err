      '  category: { label: "Category", tone: "amethyst", icon: Layers },\n' +
      '  connection: { label: "Connection", tone: "sapphire", icon: Cable },\n' +
      '  runner: { label: "Runner", tone: "emerald", icon: Play },\n' +
      '};\n' +
      '\n' +
      'function MiniButton({\n' +
      '  children,\n' +
      '  onClick,\n' +
      '  tone = "sapphire",\n' +
      '  title,\n' +
      '}: {\n' +
      '  children: React.ReactNode;\n' +
