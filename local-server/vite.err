      '              <button\n' +
      '                key={n}\n' +
      '                type="button"\n' +
      '                onClick={() => k.patch({ batchSize: n })}\n' +
      '                className={cn(\n' +
      '                  "rounded-md px-2.5 py-1 font-mono text-[12px] transition-colors",\n' +
