    '  bridgeHost: "http://localhost",\n' +
    '  port: "3005",\n' +
    '  healthEndpoint: "/api/health",\n' +
    '  thinking: false,\n' +
    '  enabled: true,\n' +
    '  live: false,\n' +
    '  priority: 5,\n' +
    '  stopGraceMs: 5000,\n' +
    '  temperature: 0.2,\n' +
    '  topP: 0.85,\n' +
    '  repetitionPenalty: 1.25,\n' +
    '  maxTokens: 4096,\n' +
    '  contextWindow: 8192,\n' +
    '  stopSequences: [],\n' +
