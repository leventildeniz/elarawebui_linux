  pluginCode: 'import { useCallback, useEffect, useState } from "react";\n' +
    '\n' +
    '/** A telemetry board is a user-composed card that streams any mix of entities. */\n' +
    'export type BoardKind = "agent" | "workflow" | "skill" | "tool";\n' +
    '\n' +
    'export type BoardEntry = { kind: BoardKind; id: string };\n' +
    '\n' +
    'export type TelemetryBoard = {\n' +
    '  id: string;\n' +
    '  name: string;\n' +
    '  tone: string;\n' +
    '  entries: BoardEntry[];\n' +
    '  createdAt: number;\n' +
    '};\n' +
    '\n' +
    'export const boardTones = ["sapphire", "emerald", "amethyst", "topaz", "ruby"] as const;\n' +
    '\n' +
    'const KEY = "sovereign.telemetry.boards";\n' +
    'const ACTIVE_KEY = "sovereign.telemetry.boards.active";\n' +
    'const SEED_KEY = "sovereign.telemetry.boards.seeded";\n' +
    'const EVT = "sovereign:telemetry-boards";\n' +
    '\n' +
    '/** First-run card so the cockpit never opens on an orphan "Agents" view. */\n' +
    'function seedIfNeeded() {\n' +
    '  if (typeof window === "undefined") return;\n' +
    '  try {\n' +
    '    if (window.localStorage.getItem(SEED_KEY)) return;\n' +
    '    window.localStorage.setItem(SEED_KEY, "1");\n' +
    '    if (window.localStorage.getItem(KEY)) return;\n' +
    '    const board: TelemetryBoard = {\n' +
    '      id: "tb.agents",\n' +
    '      name: "Agents",\n' +
    '      tone: "emerald",\n' +
    '      entries: [],\n' +
    '      createdAt: Date.now(),\n' +
    '    };\n' +
    '      window.localStorage.setItem(KEY, JSON.stringify([board]));\n' +
    '      window.localStorage.setItem(ACTIVE_KEY, board.id);\n' +
    '      window.dispatchEvent(new CustomEvent(EVT));\n' +
    '    }\n' +
    '  } catch {\n' +
    '    /* ignore */\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    'function read(): TelemetryBoard[] {\n' +
    '  if (typeof window === "undefined") return [];\n' +
    '  try {\n' +
    '    const raw = window.localStorage.getItem(KEY);\n' +
    '    if (!raw) return [];\n' +
    '    const parsed = JSON.parse(raw) as TelemetryBoard[];\n' +
    '    return Array.isArray(parsed) ? parsed : [];\n' +
    '  } catch {\n' +
    '    return [];\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    'function write(list: TelemetryBoard[]) {\n' +
    '  try {\n' +
    '    window.localStorage.setItem(KEY, JSON.stringify(list));\n' +
    '    window.dispatchEvent(new CustomEvent(EVT));\n' +
    '  } catch {\n' +
    '    /* ignore */\n' +
    '  }\n' +
    '}\n' +
    '\n' +
    'function readActive(): string {\n' +
    '  if (typeof window === "undefined") return "";\n' +
    '  return window.localStorage.getItem(ACTIVE_KEY) ?? "";\n' +
    '}\n' +
    '\n' +
    'export function useTelemetryBoards() {\n' +
    '  const [boards, setBoards] = useState<TelemetryBoard[]>([]);\n' +
    '  const [active, setActiveState] = useState<string>("");\n' +
    '  const [hydrated, setHydrated] = useState(false);\n' +
    '\n' +
    '  const setActive = useCallback((id: string) => {\n' +
    '    try {\n' +
    '      window.localStorage.setItem(ACTIVE_KEY, id);\n' +
    '      window.dispatchEvent(new CustomEvent(EVT));\n' +
    '    } catch {\n' +
    '      /* ignore */\n' +
    '    }\n' +
    '    setActiveState(id);\n' +
    '  }, []);\n' +
    '\n' +
    '  useEffect(() => {\n' +
    '    const sync = () => {\n' +
    '      setBoards(read());\n' +
    '      setActiveState(readActive());\n' +
    '    };\n' +
    '    seedIfNeeded();\n' +
    '    sync();\n' +
    '    setHydrated(true);\n' +
    '    window.addEventListener(EVT, sync);\n' +
    '    return () => window.removeEventListener(EVT, sync);\n' +
    '  }, []);\n' +
    '\n' +
    '  const create = useCallback((name: string, tone: string, entries: BoardEntry[] = []) => {\n' +
    '    const id = `tb.${Math.random().toString(36).slice(2, 8)}`;\n' +
    '    const next = [\n' +
    '      ...read(),\n' +
    '      {\n' +
    '        id,\n' +
    '        name: name.trim() || "Untitled board",\n' +
    '        tone,\n' +
    '        entries,\n' +
    '        createdAt: Date.now(),\n' +
    '      },\n' +
    '    ];\n' +
    '    write(next);\n' +
    '    setBoards(next);\n' +
    '    try {\n' +
    '      window.localStorage.setItem(ACTIVE_KEY, id);\n' +
    '    } catch {\n' +
    '      /* ignore */\n' +
    '    }\n' +
    '    setActiveState(id);\n' +
    '    return id;\n' +
    '  }, []);\n' +
    '\n' +
    '  const addEntries = useCallback((boardId: string, entries: BoardEntry[]) => {\n' +
    '    const next = read().map((b) =>\n' +
    '      b.id === boardId\n' +
    '        ? {\n' +
    '            ...b,\n' +
    '            entries: [\n' +
    '              ...b.entries,\n' +
    '              ...entries.filter((e) => !b.entries.some((x) => x.kind === e.kind && x.id === e.id)),\n' +
    '            ],\n' +
    '          }\n' +
    '        : b,\n' +
    '    );\n' +
    '    write(next);\n' +
    '    setBoards(next);\n' +
    '  }, []);\n' +
    '\n' +
    '  const update = useCallback((id: string, patch: Partial<TelemetryBoard>) => {\n' +
    '    const next = read().map((b) => (b.id === id ? { ...b, ...patch } : b));\n' +
    '    write(next);\n' +
    '    setBoards(next);\n' +
    '  }, []);\n' +
    '\n' +
    '  const remove = useCallback((id: string) => {\n' +
    '    const next = read().filter((b) => b.id !== id);\n' +
    '    write(next);\n' +
    '    setBoards(next);\n' +
    '  }, []);\n' +
    '\n' +
    '  const removeEntry = useCallback((boardId: string, entry: BoardEntry) => {\n' +
    '    const next = read().map((b) =>\n' +
    '      b.id === boardId\n' +
    '        ? { ...b, entries: b.entries.filter((e) => !(e.kind === entry.kind && e.id === entry.id)) }\n' +
    '        : b,\n' +
    '    );\n' +
    '    write(next);\n' +
    '    setBoards(next);\n' +
    '  }, []);\n' +
    '\n' +
    '  return { boards, active, setActive, hydrated, create, addEntries, update, remove, removeEntry };\n' +
    '}\n',
