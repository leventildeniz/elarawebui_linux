    '        <span\n' +
    '          className="absolute inset-y-0 left-0 rounded-full transition-[width] duration-300"\n' +
    '          style={{\n' +
    '            width: `${Math.max(pct, used > 0 ? 3 : 0)}%`,\n' +
    '            background: tone,\n' +
    '            boxShadow: `0 0 8px -1px ${tone}`,\n' +
    '          }}\n' +
    '        />\n' +
    '      </span>\n' +
    '      <span className="font-mono text-[10.5px] tracking-[0.14em] text-muted-foreground/70">\n' +
    '        <span style={{ color: tone }}>{fmt(used)}</span>\n' +
    '        <span className="opacity-50">/{fmt(total)}</span>\n' +
    '      </span>\n' +
    '    </span>\n' +
    '  );\n' +
    '}\n' +
