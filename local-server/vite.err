    '    status,\n' +
    '    startedAt: seedNow() - i * 5400000,\n' +
    '    durationMs: status === "error" ? 15 + (i % 5) : 8000 + ((i * 3137) % 32000),\n' +
    '  };\n' +
    '});\n' +
    '\n' +
    'export const emptyAgent: Omit<StudioAgent, "id" | "createdAt"> = {\n' +
