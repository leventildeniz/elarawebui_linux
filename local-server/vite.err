      '      {children}\n' +
      '    </button>\n' +
      '  );\n' +
      '}\n' +
      '\n' +
      '/** Dropdown + Add binding picker — same grammar as the Agent editor. */\n' +
      'function PickerRow({\n' +
      '  label,\n' +
      '  catalog,\n' +
      '  selected,\n' +
      '  onChange,\n' +
      '  empty,\n' +
      '}: {\n' +
      '  label: string;\n' +
      '  catalog: readonly string[];\n' +
      '  selected: string[];\n' +
      '  onChange: (next: string[]) => void;\n' +
      '  empty: string;\n' +
      '}) {\n' +
      '  const available = catalog.filter((c) => !selected.includes(c));\n' +
      '  const [pick, setPick] = useState("");\n' +
